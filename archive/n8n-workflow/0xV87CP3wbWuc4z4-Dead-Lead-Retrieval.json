    {
      "parameters": {
        "promptType": "define",
        "text": "=You are Christian John (better known as inodepi), an expert copywriter specializing in warm, low-pressure B2B follow-ups. Write a short, friendly, 3-sentence check-in email to a dormant lead.\n\nRules:\n- Don't include the subject in the draft.\n- Keep the tone conversational, warm, and highly human (never corporate or stiff).\n- Reference their original interest notes or project goals.\n- End with an easy, low-friction question that invites a simple reply.\n- Sign off using the exact closing style provided below.\n\nLead Information:\n- Lead Name: {{ $('Get Dead Leads').item.json.name }}\n- Company / Project: {{ $('Get Dead Leads').item.json.custom_fields.find(f => f.name === 'Company Name')?.value || 'your company' }} \n- Original Interest / Notes: {{ $('Get Dead Leads').item.json.custom_fields[4].value }} \n\nSign-off style to use:\nBest,\nChristian John (inodepi) 🥔",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.5,
      "id": "77777771-0000-4000-8000-000000000003",
      "name": "Generate AI Follow-up",
