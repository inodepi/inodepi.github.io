    {
      "parameters": {
        "jsCode": "const src = $json.body || $json;\nconst c = src.call || {};\nconst cfg = $('Config').first().json;\nconst ca = c.call_analysis || {};\nconst sd = ca.custom_analysis_data || {};\nconst durations = JSON.parse(cfg.service_durations_json);\nconst slotRaw = sd.preferred_slot;\nlet slotStart = null;\nif (slotRaw) { const t = new Date(slotRaw); if (!isNaN(t)) slotStart = t.toISOString(); }\nconst durMin = durations[sd.service] || 60;\nconst slotEnd = slotStart ? new Date(new Date(slotStart).getTime() + durMin * 60000).toISOString() : null;\nconst isFuture = slotStart ? new Date(slotStart) > new Date() : false;\nconst bookable = sd.intent === 'book_appointment' && !!slotStart && isFuture;\nreturn { json: {\n  call_id: c.call_id || ('unknown-' + Date.now()),\n  caller_name: sd.caller_name || 'Unknown',\n  callback_number: sd.callback_number || c.from_number || '',\n  intent: sd.intent || 'unknown',\n  service: sd.service || null,\n  preferred_slot: slotRaw || null,\n  slot_start: slotStart,\n  slot_end: slotEnd,\n  duration_minutes: durMin,\n  bookable,\n  summary: ca.call_summary || '',\n  transcript: c.transcript || ''\n}};",
        "mode": "runOnceForEachItem"
      },
