# n8n connection (self-hosted Docker on this machine)
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/outreach-lead
# n8n → Settings → n8n API → Create an API key
# (used to verify each send actually executed before popping the lead)
N8N_API_KEY=

# Outreach pacing (Gmail-safe: well under Google's 500/day consumer cap)
OUTREACH_DAILY_LIMIT=20
BATCH_DELAY_SECONDS=30
EXECUTION_TIMEOUT_SECONDS=180

# Compliance footer (CAN-SPAM) — fill these in before sending for real:
# UNSUBSCRIBE_URL=https://yoursite.com/unsubscribe
# UNSUBSCRIBE_TEXT=Don't want these emails? Unsubscribe here.
# SENDER_NAME=Your Name
# SENDER_BUSINESS_NAME=Potaterrr
# SENDER_ADDRESS=123 Congress Ave, Austin, TX 78701

# --- Scraper (all optional) ---
# TARGET_CITY=Austin, Texas
# MAX_NEW_LEADS=5
# MAX_SITE_FETCHES=15
# SCRAPER_USER_AGENT=inodepi-outreach/1.0 (your-email@example.com)

# --- Google Sheet mirror of the queue (optional, needs service account) ---
# LEADS_SHEET_ID=1cv3REiDJ1MDyr4DTE0mCy0BYDd4WrtCf5HeltW8aMnA
# LEADS_SHEET_GID=0
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
