    {
      "id": "bacfe1c6-8cec-4812-b6fb-404df85339c8",
      "name": "Score Call",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        180,
        100
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Score this B2B sales call against the rubric.\n\nCALL METADATA\nRep: {{ $json.rep }}\nCall ID: {{ $json.call_id }}\nSource: {{ $json.source }}\n\nTRANSCRIPT\n\"\"\"\n{{ $json.transcript }}\n\"\"\"\n\nReturn only the structured JSON object. Every evidence field must be an exact quote from the transcript, or the literal string \"no evidence in transcript\". Do not paraphrase, invent, or merge lines.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a strict, fair sales-call quality analyst. Score five dimensions from 1 to 5. 5 = excellent, 4 = good, 3 = adequate, 2 = weak, 1 = missing or harmful. opening: identifies themselves and the company, gets permission to continue, and gives a clear reason for the call without dumping the pitch. discovery: asks about the current situation, the pain, the impact, the decision process and the timeline; confirms understanding before moving on. objection_handling: acknowledges the objection, explores what is behind it, responds with relevant proof, and checks whether the answer landed. If no objection is raised, score 3 and use \"no objection in transcript\" as the evidence — do not penalize the rep for the prospect agreeing. next_step: proposes a specific next step with a date and an owner, and confirms it before the call ends; score 1 if there is no next step. compliance: discloses recording where required, avoids guarantees or misleading claims, respects do-not-call, and quotes pricing accurately. confidence is 0 to 1 and reflects how much direct transcript evidence you had. red_flags is an array of concrete issues (empty if none). coaching_tip is one specific, kind, actionable sentence. summary is two sentences for the sales manager. Never invent facts. If a dimension has no evidence, score it 1 and say so.",
          "maxIterations": 1,
          "enableStreaming": false
        }
      }
    },
    {
      "id": "957cd053-2c81-481e-b326-614a41919664",
