    {
      "id": "cc604d97-833a-4083-9681-2eaa6d5150bc",
      "name": "Normalize Call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst body = item.body && typeof item.body === \"object\" ? item.body : item;\nconst call = body.call && typeof body.call === \"object\" ? body.call : body;\nconst raw = String(call.transcript || body.transcript || item.transcript || \"\").trim();\nconst transcript = raw.slice(0, 12000);\nconst rep = String(body.rep || body.rep_name || call.rep_name || call.agent_name || item.rep || item.agent || \"Unknown rep\").trim();\nconst callId = String(call.call_id || body.call_id || item.call_id || (\"call_\" + Date.now()));\nconst start = call.start_timestamp || body.start_timestamp || Date.now();\nconst when = Number(start) > 100000000000 ? Number(start) : Date.now();\nconst callDate = new Date(when).toISOString();\nconst duration = Number(call.duration_ms ? call.duration_ms / 1000 : (body.duration_seconds || item.duration_seconds || 0));\nconst source = body.call ? \"retell\" : \"form\";\nreturn [{ json: { call_id: callId, rep: rep, source: source, call_date: callDate, duration_seconds: duration, transcript: transcript } }];"
      }
    },
    {
      "id": "a2b9c022-b0c5-4228-9627-36618afacf57",
      "name": "Paste a Call",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -560,
        220
      ],
      "parameters": {
        "formTitle": "Sales call QA",
        "formDescription": "Paste a real or synthetic sales call transcript. The workflow scores opening, discovery, objection handling, next step and compliance, verifies the evidence, saves the scorecard, and only asks a sales manager to review what looks risky.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Rep name",
              "fieldName": "rep",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "e.g. Maya"
            },
            {
              "fieldLabel": "Call ID",
              "fieldName": "call_id",
              "fieldType": "text",
              "requiredField": false,
              "placeholder": "optional"
            },
            {
              "fieldLabel": "Transcript",
              "fieldName": "transcript",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "Rep: Hi Dana, this is Maya from Northwind. Do you have two minutes?"
            }
          ]
        },
        "options": {
          "path": "sales-call-qa-form",
          "buttonLabel": "Score this call",
          "appendAttribution": false,
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Call scored. Check the Sales Call QA data table and the manager draft. You can close this tab."
            }
          }
        }
      },
      "webhookId": "0ce4427b-8061-49cc-a9b8-3da42f77fcac"
    },
    {
      "id": "43e61f3e-7c5d-4587-b861-51e7080bc63e",
