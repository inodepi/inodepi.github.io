    {
      "id": "110cf784-7851-4773-a040-9401f105316b",
      "name": "Build Coaching Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map((i) => i.json);\nconst cutoff = Date.now() - 7 * 86400000;\nconst recent = rows.filter((r) => new Date(r.created_at || r.createdAt || 0).getTime() >= cutoff);\nconst source = recent.length ? recent : rows;\nconst byRep = {};\nfor (const r of source) {\n  const a = String(r.rep || \"Unknown rep\");\n  if (!byRep[a]) byRep[a] = { calls: [], review: 0, flags: [] };\n  byRep[a].calls.push(r);\n  if (String(r.status || \"\").indexOf(\"review\") !== -1) byRep[a].review += 1;\n  if (r.red_flags) byRep[a].flags.push(String(r.red_flags));\n}\nconst avg = (arr) => arr.length ? Math.round(arr.reduce((s, n) => s + Number(n || 0), 0) / arr.length) : 0;\nconst lines = [];\nconst reps = Object.keys(byRep).sort();\nfor (const a of reps) {\n  const c = byRep[a].calls;\n  lines.push(\"## \" + a);\n  lines.push(\"- Calls scored: \" + c.length);\n  lines.push(\"- Average overall: \" + avg(c.map((r) => r.overall)) + \"/100\");\n  lines.push(\"- Opening / discovery / objection / next step / compliance: \" + [avg(c.map((r) => r.opening)), avg(c.map((r) => r.discovery)), avg(c.map((r) => r.objection_handling)), avg(c.map((r) => r.next_step)), avg(c.map((r) => r.compliance))].join(\" / \"));\n  lines.push(\"- Needs human review: \" + byRep[a].review);\n  if (byRep[a].flags.length) lines.push(\"- Recurring flags: \" + byRep[a].flags.slice(0, 3).join(\"; \"));\n  lines.push(\"\");\n}\nconst body = [\"# Sales call QA — weekly coaching digest\", \"\", \"Calls in this digest: \" + source.length, \"\", ...(lines.length ? lines : [\"No calls scored yet. Run the Paste a Call form to seed the table.\"]), \"---\", \"Draft only. Read the flagged calls, adjust anything that looks off, then send the coaching notes yourself.\"].join(\"\\n\");\nreturn [{ json: { digest_subject: \"Sales call QA — weekly coaching digest\", digest_body: body, row_count: source.length } }];"
      }
    },
