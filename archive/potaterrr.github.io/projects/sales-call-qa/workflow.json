      "parameters": {
        "modelName": "models/gemini-3-flash-preview",
        "options": {
          "temperature": 0.1,
          "maxOutputTokens": 8192
        }
      }
    },
    {
      "id": "7971699a-fcaf-4442-b5e0-1f2d5f37eeba",
      "name": "Sales Scorecard Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        816,
        224
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{ \"opening\": { \"score\": 4, \"evidence\": \"exact quote from the transcript\" }, \"discovery\": { \"score\": 3, \"evidence\": \"exact quote\" }, \"objection_handling\": { \"score\": 4, \"evidence\": \"exact quote\" }, \"next_step\": { \"score\": 5, \"evidence\": \"exact quote\" }, \"compliance\": { \"score\": 4, \"evidence\": \"exact quote\" }, \"confidence\": 0.86, \"red_flags\": [\"concrete issue\"], \"coaching_tip\": \"one specific action\", \"summary\": \"two sentences for the sales manager\" }"
      }
    },
    {
      "id": "d08e836b-6e4c-4cb2-bda0-6559a8e34be8",
      "name": "Validate Scorecard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $json.output !== undefined ? $json.output : $json;\nlet raw = input;\nif (typeof raw === \"string\") { try { raw = JSON.parse(raw); } catch (e) { raw = {}; } }\nif (!raw || typeof raw !== \"object\") raw = {};\nconst transcript = String($(\"Normalize Call\").first().json.transcript || \"\");\nconst norm = transcript.toLowerCase().replace(/[^a-z0-9]+/g, \" \").trim();\nconst redact = (s) => String(s || \"\").replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi, \"[redacted email]\").replace(/(?:\\+?\\d[\\d\\s().-]{6,}\\d)/g, \"[redacted number]\").trim();\nconst short = (s) => redact(s).slice(0, 280);\nconst dim = (key) => { const v = raw[key] || {}; const n = Number(v.score); return { score: isFinite(n) ? Math.min(5, Math.max(1, Math.round(n))) : 1, evidence: short(v.evidence), raw: redact(v.evidence) }; };\nconst dims = { opening: dim(\"opening\"), discovery: dim(\"discovery\"), objection_handling: dim(\"objection_handling\"), next_step: dim(\"next_step\"), compliance: dim(\"compliance\") };\nconst check = (e) => {\n  if (!e || e === \"no evidence in transcript\") return false;\n  const parts = e.split(/\\.\\.\\.|\\n/).map((p) => p.replace(/^(Rep|Prospect|Caller|Buyer|Customer|Agent):\\s*/i, \"\").toLowerCase().replace(/[^a-z0-9]+/g, \" \").trim()).filter(Boolean);\n  return parts.length > 0 && parts.every((p) => norm.indexOf(p) !== -1);\n};\nconst verifiedCount = [dims.opening, dims.discovery, dims.objection_handling, dims.next_step, dims.compliance].filter((d) => check(d.raw)).length;\nconst evidenceVerified = verifiedCount >= 3;\nconst weighted = dims.opening.score * 15 + dims.discovery.score * 30 + dims.objection_handling.score * 25 + dims.next_step.score * 20 + dims.compliance.score * 10;\nconst overall = Math.round((weighted / 500) * 100);\nlet confidence = Number(raw.confidence);\nif (!isFinite(confidence)) confidence = 0.5;\nconfidence = Math.min(1, Math.max(0, confidence));\nif (!evidenceVerified) confidence = Math.max(0, confidence - 0.15);\nconst flags = Array.isArray(raw.red_flags) ? raw.red_flags.map((x) => String(x)).filter(Boolean) : [];\nif (dims.objection_handling.score <= 2) flags.push(\"An objection was dismissed or left unexplored.\");\nif (dims.next_step.score <= 2) flags.push(\"No specific next step, date or owner.\");\nif (dims.discovery.score <= 2) flags.push(\"Discovery stayed surface-level.\");\nif (dims.compliance.score <= 2) flags.push(\"Compliance risk: missing recording disclosure or an unverified claim.\");\nconst unique = flags.filter((v, i, a) => a.indexOf(v) === i);\nconst needsReview = confidence < 0.75 || unique.length > 0 || dims.compliance.score <= 2 || !evidenceVerified;\nconst status = needsReview ? \"needs_review\" : \"scored\";\nconst evidenceJson = JSON.stringify({ opening: dims.opening.evidence, discovery: dims.discovery.evidence, objection_handling: dims.objection_handling.evidence, next_step: dims.next_step.evidence, compliance: dims.compliance.evidence });\nreturn [{ json: { call_id: $(\"Normalize Call\").first().json.call_id, rep: $(\"Normalize Call\").first().json.rep, source: $(\"Normalize Call\").first().json.source, call_date: $(\"Normalize Call\").first().json.call_date, duration_seconds: $(\"Normalize Call\").first().json.duration_seconds, overall: overall, opening: dims.opening.score, discovery: dims.discovery.score, objection_handling: dims.objection_handling.score, next_step: dims.next_step.score, compliance: dims.compliance.score, confidence: Number(confidence.toFixed(2)), status: status, needs_review: needsReview, red_flags: unique.join(\" || \"), coaching_tip: redact(raw.coaching_tip), summary: redact(raw.summary), evidence: evidenceJson, evidence_verified: evidenceVerified, created_at: new Date().toISOString() } }];"
      }
    },
