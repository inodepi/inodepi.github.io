---
interface Props {
  brand: 'furnaceworks' | 'redline' | 'fernhollow' | 'lumen';
  size?: string;
  class?: string;
}

const { brand, size = '1.5rem', class: className } = Astro.props;
const dims = `width:${size};height:${size};flex:none;display:block`;
---

<svg class={className} style={dims} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {
    brand === 'furnaceworks' && (
      <path
        d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67ZM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8Z"
        fill="currentColor"
      />
    )
  }
  {
    brand === 'redline' && (
      <>
        <path
          d="M8 3v8.6a4.6 4.6 0 0 0 9.2 0V9.4"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
        />
        <path
          d="M14.4 9.6 17.2 6.8l2.8 2.8"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </>
    )
  }
  {
    brand === 'fernhollow' && (
      <>
        <path
          d="M12 2.4 16.1 8h-2.3l3.3 4.3h-2.7L18.2 17H5.8l3.8-4.7H6.9L10.2 8H7.9L12 2.4Z"
          fill="currentColor"
        />
        <path d="M11 17h2v4.6h-2z" fill="currentColor" />
      </>
    )
  }
  {
    brand === 'lumen' && (
      <>
        <path
          d="M12 3.2c-1.8 0-2.7.9-4.5.9-1.9 0-3.3 1.2-3.3 4 0 3 1.1 4.2 1.7 6.9.3 1.5.5 3.8 2 3.8 1.5 0 1.2-2.9 2.1-2.9.9 0 1.6 2.9 3 2.9 1.4 0 1.7-2.3 2-3.8.6-2.7 1.7-3.9 1.7-6.9 0-2.8-1.4-4-3.3-4-1.8 0-2.7-.9-4.4-.9Z"
          fill="currentColor"
        />
        <path d="M12 6.6v4.2" stroke="var(--d-bg, #fff)" stroke-width="1.6" stroke-linecap="round" />
      </>
    )
  }
</svg>
