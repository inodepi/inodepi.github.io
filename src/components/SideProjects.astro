---
import { featuredSideProjects } from '../data/projects';

const feature = featuredSideProjects.find((project) => project.size === 'large');
const rest = featuredSideProjects.filter((project) => project !== feature);
const featureUrl = feature?.demoUrl
  ? feature.demoUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')
  : '';
---

<section class="section" id="side-projects">
  <div class="container">
    <div class="section-head">
      <h2>Side projects</h2>
      <p class="section-lede">
        Tools, experiments, and small things built out of curiosity. Different problems, same
        habit of wiring systems together.
      </p>
    </div>

    {feature && (
      <article class="side-feature" style={`--hue:var(--node-${feature.hue})`}>
        <div class="side-feature-main">
          <span class="side-feature-label">
            <i aria-hidden="true"></i>
            Live build
          </span>
          <h3>{feature.title}</h3>
          <p>{feature.summary}</p>
          <ul class="side-stack" aria-label="Stack">
            {feature.stack.map((tool) => <li class="tag">{tool}</li>)}
          </ul>
        </div>

        <div class="side-feature-aside">
          <div>
            <span class="side-feature-status"><i aria-hidden="true"></i>Running in production</span>
            <p class="side-feature-url">{featureUrl}</p>
          </div>
          <div class="side-feature-links">
            {feature.demoUrl && (
              <a class="btn btn-primary" href={feature.demoUrl} target="_blank" rel="noopener noreferrer">
                Open live demo
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            )}
            {feature.buildUrl && (
              <a class="btn btn-secondary" href={feature.buildUrl}>View the build</a>
            )}
          </div>
        </div>
      </article>
    )}

    {rest.length > 0 ? (
      <ul class="side-grid">
        {rest.map((project) => {
          const href = project.buildUrl ?? project.demoUrl ?? project.repoUrl ?? '#';
          const label = project.linkLabel ?? (project.buildUrl ? 'View the build' : project.demoUrl ? 'Play it' : 'View repository');
          return (
            <li class="side-card" style={`--hue:var(--node-${project.hue})`}>
              <span class="side-mark" aria-hidden="true"></span>
              <div class="side-body">
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <ul class="side-stack" aria-label="Stack">
                  {project.stack.map((tool) => <li class="tag">{tool}</li>)}
                </ul>
                <a
                  class="side-link"
                  href={href}
                  target={href.startsWith('http') ? '_blank' : undefined}
                  rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {label}
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </li>
          );
        })}
      </ul>
    ) : (
      !feature && (
        <p class="empty">
          No side projects are featured yet. Set <code>featured: true</code> on an entry in
          <code>src/data/projects.ts</code>.
        </p>
      )
    )}
  </div>
</section>

<style>
  .side-feature {
    position: relative;
    display: grid;
    gap: 0;
    margin-bottom: 1.25rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }

  .side-feature::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--hue);
    opacity: 0.9;
  }

  .side-feature-main {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3.2vw, 2.4rem);
  }

  .side-feature-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    padding: 0.22rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .side-feature-label i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--hue);
  }

  .side-feature-main h3 {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem);
    letter-spacing: -0.03em;
  }

  .side-feature-main p {
    max-width: 58ch;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.65;
  }

  .side-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .side-feature-aside {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.35rem, 2.6vw, 2rem);
    background: var(--panel-raised);
    border-top: 1px solid var(--line);
  }

  .side-feature-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .side-feature-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--node-teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--node-teal) 16%, transparent);
  }

  .side-feature-url {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .side-feature-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .side-feature-links .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .side-feature-links svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  @media (min-width: 900px) {
    .side-feature {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.75fr);
    }

    .side-feature-aside {
      border-top: 0;
      border-left: 1px solid var(--line);
    }
  }

  .side-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .side-card {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    padding: 1.35rem 1.25rem 1.35rem 1.1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    transition:
      border-color 180ms ease,
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  @media (hover: hover) {
    .side-card:hover {
      transform: translateY(-2px);
      border-color: rgba(245, 166, 35, 0.3);
      box-shadow: 0 20px 36px -30px rgba(0, 0, 0, 0.9);
    }
  }

  .side-mark {
    flex: none;
    width: 4px;
    align-self: stretch;
    border-radius: 2px;
    background: var(--hue);
  }

  .side-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
    min-width: 0;
  }

  .side-body h3 {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .side-body p {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .side-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: fit-content;
    margin-top: auto;
    padding-top: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .side-link span {
    transition: transform 160ms ease;
  }

  .side-link:hover span {
    transform: translate(2px, -2px);
  }

  .empty {
    padding: 1.5rem;
    border: 1px dashed var(--line-strong);
    color: var(--ink-soft);
  }

  .empty code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--accent);
  }
</style>
