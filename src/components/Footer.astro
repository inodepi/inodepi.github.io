---
import { siteConfig } from '../data/projects';
import BrandMark from './BrandMark.astro';
import PiGlyph from './PiGlyph.astro';

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="footer-wordmark" href={base} aria-label="inodepi — pronounced I node Pi, home">
        <BrandMark class="footer-mark" />
        <span class="footer-text" aria-hidden="true">inode<PiGlyph class="footer-pi" /></span>
      </a>
      <p>{siteConfig.role} · end-to-end workflow systems</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <a href={`${base}#work`}>Work</a>
      <a href={`${base}#process`}>Process</a>
      <a href={`${base}#contact`}>Contact</a>
      <a href={siteConfig.githubUrl} rel="noopener noreferrer">GitHub</a>
    </nav>
  </div>

  <div class="container">
    <p class="footer-giant" aria-hidden="true">inode<PiGlyph class="footer-giant-pi" /></p>
  </div>

  <div class="container footer-base">
    <p>© {year} {siteConfig.name}. Independent automation practice.</p>
    <p>Pronounced I · node · Pi</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 3rem 2rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer-brand {
    display: grid;
    gap: 0.35rem;
  }

  .footer-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 660;
    letter-spacing: -0.04em;
    text-decoration: none;
    width: fit-content;
    color: var(--ink);
  }

  .footer-mark {
    width: 1.4rem;
    height: 1.4rem;
    flex: none;
  }

  .footer-text {
    display: inline-flex;
    align-items: baseline;
    line-height: 1;
  }

  .footer-pi {
    margin-left: 0.04em;
  }

  .footer-brand p {
    color: var(--ink-dim);
    font-size: 0.875rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .footer-nav a {
    text-decoration: none;
    transition: color 140ms ease;
  }

  .footer-nav a:hover {
    color: var(--accent);
  }

  .footer-giant {
    display: flex;
    align-items: baseline;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 13vw, 10rem);
    font-weight: 660;
    line-height: 0.78;
    letter-spacing: -0.06em;
    color: var(--ink);
    opacity: 0.92;
  }

  .footer-giant-pi {
    margin-left: 0.03em;
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.01em;
  }
</style>
