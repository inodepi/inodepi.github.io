---
import { siteConfig } from '../data/projects';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="footer-wordmark" href={import.meta.env.BASE_URL} aria-label={`${siteConfig.name} home`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="6" cy="6" r="3"></circle>
          <circle cx="18" cy="18" r="3"></circle>
          <path d="M8.5 8.5 15.5 15.5"></path>
        </svg>
        {siteConfig.name}
      </a>
      <p>{siteConfig.role} · end-to-end workflow systems</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <a href="#work">Work</a>
      <a href="#process">Process</a>
      <a href="#contact">Contact</a>
      <a href={siteConfig.githubUrl} rel="noopener noreferrer">GitHub</a>
      <a href={siteConfig.linkedinUrl} rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>

  <div class="container footer-base">
    <p>© {year} {siteConfig.name}. Independent automation practice.</p>
    <p>Built with Astro and n8n in mind.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 3rem 2rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer-brand {
    display: grid;
    gap: 0.35rem;
  }

  .footer-wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 640;
    letter-spacing: -0.03em;
    text-decoration: none;
    width: fit-content;
  }

  .footer-wordmark svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
  }

  .footer-brand p {
    color: var(--ink-dim);
    font-size: 0.875rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .footer-nav a {
    text-decoration: none;
    transition: color 140ms ease;
  }

  .footer-nav a:hover {
    color: var(--ink);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.01em;
  }
</style>
