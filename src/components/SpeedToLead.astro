---
const steps = [
  {
    time: '0:00',
    title: 'Missed call',
    body: 'The call rings out and lands in voicemail. On most sites, that lead is gone.',
    hue: 'var(--node-rose)',
  },
  {
    time: '0:15',
    title: 'Instant text-back',
    body: 'A reply goes out in seconds, and the lead is logged in the CRM before anyone picks up a phone.',
    hue: 'var(--node-amber)',
  },
  {
    time: '0:40',
    title: 'Follow-up and alert',
    body: 'Three nudges run themselves. The moment the lead replies, you get the call-now alert.',
    hue: 'var(--node-teal)',
  },
];
---

<section class="section" id="speed-to-lead">
  <div class="container">
    <div class="section-head">
      <p class="stl-kicker">Speed-to-Lead</p>
      <h2>See a missed call become a booked job.</h2>
      <p class="section-lede">
        A 60-second walkthrough of the flagship recovery workflow: instant text-back, a logged
        lead, a 3-step follow-up, and an alert the moment they reply.
      </p>
    </div>

    <div class="stl-grid">
      <figure class="stl-video">
        <video
          controls
          preload="metadata"
          playsinline
          poster="/videos/speed-to-lead.jpg"
          width="1920"
          height="1080"
        >
          <source src="/videos/speed-to-lead.mp4" type="video/mp4" />
          <track kind="captions" src="/videos/speed-to-lead.vtt" srclang="en" label="English" />
          Your browser cannot play this film. <a href="/videos/speed-to-lead.mp4">Download it</a>.
        </video>
        <figcaption>Speed-to-Lead walkthrough · 1:00 · captions available</figcaption>
      </figure>

      <ol class="stl-steps">
        {steps.map((step, i) => (
          <li style={`--stop:${step.hue}`} data-seek={i === 0 ? 0 : i === 1 ? 15 : 40}>
            <span class="stl-time">{step.time}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="stl-cta">
      <a class="btn btn-primary" href="#contact">Get a free lead-leak check</a>
      <p>Built inside your own accounts. You own everything.</p>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('speed-to-lead');
  const video = section?.querySelector('video');
  if (video) {
    section.querySelectorAll('[data-seek]').forEach((li) => {
      li.addEventListener('click', () => {
        const t = Number(li.getAttribute('data-seek')) || 0;
        video.currentTime = t;
        video.play().catch(() => {});
      });
      li.style.cursor = 'pointer';
    });
  }
</script>

<style>
  .stl-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.32rem 0.7rem 0.32rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink-soft);
    font-size: 0.8125rem;
    line-height: 1.3;
    width: fit-content;
  }

  .stl-kicker::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .stl-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  @media (min-width: 980px) {
    .stl-grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    }
  }

  .stl-video {
    margin: 0;
  }

  .stl-video video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #000;
  }

  .stl-video figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    color: var(--ink-dim);
  }

  .stl-steps {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .stl-steps li {
    padding: 1rem 1.1rem 1.1rem;
    background: var(--panel);
    box-shadow: inset 0 3px 0 var(--stop);
    transition: background-color 140ms ease;
  }

  .stl-steps li:hover {
    background: var(--panel-raised);
  }

  .stl-time {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }

  .stl-steps h3 {
    margin-top: 0.2rem;
    font-size: 1.125rem;
    font-weight: 640;
    letter-spacing: -0.02em;
  }

  .stl-steps p {
    margin-top: 0.3rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .stl-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }

  .stl-cta p {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--ink-dim);
  }
</style>
