---
const nodes = [
  { x: 28, y: 64, w: 196, h: 66, label: 'Webhook', sub: 'POST /new-lead', hue: 'var(--node-amber)' },
  { x: 336, y: 64, w: 196, h: 66, label: 'Filter', sub: 'valid + scored', hue: 'var(--node-teal)' },
  { x: 170, y: 204, w: 220, h: 78, label: 'AI Agent', sub: 'classify + draft reply', hue: 'var(--node-violet)' },
  { x: 28, y: 356, w: 196, h: 66, label: 'HTTP Request', sub: 'POST /crm/leads', hue: 'var(--node-teal)' },
  { x: 336, y: 356, w: 196, h: 66, label: 'Slack', sub: 'notify #sales', hue: 'var(--node-rose)' },
];

const paths = [
  { d: 'M224 97 C 264 97, 296 97, 336 97', delay: '0s' },
  { d: 'M126 130 C 126 186, 146 240, 170 240', delay: '-0.9s' },
  { d: 'M434 130 C 434 186, 414 230, 390 230', delay: '-1.6s' },
  { d: 'M225 282 C 225 320, 168 330, 126 356', delay: '-2.4s' },
  { d: 'M335 282 C 335 320, 392 330, 434 356', delay: '-2.4s' },
];

const ports = [
  [224, 97],
  [336, 97],
  [126, 130],
  [170, 240],
  [434, 130],
  [390, 230],
  [225, 282],
  [126, 356],
  [335, 282],
  [434, 356],
];
---

<figure class="canvas" aria-label="Sample n8n workflow graph: a webhook feeds a filter and an AI agent, which writes to a CRM and notifies Slack.">
  <div class="canvas-bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="canvas-file">lead-intake.workflow</span>
    <span class="canvas-status"><i aria-hidden="true"></i>live</span>
  </div>

  <svg class="graph" viewBox="0 0 560 440" aria-hidden="true">
    <g class="links">
      {paths.map((path) => <path d={path.d} />)}
    </g>

    <g class="ports">
      {ports.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.4" />)}
    </g>

    <g class="pulses">
      {paths.map((path) => (
        <circle class="pulse" r="3.6">
          <animateMotion path={path.d} dur="4.2s" begin={path.delay} repeatCount="indefinite" />
        </circle>
      ))}
    </g>

    <g class="nodes">
      {nodes.map((node) => (
        <g>
          <rect class="node" x={node.x} y={node.y} width={node.w} height={node.h} rx="7" />
          <rect class="chip" x={node.x + 12} y={node.y + 16} width="5" height={node.h - 32} rx="2.5" fill={node.hue} />
          <text class="node-label" x={node.x + 30} y={node.y + 29}>{node.label}</text>
          <text class="node-sub" x={node.x + 30} y={node.y + 48}>{node.sub}</text>
        </g>
      ))}
    </g>
  </svg>

  <figcaption class="canvas-foot">
    <span>5 nodes · 5 connections</span>
    <span>sample graph</span>
  </figcaption>
</figure>

<style>
  .canvas {
    margin: 0;
    background: var(--panel);
    border: 1px solid rgba(245, 166, 35, 0.24);
    border-radius: 10px;
    box-shadow:
      0 30px 80px -44px rgba(245, 166, 35, 0.3),
      0 26px 60px -34px rgba(0, 0, 0, 0.85);
    overflow: hidden;
  }

  .canvas-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.95rem;
    border-bottom: 1px solid var(--line);
    background: var(--panel-raised);
  }

  .dots {
    display: inline-flex;
    gap: 5px;
  }

  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .canvas-file {
    font-family: var(--font-mono);
    font-size: 0.7188rem;
    color: var(--ink-dim);
    letter-spacing: 0.02em;
  }

  .canvas-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--node-teal);
  }

  .canvas-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: breathe 2.8s ease-in-out infinite;
  }

  .graph {
    display: block;
    width: 100%;
    height: auto;
  }

  .links path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.6;
  }

  .node {
    fill: var(--panel-raised);
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .ports circle {
    fill: var(--panel);
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .pulse {
    fill: var(--accent);
    filter: drop-shadow(0 0 5px rgba(245, 166, 35, 0.85));
  }

  .node-label {
    fill: var(--ink);
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .node-sub {
    fill: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.01em;
  }

  .canvas-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.95rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-dim);
    letter-spacing: 0.02em;
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulses {
      display: none;
    }

    .canvas-status i {
      animation: none;
    }
  }
</style>
