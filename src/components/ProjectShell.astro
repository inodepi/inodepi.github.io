---
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import { siteConfig } from '../data/projects';

interface Props {
  title: string;
  description: string;
  kicker: string;
  name: string;
  tagline: string;
  badges: string[];
  canvasName: string;
  canvasTag: string;
  canvasNote: string;
  stack: string[];
  links: { label: string; href: string; external?: boolean }[];
  category: string;
  ctaTitle: string;
  ctaBody: string;
  ctaLabel?: string;
  ctaHref?: string;
  backLabel?: string;
  primaryLabel?: string;
  primaryHref?: string;
  sideCtaTitle?: string;
  sideCtaBody?: string;
  sideCtaLabel?: string;
  sideCtaHref?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  kicker,
  name,
  tagline,
  badges,
  canvasName,
  canvasTag,
  canvasNote,
  stack,
  links,
  category,
  ctaTitle,
  ctaBody,
  ctaLabel = 'Book a discovery call',
  ctaHref = '/#contact',
  backLabel = 'Back to home',
  primaryLabel = 'Book a discovery call',
  primaryHref,
  sideCtaTitle = 'Like this build?',
  sideCtaBody = 'Start with a 15-minute discovery call.',
  sideCtaLabel = 'Book a call',
  sideCtaHref,
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const home = base === '/' ? '/' : `${base}/`;
const primaryHrefResolved = primaryHref ?? `${home}#contact`;
const sideCtaHrefResolved = sideCtaHref ?? `${home}#contact`;
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <article class="project">
    <header class="proj-hero">
      <div class="container">
        <a class="btn btn-secondary proj-back" href={home}>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          {backLabel}
        </a>

        <div class="proj-hero-grid">
          <div class="proj-copy">
            <p class="proj-kicker">{kicker}</p>
            <h1>{name}</h1>
            <p class="proj-tagline">{tagline}</p>

            <ul class="proj-badges">
              {badges.map((badge, index) => (
                <li class:list={['proj-badge', index === 0 && 'proj-badge--accent']}>{badge}</li>
              ))}
            </ul>

            <div class="proj-actions">
              <a class="btn btn-primary" href={primaryHrefResolved}>{primaryLabel}</a>
              <slot name="actions" />
            </div>
          </div>

          <div class="proj-visual">
            <div class="proj-canvas-bar">
              <span class="proj-canvas-name">{canvasName}</span>
              <span class="proj-canvas-tag">{canvasTag}</span>
              <span class="proj-canvas-status"><i aria-hidden="true"></i>live</span>
            </div>
            <div class="proj-canvas-scroll">
              <div class="proj-canvas">
                <slot name="visual" />
              </div>
            </div>
            <p class="proj-canvas-note">{canvasNote}</p>
          </div>
        </div>
      </div>
    </header>

    <div class="container proj-layout">
      <div class="proj-main">
        <slot />
      </div>

      <aside class="proj-side" aria-label="Build details">
        <div class="proj-side-card">
          <h2>Stack</h2>
          <ul class="proj-stack">
            {stack.map((tool) => <li class="tag">{tool}</li>)}
          </ul>
        </div>

        <div class="proj-side-card">
          <h2>Links</h2>
          <ul class="proj-links">
            {links.map((link) => (
              <li>
                <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                  {link.label} {link.external ? '↗' : '→'}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="proj-side-card">
          <h2>Category</h2>
          <p class="proj-side-text">{category}</p>
        </div>

        <div class="proj-side-card proj-side-cta">
          <h2>{sideCtaTitle}</h2>
          <p class="proj-side-text">{sideCtaBody}</p>
          <a class="btn btn-primary" href={sideCtaHrefResolved}>{sideCtaLabel}</a>
        </div>
      </aside>
    </div>

    <section class="proj-cta">
      <div class="container">
        <div class="proj-cta-inner">
          <div>
            <h2>{ctaTitle}</h2>
            <p>{ctaBody}</p>
          </div>
          <a class="btn btn-primary" href={ctaHref}>{ctaLabel}</a>
        </div>
      </div>
    </section>
  </article>

  <Footer slot="footer" />
</Base>

<style>
  .proj-hero {
    padding-block: clamp(2.25rem, 5vw, 3.5rem) clamp(3rem, 6vw, 4.5rem);
  }

  .proj-back {
    margin-bottom: 1.75rem;
    min-height: 2.4rem;
    padding: 0.4rem 0.8rem;
    font-size: 0.8125rem;
    gap: 0.45rem;
    width: fit-content;
  }

  .proj-back svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .proj-hero-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 1020px) {
    .proj-hero-grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    }
  }

  .proj-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.32rem 0.7rem 0.32rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink-soft);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .proj-kicker::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.14);
  }

  .proj-copy h1 {
    margin-top: 0.9rem;
    font-size: clamp(2.5rem, 1.5rem + 3.8vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 14ch;
  }

  .proj-tagline {
    margin-top: 1rem;
    max-width: 40ch;
    color: var(--ink-soft);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .proj-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
  }

  .proj-badge {
    padding: 0.24rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  .proj-badge--accent {
    border-color: rgba(245, 166, 35, 0.4);
    color: var(--accent);
  }

  .proj-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .proj-visual {
    background: var(--panel);
    border: 1px solid rgba(245, 166, 35, 0.22);
    border-radius: 10px;
    overflow: hidden;
    box-shadow:
      0 30px 80px -44px rgba(245, 166, 35, 0.28),
      0 26px 60px -34px rgba(0, 0, 0, 0.85);
  }

  .proj-canvas-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.7rem;
    border-bottom: 1px solid var(--line);
    background: var(--panel-raised);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--ink-dim);
  }

  .proj-canvas-tag {
    padding: 0.06rem 0.3rem;
    border: 1px solid rgba(245, 166, 35, 0.4);
    border-radius: 3px;
    color: var(--accent);
    font-size: 0.5rem;
  }

  .proj-canvas-status {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    color: var(--node-teal);
    font-size: 0.5rem;
  }

  .proj-canvas-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: proj-breathe 2.8s ease-in-out infinite;
  }

  .proj-canvas-scroll {
    overflow: hidden;
    background-color: var(--bg);
    background-image: radial-gradient(rgba(140, 170, 209, 0.18) 1px, transparent 1.2px);
    background-size: 18px 18px;
  }

  .proj-canvas {
    width: 100%;
  }

  .proj-canvas :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .proj-canvas-note {
    padding: 0.6rem 0.85rem;
    border-top: 1px solid var(--line);
    color: var(--ink-dim);
    font-size: 0.75rem;
  }

  @keyframes proj-breathe {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.8);
    }
  }

  /* Layout */
  .proj-layout {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 1000px) {
    .proj-layout {
      grid-template-columns: minmax(0, 1fr) 310px;
      gap: 4rem;
      align-items: start;
    }
  }

  .proj-main :global(.proj-section + .proj-section) {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .proj-main :global(.proj-section h2) {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  }

  .proj-main :global(.proj-section > p) {
    margin-top: 0.7rem;
    max-width: 64ch;
    color: var(--ink-soft);
    font-size: 0.9688rem;
    line-height: 1.7;
  }

  .proj-main :global(.proj-disclaimer) {
    margin-top: 1rem;
    padding-left: 0.85rem;
    border-left: 2px solid rgba(245, 166, 35, 0.45);
    color: var(--ink-dim);
    font-size: 0.875rem;
  }

  /* Sidebar */
  .proj-side {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 1000px) {
    .proj-side {
      position: sticky;
      top: 6rem;
    }
  }

  .proj-side-card {
    padding: 1.1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .proj-side-card h2 {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .proj-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.65rem;
  }

  .proj-links {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.65rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .proj-links a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    width: fit-content;
    padding-bottom: 1px;
  }

  .proj-links a:hover {
    color: var(--accent);
  }

  .proj-side-text {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
  }

  .proj-side-cta .btn {
    margin-top: 0.8rem;
    min-height: 2.6rem;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
  }

  /* Closing CTA */
  .proj-cta {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .proj-cta-inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--panel);
    border: 1px solid rgba(245, 166, 35, 0.25);
    border-radius: 10px;
    overflow: hidden;
  }

  .proj-cta-inner::before {
    content: '';
    position: absolute;
    top: -60%;
    right: -10%;
    width: 26rem;
    height: 26rem;
    background: radial-gradient(circle, rgba(245, 166, 35, 0.14), transparent 65%);
    pointer-events: none;
  }

  .proj-cta-inner > * {
    position: relative;
  }

  .proj-cta-inner h2 {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2rem);
  }

  .proj-cta-inner p {
    margin-top: 0.4rem;
    max-width: 46ch;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .proj-canvas-status i {
      animation: none;
    }
  }
</style>
