---
import { faqGreeting, faqItems } from '../data/faq';
import { siteConfig } from '../data/projects';

const calUrl = siteConfig.calendarUrl;
const base = import.meta.env.BASE_URL;
---

<div
  class="faqfab"
  data-faq
  data-email={siteConfig.email}
  data-whatsapp={siteConfig.whatsappUrl}
  data-rag-url={siteConfig.ragWebhookUrl}
>
  <button
    class="faqfab__trigger"
    type="button"
    data-faq-toggle
    aria-expanded="false"
    aria-controls="faq-panel"
    aria-label="Open FAQ chat"
  >
    <svg class="faqfab__trigger-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none">
      <path
        d="M4.5 5.5h15v10.2h-8.1L7.2 19v-3.3H4.5z"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linejoin="round"
      />
    </svg>
    <span class="faqfab__trigger-dot" aria-hidden="true"></span>
  </button>

  <section
    class="faqfab__panel"
    id="faq-panel"
    role="dialog"
    aria-labelledby="faq-panel-title"
    data-faq-panel
    hidden
  >
    <header class="faqfab__head">
      <span class="faqfab__avatar" aria-hidden="true">
        <img class="faqfab__avatar-img" src={`${base}pip.svg`} alt="" width="96" height="96" />
      </span>
      <div class="faqfab__title-wrap">
        <h2 id="faq-panel-title">Pip</h2>
        <p class="faqfab__kicker">inodepi · FAQ apprentice</p>
      </div>
      <button
        class="faqfab__theme"
        type="button"
        data-faq-theme
        aria-label="Theme: auto"
        title="Cycle theme: auto, light, dark"
      >
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none">
          <circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.5" />
          <path
            d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.3 3.3l1.1 1.1M11.6 11.6l1.1 1.1M3.3 12.7l1.1-1.1M11.6 4.4l1.1-1.1"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
          />
        </svg>
        <span data-faq-theme-label>Auto</span>
      </button>
      <button class="faqfab__close" type="button" data-faq-close aria-label="Close FAQ">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </header>

    <div class="faqfab__log" data-faq-log aria-live="polite">
      <p class="faqfab__bubble faqfab__bubble--bot">
        {faqGreeting.body}
        <a
          class="faqfab__cta"
          href={calUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {faqGreeting.cta}
        </a>
      </p>
    </div>

    <div class="faqfab__chips" data-faq-chips aria-label="Suggested questions">
      {
        faqItems.map((item) => (
          <button
            class="faqfab__chip"
            type="button"
            data-faq-ask
            data-question={item.question}
            data-answer={item.answer}
          >
            <span class="faqfab__chip-mark" aria-hidden="true">+</span>
            <span>{item.question}</span>
          </button>
        ))
      }
    </div>

    <form class="faqfab__composer" data-faq-form>
      <label class="faqfab__sr" for="faq-input">Type a question</label>
      <input
        id="faq-input"
        class="faqfab__input"
        type="text"
        name="q"
        placeholder="Message…"
        autocomplete="off"
        enterkeyhint="send"
        data-faq-input
      />
      <button class="faqfab__send" type="submit" aria-label="Send question">
        <svg viewBox="0 0 20 20" aria-hidden="true" fill="none">
          <path
            d="M3 10L17 3l-4.5 14-3.2-5.3L3 10z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </form>
  </section>
</div>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-faq]');
    if (!root) return;

    const trigger = root.querySelector('[data-faq-toggle]');
    const panel = root.querySelector('[data-faq-panel]');
    const closeButton = root.querySelector('[data-faq-close]');
    const log = root.querySelector('[data-faq-log]');
    if (!trigger || !panel || !closeButton || !log) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const THINK_MS = 520;
    let lastFocus = null;

    const scrollLog = () => {
      log.scrollTop = log.scrollHeight;
    };

    const open = () => {
      lastFocus = document.activeElement;
      panel.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      scrollLog();
      closeButton.focus({ preventScroll: true });
    };

    const close = () => {
      if (panel.hidden) return;
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (lastFocus && typeof lastFocus.focus === 'function') {
        lastFocus.focus({ preventScroll: true });
      } else {
        trigger.focus({ preventScroll: true });
      }
    };

    const appendBubble = (text, variant) => {
      const bubble = document.createElement('p');
      bubble.className = 'faqfab__bubble faqfab__bubble--' + variant;
      bubble.appendChild(document.createTextNode(text));
      log.appendChild(bubble);
      return bubble;
    };

    const appendTyping = () => {
      const holder = document.createElement('p');
      holder.className = 'faqfab__bubble faqfab__bubble--bot faqfab__bubble--typing';
      holder.setAttribute('aria-hidden', 'true');
      for (let i = 0; i < 3; i += 1) {
        const dot = document.createElement('span');
        dot.className = 'faqfab__typing-dot';
        holder.appendChild(dot);
      }
      log.appendChild(holder);
      scrollLog();
      return holder;
    };

    const appendFallback = (asked) => {
      const bubble = document.createElement('p');
      bubble.className = 'faqfab__bubble faqfab__bubble--bot';
      bubble.appendChild(
        document.createTextNode(
          "I'm still in training and my master never covered that. They can answer it themselves though:"
        )
      );

      const actions = document.createElement('span');
      actions.className = 'faqfab__actions';

      const email = root.getAttribute('data-email') || '';
      const whatsapp = root.getAttribute('data-whatsapp') || '';
      const context = asked ? '\n\n' + asked : '';

      const mail = document.createElement('a');
      mail.className = 'faqfab__cta';
      mail.href =
        'mailto:' +
        email +
        '?subject=' +
        encodeURIComponent('FAQ question') +
        '&body=' +
        encodeURIComponent('Hi! I have a question about your services:' + context);
      mail.textContent = 'Email me';
      actions.appendChild(mail);

      const chat = document.createElement('a');
      chat.className = 'faqfab__cta';
      chat.href =
        whatsapp +
        (asked
          ? '?text=' +
            encodeURIComponent('Hi! I have a question about your services:' + context)
          : '');
      chat.target = '_blank';
      chat.rel = 'noopener noreferrer';
      chat.textContent = 'WhatsApp';
      actions.appendChild(chat);

      bubble.appendChild(actions);
      log.appendChild(bubble);
      scrollLog();
    };

    const respond = (questionText, reply, chip) => {
      appendBubble(questionText, 'user');

      if (chip) {
        chip.disabled = true;
        const mark = chip.querySelector('.faqfab__chip-mark');
        if (mark) mark.textContent = '✓';
      }

      const delay = reduceMotion.matches ? 0 : THINK_MS;

      const reveal = () => {
        if (reply) appendBubble(reply, 'bot');
        else appendFallback(questionText);
      };

      if (delay === 0) {
        reveal();
        requestAnimationFrame(scrollLog);
        return;
      }

      const typing = appendTyping();
      window.setTimeout(() => {
        typing.remove();
        reveal();
        scrollLog();
      }, delay);
    };

    const answer = (chip) => {
      const question = chip.getAttribute('data-question');
      const reply = chip.getAttribute('data-answer');
      if (!question || !reply) return;
      respond(question, reply, chip);
    };

    /* Static keyword matching — no network, no model, just pre-written answers. */

    const STOP_WORDS = new Set([
      'a', 'an', 'the', 'i', 'me', 'my', 'we', 'our', 'you', 'your', 'it', 'its',
      'is', 'are', 'was', 'be', 'do', 'does', 'can', 'could', 'would', 'will',
      'what', 'which', 'who', 'how', 'why', 'when', 'where', 'about', 'for',
      'to', 'of', 'on', 'in', 'and', 'or', 'with', 'that', 'this', 'there',
      'have', 'has', 'any', 'much',
    ]);

    const tokenize = (text) =>
      text
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, ' ')
        .split(' ')
        .filter((word) => word.length > 1 && !STOP_WORDS.has(word));

    const prefixHit = (tokens, word) => {
      const stem = word.slice(0, Math.max(4, Math.min(6, word.length)));
      return tokens.some(
        (token) => token === word || (token.length >= 4 && token.slice(0, stem.length) === stem)
      );
    };

    const index = Array.from(root.querySelectorAll('[data-faq-ask]')).map((chip) => {
      const question = chip.getAttribute('data-question') || '';
      const reply = chip.getAttribute('data-answer') || '';
      return {
        chip,
        question,
        reply,
        questionTokens: tokenize(question),
        answerTokens: tokenize(reply),
      };
    });

    const findMatch = (text) => {
      const query = tokenize(text);
      if (!query.length) return null;

      let best = null;
      let bestScore = 0;

      index.forEach((entry) => {
        let score = 0;
        query.forEach((word) => {
          if (prefixHit(entry.questionTokens, word)) score += 3;
          else if (prefixHit(entry.answerTokens, word)) score += 1;
        });
        if (score > bestScore) {
          best = entry;
          bestScore = score;
        }
      });

      return bestScore >= (query.length === 1 ? 1 : 2) ? best : null;
    };

    const ragUrl = (root.getAttribute('data-rag-url') || '').trim();
    const sessionKey = 'inodepi-chat-session';
    const sessionId = (() => {
      try {
        const saved = localStorage.getItem(sessionKey);
        if (saved) return saved;
        const id =
          typeof crypto !== 'undefined' && crypto.randomUUID
            ? crypto.randomUUID()
            : 'web-' + Math.random().toString(36).slice(2);
        localStorage.setItem(sessionKey, id);
        return id;
      } catch (error) {
        return 'web';
      }
    })();

    const askRag = async (text) => {
      if (!ragUrl) return null;
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 20000);
      try {
        const res = await fetch(ragUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question: text, sessionId }),
          signal: controller.signal,
        });
        if (!res.ok) return null;
        const json = await res.json();
        const raw = json && typeof json.answer === 'string' ? json.answer.trim() : '';
        if (!raw) return null;
        // Plain text in the panel: strip the model's markdown.
        return raw
          .replace(/\*\*(.+?)\*\*/g, '$1')
          .replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '$1 ($2)');
      } catch (error) {
        return null;
      } finally {
        window.clearTimeout(timer);
      }
    };

    const form = root.querySelector('[data-faq-form]');
    const input = root.querySelector('[data-faq-input]');

    if (form && input) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const text = input.value.trim();
        if (!text) return;

        input.value = '';
        input.focus({ preventScroll: true });

        // No RAG endpoint configured: keep the original Pip flow.
        if (!ragUrl) {
          const match = findMatch(text);
          if (match) respond(text, match.reply, match.chip);
          else respond(text, null);
          return;
        }

        appendBubble(text, 'user');
        const typing = appendTyping();
        const answer = await askRag(text);
        typing.remove();

        if (answer) {
          appendBubble(answer, 'bot');
          scrollLog();
          return;
        }

        // Pip fallback: pre-written FAQ answer, or the contact actions.
        const match = findMatch(text);
        if (match) appendBubble(match.reply, 'bot');
        else appendFallback(text);
        scrollLog();
      });
    }


    /* Theme override --------------------------------------------------- */
    // Keep the key and colours in sync with the no-flash script in Base.astro.

    const THEME_KEY = 'inodepi-theme';
    const THEME_COLORS = { dark: '#0c1727', light: '#f5f2ea' };

    const effectiveTheme = () => {
      const attr = document.documentElement.getAttribute('data-theme');
      if (attr === 'light' || attr === 'dark') return attr;
      return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    };

    const setTheme = (theme) => {
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem(THEME_KEY, theme);
      } catch (error) {}
      document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
        meta.setAttribute('content', THEME_COLORS[theme]);
      });
    };

    const toggleTheme = () => setTheme(effectiveTheme() === 'light' ? 'dark' : 'light');
    const clearTheme = () => {
      document.documentElement.removeAttribute('data-theme');
      try {
        localStorage.removeItem(THEME_KEY);
      } catch (error) {}
      const system = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
        meta.setAttribute('content', THEME_COLORS[system]);
      });
    };
    const hasSiteTheme = () => document.documentElement.classList.contains('site');

    // Cycle: auto -> light -> dark -> auto.
    const themeMode = () => (document.documentElement.getAttribute('data-theme') ? 'manual' : 'auto');
    const cycleTheme = () => {
      const current = document.documentElement.getAttribute('data-theme');
      if (!current) setTheme('light');
      else if (current === 'light') setTheme('dark');
      else clearTheme();
      syncThemeButton();
    };
    const syncThemeButton = () => {
      const btn = root.querySelector('[data-faq-theme]');
      const label = root.querySelector('[data-faq-theme-label]');
      if (!btn || !label) return;
      const attr = document.documentElement.getAttribute('data-theme');
      const mode = attr === 'light' ? 'Light' : attr === 'dark' ? 'Dark' : 'Auto';
      label.textContent = mode;
      btn.setAttribute('aria-label', 'Theme: ' + mode);
    };

    let lastTap = 0;
    trigger.addEventListener('click', () => {
      const now = Date.now();
      // A quick double tap flips the palette; a single tap opens the FAQ.
      if (now - lastTap < 350) {
        lastTap = 0;
        // Demo builds have their own brand palettes; leave them alone.
        if (hasSiteTheme()) {
          toggleTheme();
          close();
        }
        return;
      }
      lastTap = now;
      if (panel.hidden) open();
      else close();
    });

    closeButton.addEventListener('click', close);

    const themeButton = root.querySelector('[data-faq-theme]');
    if (themeButton) {
      if (!hasSiteTheme()) themeButton.hidden = true;
      else themeButton.addEventListener('click', cycleTheme);
    }
    syncThemeButton();

    root.querySelectorAll('[data-faq-ask]').forEach((chip) => {
      chip.addEventListener('click', () => answer(chip));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) close();
    });

    document.addEventListener('pointerdown', (event) => {
      if (panel.hidden) return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (panel.contains(target) || trigger.contains(target)) return;
      close();
    });
  })();
</script>

<style>
  .faqfab {
    /* Fallbacks keep the panel themed on demo pages, which set --d-* tokens. */
    --faq-bg: var(--panel, var(--d-surface, var(--d-bg, #ffffff)));
    --faq-raised: var(--panel-raised, color-mix(in srgb, var(--d-ink, #101828) 6%, var(--d-bg, #ffffff)));
    --faq-ink: var(--ink, var(--d-ink, #101828));
    --faq-soft: var(--ink-soft, color-mix(in srgb, var(--d-ink, #101828) 72%, transparent));
    --faq-dim: var(--ink-dim, color-mix(in srgb, var(--d-ink, #101828) 55%, transparent));
    --faq-line: var(--line, color-mix(in srgb, var(--d-ink, #101828) 18%, transparent));
    --faq-accent: var(--accent, var(--d-accent, #101828));
    --faq-accent-ink: var(--accent-ink, var(--d-accent-ink, #ffffff));
    --faq-mono: var(--font-mono, ui-monospace, 'SFMono-Regular', Menlo, monospace);
    --faq-display: var(--font-display, var(--d-display, var(--font-body, system-ui, sans-serif)));

    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 70;
  }

  .faqfab__trigger {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--faq-accent) 65%, transparent);
    border-radius: 50%;
    background: var(--faq-accent);
    color: var(--faq-accent-ink);
    box-shadow: 0 16px 32px -18px rgba(0, 0, 0, 0.6);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      transform 140ms ease,
      filter 140ms ease;
  }

  .faqfab__trigger:hover {
    transform: translateY(-1px);
    filter: brightness(1.05);
  }

  .faqfab__trigger-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .faqfab__trigger-dot {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    width: 0.55rem;
    height: 0.55rem;
    border: 2px solid var(--faq-accent);
    border-radius: 50%;
    background: var(--faq-accent-ink);
  }

  .faqfab__trigger:focus-visible,
  .faqfab__close:focus-visible,
  .faqfab__chip:focus-visible,
  .faqfab :global(.faqfab__cta):focus-visible {
    outline: 2px solid var(--faq-ink);
    outline-offset: 2px;
  }

  .faqfab__panel {
    position: absolute;
    right: 0;
    bottom: calc(3.5rem + 0.75rem);
    display: flex;
    flex-direction: column;
    width: min(24.5rem, calc(100vw - 1.5rem));
    height: min(35rem, calc(100dvh - 7rem));
    overflow: hidden;
    border: 1px solid var(--faq-line);
    border-radius: 12px;
    background: var(--faq-bg);
    color: var(--faq-ink);
    box-shadow: 0 28px 60px -28px rgba(0, 0, 0, 0.65);
    animation: faqfab-in 160ms ease-out;
  }

  .faqfab__panel[hidden] {
    display: none;
  }

  .faqfab__head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--faq-line);
    background: color-mix(in srgb, var(--faq-bg) 80%, transparent);
    backdrop-filter: blur(10px);
  }

  .faqfab__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    overflow: hidden;
    border: 1px solid var(--faq-line);
    border-radius: 50%;
    background: var(--faq-raised);
    color: var(--faq-accent);
  }

  .faqfab__avatar-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .faqfab__title-wrap {
    flex: 1;
    min-width: 0;
  }

  .faqfab__kicker {
    margin: 0.05rem 0 0;
    font-family: var(--faq-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--faq-dim);
  }

  .faqfab__title-wrap h2 {
    margin: 0;
    font-family: var(--faq-display);
    font-size: 1rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .faqfab__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--faq-line);
    border-radius: 7px;
    background: transparent;
    color: var(--faq-soft);
    cursor: pointer;
    transition:
      border-color 140ms ease,
      color 140ms ease;
  }

  .faqfab__close:hover {
    border-color: var(--faq-accent);
    color: var(--faq-accent);
  }

  .faqfab__theme {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.75rem;
    padding: 0 0.7rem;
    border: 1px solid var(--faq-line);
    border-radius: 7px;
    background: transparent;
    color: var(--faq-soft);
    font-family: var(--faq-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color 140ms ease,
      color 140ms ease;
  }

  .faqfab__theme:hover {
    border-color: var(--faq-accent);
    color: var(--faq-accent);
  }

  .faqfab__log {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.3rem;
    min-height: 6.5rem;
    overflow-y: auto;
    padding: 0.9rem 1rem;
    scrollbar-width: thin;
  }

  .faqfab :global(.faqfab__bubble) {
    align-self: flex-start;
    max-width: 80%;
    margin: 0;
    padding: 0.55rem 0.8rem;
    border: none;
    border-radius: 18px;
    border-bottom-left-radius: 5px;
    background: var(--faq-raised);
    color: var(--faq-ink);
    font-size: 0.9375rem;
    line-height: 1.45;
    animation: faqfab-bubble-in 160ms ease-out;
  }

  .faqfab :global(.faqfab__bubble--user) {
    align-self: flex-end;
    border-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 5px;
    background: var(--faq-accent);
    color: var(--faq-accent-ink);
    font-weight: 500;
  }

  .faqfab :global(.faqfab__cta) {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    margin-top: 0.6rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--faq-line);
    border-radius: 6px;
    background: var(--faq-bg);
    color: var(--faq-ink);
    font-family: var(--faq-mono);
    font-size: 0.75rem;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      color 140ms ease;
  }

  .faqfab :global(.faqfab__actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }

  .faqfab :global(.faqfab__actions .faqfab__cta) {
