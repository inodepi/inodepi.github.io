---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={['brand-mark', className]}
  width="24"
  height="24"
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M5 10h22M10 10v14.5M22 10v14.5"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
  ></path>
  <circle cx="10" cy="25" r="3" fill="currentColor"></circle>
  <circle cx="22" cy="25" r="2.9" stroke="currentColor" stroke-width="1.9"></circle>
</svg>

<style>
  .brand-mark {
    display: block;
    width: 1em;
    height: 1em;
    flex: none;
    color: var(--accent);
  }
</style>
