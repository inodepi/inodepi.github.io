---
import { siteConfig } from '../data/projects';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="status"><i aria-hidden="true"></i>Available for new build work</p>

      <h1>Close the loops you keep&nbsp;dropping.</h1>

      <p class="lede">
        I build the website and the n8n workflows behind it — booking, follow-ups, invoicing — so
        revenue stops leaking. One build, one handover. You own everything.
      </p>

      <p class="lede-leaks">
        The four leaks I fix most often: the call nobody answered, the lead nobody researched, the
        lead that went quiet, and the invoice nobody chased. <a href="/omnichannel-receptionist/"
          >Catch</a
        >, <a href="/lead-enrichment/">enrich</a>, <a href="/dead-lead-retrieval/">revive</a>, <a
          href="/ar-invoice-reminder/">remind</a
        >.
      </p>

      <div class="cta-row">
        <a class="btn btn-primary" href="#contact">Book a 15-min call</a>
        <a class="btn btn-secondary" href={`mailto:${siteConfig.email}?subject=Automation%20audit`}>
          Reply by email
        </a>
      </div>

      <p class="trust-strip">
        Solo builder · ships inside your own accounts · you own the build · no retainers unless you
        want them
      </p>

      <ul class="stack-line" aria-label="Typical stack">
        <li>n8n</li>
        <li>REST &amp; GraphQL</li>
        <li>Webhooks</li>
        <li>AI models</li>
        <li>Postgres</li>
      </ul>
    </div>

  </div>

  <div class="container">
    <nav class="pipeline" aria-label="The four-stage pipeline">
      <p class="pipeline-label">The loop, in four stages</p>
      <ol>
        <li class="pipeline-stop" style="--stop:var(--node-teal)">
          <a href="/omnichannel-receptionist/">
            <span class="pipeline-top">
              <span class="pipeline-index" aria-hidden="true">01</span>
              <span class="pipeline-name">Catch</span>
            </span>
            <span class="pipeline-desc">one receptionist across every channel</span>
          </a>
        </li>
        <li class="pipeline-stop" style="--stop:var(--node-blue)">
          <a href="/lead-enrichment/">
            <span class="pipeline-top">
              <span class="pipeline-index" aria-hidden="true">02</span>
              <span class="pipeline-name">Enrich</span>
            </span>
            <span class="pipeline-desc">research, score and draft before you call</span>
          </a>
        </li>
        <li class="pipeline-stop" style="--stop:var(--node-rose)">
          <a href="/dead-lead-retrieval/">
            <span class="pipeline-top">
              <span class="pipeline-index" aria-hidden="true">03</span>
              <span class="pipeline-name">Revive</span>
            </span>
            <span class="pipeline-desc">wake the leads that went quiet</span>
          </a>
        </li>
        <li class="pipeline-stop" style="--stop:var(--node-amber)">
          <a href="/ar-invoice-reminder/">
            <span class="pipeline-top">
              <span class="pipeline-index" aria-hidden="true">04</span>
              <span class="pipeline-name">Remind</span>
            </span>
            <span class="pipeline-desc">chase money owed without the awkwardness</span>
          </a>
        </li>
      </ol>
    </nav>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem);
  }

  .hero-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  /* single column now that the hero video is gone */

  .hero-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 46rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.32rem 0.7rem 0.32rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink-soft);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--node-teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--node-teal) 18%, transparent);
  }

  h1 {
    font-size: clamp(2.75rem, 1.5rem + 4.6vw, 4.5rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .lede {
    max-width: 34rem;
    color: var(--ink-soft);
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.1875rem);
    line-height: 1.6;
  }

  .lede a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    padding-bottom: 0.06em;
    transition: border-color 140ms ease;
  }

  .lede a:hover {
    border-bottom-color: currentColor;
  }

  .lede-leaks {
    max-width: 34rem;
    color: var(--ink-dim);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .lede-leaks a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    padding-bottom: 0.06em;
    transition: border-color 140ms ease;
  }

  .lede-leaks a:hover {
    border-bottom-color: currentColor;
  }

  .trust-strip {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }

  /* Four-stage pipeline band, below the hero grid. */
  .pipeline {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(1.75rem, 3.5vw, 2.5rem);
    border-top: 1px solid var(--line);
    animation: hero-rise 760ms 300ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .pipeline-label {
    margin-bottom: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .pipeline ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    background: var(--line);
  }

  @media (min-width: 800px) {
    .pipeline ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .pipeline-stop a {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    height: 100%;
    padding: 0.95rem 1rem 1.05rem;
    background: var(--panel);
    color: inherit;
    text-decoration: none;
    box-shadow: inset 0 3px 0 var(--stop);
    transition: background-color 160ms ease;
  }

  .pipeline-stop a:hover {
    background: var(--panel-raised);
  }

  .pipeline-stop a:hover .pipeline-name {
    color: var(--accent);
  }

  .pipeline-top {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .pipeline-index {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }

  .pipeline-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 640;
    letter-spacing: -0.02em;
  }

  .pipeline-desc {
    color: var(--ink-soft);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
    width: 100%;
  }

  .cta-row .btn {
    min-height: 3.25rem;
    padding-inline: 1.5rem;
  }

  @media (max-width: 479px) {
    .cta-row .btn {
      flex: 1 1 100%;
    }
  }

  .stack-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-dim);
    letter-spacing: 0.01em;
  }

  /* hero is text-only now; no video styles */



  /* One orchestrated entrance, then stillness. */
  .hero-copy > * {
    animation: hero-rise 760ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-copy > *:nth-child(2) {
    animation-delay: 60ms;
  }

  .hero-copy > *:nth-child(3) {
    animation-delay: 120ms;
  }

  .hero-copy > *:nth-child(4) {
    animation-delay: 180ms;
  }

  .hero-copy > *:nth-child(5) {
    animation-delay: 240ms;
  }

  .hero-visual {
    animation: hero-canvas-in 940ms 160ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-canvas-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.986);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
