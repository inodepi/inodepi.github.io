---
import { siteConfig } from '../data/projects';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="status"><i aria-hidden="true"></i>Available for new build work</p>

      <h1>Close the loops you keep&nbsp;dropping.</h1>

      <p class="lede">
        Revenue leaks in four places: the call nobody answered, the lead nobody researched, the
        lead that went quiet, and the invoice nobody chased. I build the site that
        <a href="/omnichannel-receptionist/">catches</a> the lead and the n8n workflows that
        <a href="/lead-enrichment/">enrich</a>, <a href="/dead-lead-retrieval/">revive</a> and
        <a href="/ar-invoice-reminder/">remind</a> — so nothing waits on a person copying data
        between tabs.
      </p>

      <div class="cta-row">
        <a class="btn btn-primary" href="#contact">Book a systems audit</a>
        <a class="btn btn-secondary" href="#work">See sample systems</a>
      </div>

      <ul class="stack-line" aria-label="Typical stack">
        <li>n8n</li>
        <li>REST &amp; GraphQL</li>
        <li>Webhooks</li>
        <li>AI models</li>
        <li>Postgres</li>
      </ul>
    </div>

    <div class="hero-visual">
      <button class="hero-video-btn" type="button" data-hero-open aria-label="Play the introduction with sound">
        <video
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/videos/hero-intro.jpg"
          aria-hidden="true"
        >
          <source src="/videos/hero-intro.mp4" type="video/mp4" />
        </video>
        <span class="hero-video-hint" aria-hidden="true">
          <svg viewBox="0 0 16 16"><path d="M4.5 2.8 13 8l-8.5 5.2z" fill="currentColor"></path></svg>
          Watch with sound
        </span>
      </button>
    </div>
  </div>

  <div class="container">
    <nav class="pipeline" aria-label="The four-stage pipeline">
      <p class="pipeline-label">The loop, in four stages</p>
      <ol>
        <li class="pipeline-stop" style="--stop:var(--node-teal)">
          <a href="/omnichannel-receptionist/">
            <span class="pipeline-top">
              <span class="pipeline-index" aria-hidden="true">01</span>
              <span class="pipeline-name">Catch</span>
            </span>
            <span class="pipeline-desc">one receptionist across every channel</span>
          </a>
        </li>
        <li class="pipeline-stop" style="--stop:var(--node-blue)">
          <a href="/lead-enrichment/">
            <span class="pipeline-top">
              <span class="pipeline-index" aria-hidden="true">02</span>
              <span class="pipeline-name">Enrich</span>
            </span>
            <span class="pipeline-desc">research, score and draft before you call</span>
          </a>
        </li>
        <li class="pipeline-stop" style="--stop:var(--node-rose)">
          <a href="/dead-lead-retrieval/">
            <span class="pipeline-top">
              <span class="pipeline-index" aria-hidden="true">03</span>
              <span class="pipeline-name">Revive</span>
            </span>
            <span class="pipeline-desc">wake the leads that went quiet</span>
          </a>
        </li>
        <li class="pipeline-stop" style="--stop:var(--node-amber)">
          <a href="/ar-invoice-reminder/">
            <span class="pipeline-top">
              <span class="pipeline-index" aria-hidden="true">04</span>
              <span class="pipeline-name">Remind</span>
            </span>
            <span class="pipeline-desc">chase money owed without the awkwardness</span>
          </a>
        </li>
      </ol>
    </nav>
  </div>
</section>

<dialog class="hero-modal" id="hero-video-modal" aria-label="Introduction video">
  <button class="hero-modal-close" type="button" data-hero-close aria-label="Close video">✕</button>
  <video class="hero-modal-player" controls playsinline preload="none" poster="/videos/hero-intro.jpg">
    <source src="/videos/hero-intro.mp4" type="video/mp4" />
    <track kind="captions" src="/videos/hero-intro.vtt" srclang="en" label="English" />
  </video>
</dialog>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>('[data-hero-open]');
  const modal = document.getElementById('hero-video-modal') as HTMLDialogElement | null;
  const player = modal?.querySelector('video') ?? null;
  const heroVideo = openBtn?.querySelector('video') ?? null;
  const closeBtn = modal?.querySelector<HTMLButtonElement>('[data-hero-close]');

  if (openBtn && modal && player) {
    openBtn.addEventListener('click', () => {
      modal.showModal();
      player.currentTime = 0;
      player.play().catch(() => {});
      heroVideo?.pause();
    });

    const close = () => {
      modal.close();
      player.pause();
      heroVideo?.play().catch(() => {});
    };

    closeBtn?.addEventListener('click', close);
    modal.addEventListener('close', close);

    modal.addEventListener('click', (event) => {
      const rect = player.getBoundingClientRect();
      const { clientX: x, clientY: y } = event as MouseEvent;
      const outside = x < rect.left || x > rect.right || y < rect.top || y > rect.bottom;
      if (outside && event.target !== closeBtn) close();
    });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem);
  }

  .hero-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 37rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.32rem 0.7rem 0.32rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink-soft);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--node-teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--node-teal) 18%, transparent);
  }

  h1 {
    font-size: clamp(2.75rem, 1.5rem + 4.6vw, 4.5rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .lede {
    max-width: 34rem;
    color: var(--ink-soft);
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.1875rem);
    line-height: 1.6;
  }

  .lede a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    padding-bottom: 0.06em;
    transition: border-color 140ms ease;
  }

  .lede a:hover {
    border-bottom-color: currentColor;
  }

  /* Four-stage pipeline band, below the hero grid. */
  .pipeline {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(1.75rem, 3.5vw, 2.5rem);
    border-top: 1px solid var(--line);
    animation: hero-rise 760ms 300ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .pipeline-label {
    margin-bottom: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .pipeline ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    background: var(--line);
  }

  @media (min-width: 800px) {
    .pipeline ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .pipeline-stop a {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    height: 100%;
    padding: 0.95rem 1rem 1.05rem;
    background: var(--panel);
    color: inherit;
    text-decoration: none;
    box-shadow: inset 0 3px 0 var(--stop);
    transition: background-color 160ms ease;
  }

  .pipeline-stop a:hover {
    background: var(--panel-raised);
  }

  .pipeline-stop a:hover .pipeline-name {
    color: var(--accent);
  }

  .pipeline-top {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .pipeline-index {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }

  .pipeline-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 640;
    letter-spacing: -0.02em;
  }

  .pipeline-desc {
    color: var(--ink-soft);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
    width: 100%;
  }

  .cta-row .btn {
    min-height: 3.25rem;
    padding-inline: 1.5rem;
  }

  @media (max-width: 479px) {
    .cta-row .btn {
      flex: 1 1 100%;
    }
  }

  .stack-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-dim);
    letter-spacing: 0.01em;
  }

  .hero-visual {
    display: grid;
    gap: 0.85rem;
  }

  .hero-video-btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 18px;
  }

  .hero-video-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .hero-video-hint {
    position: absolute;
    inset: auto 1rem 1rem auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    backdrop-filter: blur(6px);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .hero-video-hint svg {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--accent);
  }

  .hero-video-btn:hover .hero-video-hint,
  .hero-video-btn:focus-visible .hero-video-hint {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--panel) 96%, transparent);
  }

  .hero-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--panel);
    box-shadow: var(--shadow);
    object-fit: cover;
  }

  .hero-modal {
    margin: auto;
    position: fixed;
    inset: 0;
    height: fit-content;
    max-height: calc(100vh - 3rem);
    width: min(92vw, 1200px);
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: var(--bg);
    box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.9);
    overflow: visible;
  }

  .hero-modal::backdrop {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(4px);
  }

  .hero-modal-player {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 17px;
    background: #000;
  }

  .hero-modal-close {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    color: var(--ink);
    font-size: 1rem;
    cursor: pointer;
  }

  .hero-modal-close:hover {
    background: var(--panel-raised);
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }

    .hero-visual::after {
      content: '';
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: url('/videos/hero-intro.jpg') center / cover no-repeat;
    }
  }



  /* One orchestrated entrance, then stillness. */
  .hero-copy > * {
    animation: hero-rise 760ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-copy > *:nth-child(2) {
    animation-delay: 60ms;
  }

  .hero-copy > *:nth-child(3) {
    animation-delay: 120ms;
  }

  .hero-copy > *:nth-child(4) {
    animation-delay: 180ms;
  }

  .hero-copy > *:nth-child(5) {
    animation-delay: 240ms;
  }

  .hero-visual {
    animation: hero-canvas-in 940ms 160ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-canvas-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.986);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
