---
import { siteConfig } from '../data/projects';
import WorkflowCanvas from './WorkflowCanvas.astro';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="status"><i aria-hidden="true"></i>Available for new build work</p>

      <h1>Your operations, wired end&nbsp;to&nbsp;end.</h1>

      <p class="lede">
        I'm an n8n automation architect. I design multi-workflow systems that connect your CRM,
        inbox, APIs, and AI models into one dependable pipeline — so work moves from trigger to
        outcome without a person copying data between tabs.
      </p>

      <div class="cta-row">
        <a class="btn btn-primary" href="#contact">Book a systems audit</a>
        <a class="btn btn-secondary" href="#work">See sample systems</a>
      </div>

      <ul class="stack-line" aria-label="Typical stack">
        <li>n8n</li>
        <li>REST &amp; GraphQL</li>
        <li>Webhooks</li>
        <li>AI models</li>
        <li>Postgres</li>
      </ul>
    </div>

    <div class="hero-visual">
      <WorkflowCanvas />
      <p class="visual-note">A sample graph: intake, qualify, write to CRM, notify the team.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem);
  }

  .hero-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 37rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.32rem 0.7rem 0.32rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink-soft);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--node-teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--node-teal) 18%, transparent);
  }

  h1 {
    font-size: clamp(2.75rem, 1.5rem + 4.6vw, 4.5rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .lede {
    max-width: 34rem;
    color: var(--ink-soft);
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.1875rem);
    line-height: 1.6;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
    width: 100%;
  }

  .cta-row .btn {
    min-height: 3.25rem;
    padding-inline: 1.5rem;
  }

  @media (max-width: 479px) {
    .cta-row .btn {
      flex: 1 1 100%;
    }
  }

  .stack-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-dim);
    letter-spacing: 0.01em;
  }

  .hero-visual {
    display: grid;
    gap: 0.85rem;
  }

  .visual-note {
    padding-left: 0.15rem;
    color: var(--ink-dim);
    font-size: 0.8125rem;
  }

  .visual-note::before {
    content: '↳ ';
    color: var(--line-strong);
  }
</style>
