---
const capabilities: { title: string; body: string; hue: string; href?: string }[] = [
  {
    title: 'Multi-workflow systems',
    body: 'Chained workflows, sub-workflows, and shared state. Built to survive production traffic, not just the demo.',
    hue: 'var(--node-amber)',
  },
  {
    title: 'API & webhook integrations',
    body: 'REST and GraphQL clients, inbound webhooks, auth, pagination, retries, and rate limits handled at the edge.',
    hue: 'var(--node-teal)',
  },
  {
    title: 'AI pipelines',
    body: 'Classification, extraction, retrieval, and agent steps grounded in your own data — with fallbacks when a model is unsure.',
    hue: 'var(--node-violet)',
  },
  {
    title: 'Data sync & enrichment',
    body: 'Keep CRM, sheets, and databases aligned. Deduplicate, normalize, and enrich records while they move.',
    hue: 'var(--node-rose)',
  },
  {
    title: 'Lead routing & CRM ops',
    body: 'Capture, score, route, and follow up. The CRM is updated before a human opens the lead.',
    hue: 'var(--node-teal)',
  },
  {
    title: 'Observability & error handling',
    body: 'Structured logs, alerts, idempotent retries, and dead-letter paths, so failures surface instead of vanishing.',
    hue: 'var(--node-amber)',
  },
  {
    title: "Websites that don't lose the lead",
    body: 'Pages that crawl, forms that go nowhere, no way to book: a broken site drops the lead before anything else gets a chance. I fix the site, then wire it into the workflows behind it.',
    hue: 'var(--node-rose)',
    href: '/websites/',
  },
];
---

<section class="section" id="capabilities">
  <div class="container">
    <div class="section-head">
      <h2>Systems, not one-off scripts.</h2>
      <p class="section-lede">
        Most automation fails where two tools disagree. I design for those seams: validation,
        retries, and a clear owner for every record, so the whole process holds together.
      </p>
    </div>

    <ul class="cap-grid">
      {capabilities.map((cap) => (
        <li class:list={['cap', { 'cap--wide': cap.href }]}>
          <span class="cap-mark" style={`--mark:${cap.hue}`} aria-hidden="true"></span>
          <h3>{cap.title}</h3>
          <p>{cap.body}</p>
          {cap.href && <a class="cap-link" href={cap.href}>See the demo builds</a>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .cap {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.4rem, 2.6vw, 2rem);
    background: var(--panel);
    transition: background-color 200ms ease;
  }

  @media (hover: hover) {
    .cap:hover {
      background: var(--panel-raised);
    }
  }

  .cap-mark {
    width: 1.6rem;
    height: 3px;
    border-radius: 2px;
    background: var(--mark);
  }

  .cap h3 {
    margin-top: 0.2rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .cap p {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .cap-link {
    justify-self: start;
    margin-top: 0.35rem;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    padding-bottom: 0.1rem;
  }

  .cap-link:hover {
    border-bottom-color: var(--accent);
  }

  /* The web-design capability closes the grid as a full-width band. */
  .cap--wide {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 2rem;
    row-gap: 0.5rem;
  }

  .cap--wide .cap-mark,
  .cap--wide h3,
  .cap--wide p {
    grid-column: 1;
  }

  .cap--wide p {
    max-width: 68ch;
  }

  .cap--wide .cap-mark {
    grid-row: 1;
  }

  .cap--wide .cap-link {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: center;
    margin-top: 0;
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    .cap--wide {
      grid-template-columns: minmax(0, 1fr);
    }

    .cap--wide .cap-link {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
    }
  }
</style>
