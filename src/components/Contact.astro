---
import { siteConfig } from '../data/projects';

const calUrl = siteConfig.calendarUrl;
---

<section class="section contact" id="contact">
  <div class="container contact-grid">
    <div class="contact-copy">
      <h2>Tell me what should stop being manual.</h2>
      <p class="section-lede">
        The fastest way to find out is a 15-minute discovery call. We map the process, count the
        hours it eats, and decide together whether automation is worth it. If it isn't, I will say
        so.
      </p>

      <dl class="contact-direct">
        <div>
          <dt>Discovery call</dt>
          <dd>
            <a href={calUrl} target="_blank" rel="noopener noreferrer">Book a 15-minute call</a>
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd>
        </div>
        <div>
          <dt>Response</dt>
          <dd>{siteConfig.responseTime}</dd>
        </div>
      </dl>

      <p class="contact-fine">
        No pitch deck. Bring the process that hurts and the tools it touches.
      </p>
    </div>

    <div class="booking" data-booking data-cal-url={calUrl}>
      <div class="booking-head">
        <div>
          <strong>15-minute discovery call</strong>
          <span>Two weeks at a glance.</span>
        </div>
        <div class="booking-nav">
          <button type="button" data-cal-prev aria-label="Previous two weeks">←</button>
          <span class="booking-range" data-cal-range>—</span>
          <button type="button" data-cal-next aria-label="Next two weeks">→</button>
        </div>
      </div>

      <div class="booking-grid">
        <div class="booking-weekdays" aria-hidden="true">
          <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
        </div>
        <div class="booking-days" data-cal-grid role="group" aria-label="Pick a call date"></div>
      </div>

      <div class="booking-foot">
        <p class="booking-selected">
          <span>Selected</span>
          <strong data-cal-selected>—</strong>
        </p>
        <a
          class="btn btn-primary"
          data-cal-cta
          href={calUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Continue to booking
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <p class="booking-note">
        Times are shown on the next step. Or
        <a href={calUrl} target="_blank" rel="noopener noreferrer">open the full calendar</a>.
      </p>

      <noscript>
        <p class="booking-note">
          <a href={calUrl} target="_blank" rel="noopener noreferrer">Open the booking calendar</a>
          to pick a time.
        </p>
      </noscript>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-booking]');
    if (!root) return;

    const calUrl = root.getAttribute('data-cal-url');
    const grid = root.querySelector('[data-cal-grid]');
    const rangeEl = root.querySelector('[data-cal-range]');
    const selectedEl = root.querySelector('[data-cal-selected]');
    const cta = root.querySelector('[data-cal-cta]');
    const prevBtn = root.querySelector('[data-cal-prev]');
    const nextBtn = root.querySelector('[data-cal-next]');

    if (!grid || !rangeEl || !selectedEl || !cta || !prevBtn || !nextBtn) return;

    const dayFmt = new Intl.DateTimeFormat('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
    });
    const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short' });
    const iso = (date) =>
      date.getFullYear() +
      '-' +
      String(date.getMonth() + 1).padStart(2, '0') +
      '-' +
      String(date.getDate()).padStart(2, '0');

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const base = new Date(today);
    base.setDate(today.getDate() - today.getDay());

    let offset = 0;
    let selected = null;

    const updateSelection = () => {
      if (!selected) return;
      const date = new Date(selected + 'T00:00:00');
      selectedEl.textContent = dayFmt.format(date);
      cta.href = calUrl + '?date=' + selected;
      cta.removeAttribute('aria-disabled');
    };

    const render = () => {
      const start = new Date(base);
      start.setDate(base.getDate() + offset * 14);

      const end = new Date(start);
      end.setDate(start.getDate() + 13);

      // Drop a selection that paged out of view.
      if (selected) {
        const selectedTime = new Date(selected + 'T00:00:00').getTime();
        if (selectedTime < start.getTime() || selectedTime > end.getTime()) {
          selected = null;
        }
      }

      if (start.getMonth() === end.getMonth()) {
        rangeEl.textContent =
          monthFmt.format(start) + ' ' + start.getDate() + ' – ' + end.getDate() + ', ' + end.getFullYear();
      } else {
        rangeEl.textContent =
          monthFmt.format(start) + ' ' + start.getDate() + ' – ' + monthFmt.format(end) + ' ' + end.getDate() + ', ' + end.getFullYear();
      }

      grid.innerHTML = '';

      for (let index = 0; index < 14; index += 1) {
        const date = new Date(start);
        date.setDate(start.getDate() + index);

        const value = iso(date);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'booking-day';
        button.textContent = String(date.getDate());
        button.dataset.date = value;
        button.setAttribute('aria-label', dayFmt.format(date));

        if (date < today) button.disabled = true;
        if (date.getTime() === today.getTime()) button.classList.add('is-today');
        if (selected === value) button.classList.add('is-selected');

        button.addEventListener('click', () => {
          selected = value;
          render();
          updateSelection();
        });

        grid.append(button);
      }

      prevBtn.disabled = offset === 0;

      if (!selected) {
        const firstAvailable = grid.querySelector('button:not([disabled])');
        if (firstAvailable) {
          selected = firstAvailable.dataset.date;
          firstAvailable.classList.add('is-selected');
        }
      }

      updateSelection();
    };

    prevBtn.addEventListener('click', () => {
      if (offset === 0) return;
      offset -= 1;
      render();
    });

    nextBtn.addEventListener('click', () => {
      offset += 1;
      render();
    });

    render();
  })();
</script>

<style>
  .contact-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  .contact-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .contact-copy h2 {
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.25rem);
    max-width: 18ch;
  }

  .contact-direct {
    display: grid;
    gap: 1.1rem;
    margin: 0.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line);
    width: 100%;
  }

  .contact-direct div {
    display: grid;
    gap: 0.15rem;
  }

  .contact-direct dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-dim);
    letter-spacing: 0.03em;
  }

  .contact-direct dd {
    margin: 0;
    font-size: 1rem;
  }

  .contact-direct a {
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .contact-direct a:hover {
    color: var(--accent);
  }

  .contact-fine {
    color: var(--ink-dim);
    font-size: 0.875rem;
    max-width: 38ch;
  }
</style>

<style is:global>
  /* Custom two-week booking calendar */
  .booking {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .booking-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 1rem 1.15rem;
    background: var(--panel-raised);
    border-bottom: 1px solid var(--line);
  }

  .booking-head strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .booking-head span {
    display: block;
    margin-top: 0.1rem;
    color: var(--ink-dim);
    font-size: 0.8125rem;
  }

  .booking-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .booking-nav button {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel);
    color: var(--ink-soft);
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 140ms ease,
      color 140ms ease;
  }

  .booking-nav button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .booking-nav button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .booking-range {
    min-width: 8.5rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .booking-grid {
    padding: 1rem 1.15rem 0.9rem;
  }

  .booking-weekdays,
  .booking-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.35rem;
  }

  .booking-weekdays {
    margin-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-dim);
    text-align: center;
  }

  .booking-day {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    min-height: 2.4rem;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      background-color 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
  }

  .booking-day:hover:not(:disabled) {
    border-color: var(--line-strong);
    background: var(--panel-raised);
  }

  .booking-day:disabled {
    color: var(--line-strong);
    cursor: default;
  }

  .booking-day.is-today {
    border-color: rgba(245, 166, 35, 0.45);
    color: var(--accent);
  }

  .booking-day.is-selected {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }

  .booking-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    padding: 0.9rem 1.15rem;
    background: var(--panel-raised);
    border-top: 1px solid var(--line);
  }

  .booking-selected span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .booking-selected strong {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .booking-foot .btn {
    min-height: 2.6rem;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
  }

  .booking-foot .btn svg {
    width: 0.75rem;
    height: 0.75rem;
  }

  .booking-note {
    padding: 0.65rem 1.15rem 0.85rem;
    color: var(--ink-dim);
    font-size: 0.75rem;
  }

  .booking-note a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .booking-note a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .booking-weekdays,
    .booking-days {
      gap: 0.25rem;
    }

    .booking-day {
      min-height: 2rem;
      font-size: 0.75rem;
    }

    .booking-range {
      min-width: 7.5rem;
      font-size: 0.625rem;
    }
  }
</style>
