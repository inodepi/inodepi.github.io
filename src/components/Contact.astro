---
import { siteConfig } from '../data/projects';

const calUrl = siteConfig.calendarUrl;
---

<section class="section contact" id="contact">
  <div class="container contact-grid">
    <div class="contact-copy">
      <h2>Tell me what should stop being manual.</h2>
      <p class="section-lede">
        The fastest way to find out is a 60-minute fit call. We map the process, count the hours
        it eats, and decide together whether automation is worth it. If it isn't, I will say so.
      </p>

      <dl class="contact-direct">
        <div>
          <dt>Fit call</dt>
          <dd>
            <a href={calUrl} target="_blank" rel="noopener noreferrer">Book a 60-minute call</a>
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd>
        </div>
        <div>
          <dt>Response</dt>
          <dd>{siteConfig.responseTime}</dd>
        </div>
      </dl>

      <p class="contact-fine">
        No pitch deck. Bring the process that hurts and the tools it touches.
      </p>
    </div>

    <div class="calendar">
      <div class="calendar-head">
        <div>
          <strong>60-minute fit call</strong>
          <span>Pick a time that works for you.</span>
        </div>
        <a href={calUrl} target="_blank" rel="noopener noreferrer">Open in new tab ↗</a>
      </div>

      <div class="calendar-embed" id="cal-inline"></div>

      <p class="calendar-note">
        Calendar not loading? <a href={calUrl} target="_blank" rel="noopener noreferrer">Open it directly</a>
        or email {siteConfig.email}.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement('script')).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === 'string') {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ['initNamespace', namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  Cal('init', { origin: 'https://app.cal.com' });
  Cal('inline', {
    elementOrSelector: '#cal-inline',
    calLink: 'christian-john-vallejos-adws8d/60min',
    config: { layout: 'month_view', theme: 'dark' },
  });
  Cal('ui', {
    hideEventTypeDetails: false,
    layout: 'month_view',
    styles: { branding: { brandColor: '#f5a623' } },
  });
</script>

<style>
  .contact-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    }
  }

  .contact-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .contact-copy h2 {
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.25rem);
    max-width: 18ch;
  }

  .contact-direct {
    display: grid;
    gap: 1.1rem;
    margin: 0.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line);
    width: 100%;
  }

  .contact-direct div {
    display: grid;
    gap: 0.15rem;
  }

  .contact-direct dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-dim);
    letter-spacing: 0.03em;
  }

  .contact-direct dd {
    margin: 0;
    font-size: 1rem;
  }

  .contact-direct a {
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .contact-direct a:hover {
    color: var(--accent);
  }

  .contact-fine {
    color: var(--ink-dim);
    font-size: 0.875rem;
    max-width: 38ch;
  }

  .calendar {
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .calendar-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 1rem 1.15rem;
    background: var(--panel-raised);
    border-bottom: 1px solid var(--line);
  }

  .calendar-head strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .calendar-head span {
    display: block;
    margin-top: 0.1rem;
    color: var(--ink-dim);
    font-size: 0.8125rem;
  }

  .calendar-head a {
    font-size: 0.75rem;
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .calendar-head a:hover {
    color: var(--accent);
  }

  .calendar-embed {
    width: 100%;
    height: 760px;
    min-height: 620px;
    overflow: hidden;
    background: var(--panel);
  }

  .calendar-embed iframe {
    width: 100% !important;
    height: 100% !important;
    border: 0;
  }

  .calendar-note {
    padding: 0.7rem 1.15rem;
    border-top: 1px solid var(--line);
    background: var(--panel-raised);
    color: var(--ink-dim);
    font-size: 0.75rem;
  }

  .calendar-note a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .calendar-note a:hover {
    color: var(--accent);
  }
</style>
