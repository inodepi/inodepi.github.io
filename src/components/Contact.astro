---
import { siteConfig } from '../data/projects';

const calUrl = siteConfig.calendarUrl;
const calLink = calUrl.replace(/^https?:\/\/(app\.)?cal\.com\//, '');
---

<section class="section contact" id="contact">
  <div class="container contact-grid">
    <div class="contact-copy">
      <h2>Tell me what should stop being manual.</h2>
      <p class="section-lede">
        The fastest way to find out is a 15-minute discovery call. We map the process, count the
        hours it eats, and decide together whether automation is worth it. If it isn't, I will say
        so.
      </p>

      <dl class="contact-direct">
        <div>
          <dt>Discovery call</dt>
          <dd>
            <a href={calUrl} target="_blank" rel="noopener noreferrer">Book a 15-minute call</a>
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd>
        </div>
        <div>
          <dt>Response</dt>
          <dd>{siteConfig.responseTime}</dd>
        </div>
      </dl>

      <p class="contact-fine">
        No pitch deck. Bring the process that hurts and the tools it touches.
      </p>
    </div>

    <div class="booking" data-booking data-cal-link={calLink} data-cal-url={calUrl}>
      <div class="booking-head">
        <div>
          <strong>15-minute discovery call</strong>
          <span>Live availability · Asia/Manila</span>
        </div>
        <a
          class="booking-external"
          href={calUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Open in Cal.com
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="booking-embed" id="cal-inline" data-cal-inline>
        <noscript>
          <p class="booking-note">
            <a href={calUrl} target="_blank" rel="noopener noreferrer">Open the booking calendar</a>
            to pick a time.
          </p>
        </noscript>
      </div>

      <p class="booking-note">
        Powered by Cal.com. Times open in your browser's time zone.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-booking]');
    const mount = document.querySelector('[data-cal-inline]');
    if (!root || !mount) return;

    const calLink = root.getAttribute('data-cal-link');
    if (!calLink) return;

    const theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';

    (function (C, A, L) {
      const p = function (a, ar) {
        a.q.push(ar);
      };
      const d = C.document;
      C.Cal =
        C.Cal ||
        function () {
          const cal = C.Cal;
          const ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement('script')).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () {
              p(api, arguments);
            };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === 'string') {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ['initNamespace', namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');

    Cal('init', { origin: 'https://app.cal.com' });

    Cal('inline', {
      elementOrSelector: '[data-cal-inline]',
      calLink: calLink,
      config: { layout: 'month_view', theme: theme },
    });

    Cal('ui', {
      theme: theme,
      layout: 'month_view',
      hideEventTypeDetails: false,
      cssVarsPerTheme: {
        dark: {
          'cal-brand': '#f5a623',
          'cal-brand-emphasis': '#ffbc55',
          'cal-brand-text': '#101a2b',
          'cal-brand-subtle': '#8a5f14',
          'cal-brand-accent': '#101a2b',

          'cal-text': '#eaf0f8',
          'cal-text-emphasis': '#eaf0f8',
          'cal-text-subtle': '#a5b8cf',
          'cal-text-muted': '#7f97b3',
          'cal-text-inverted': '#101a2b',

          'cal-bg': '#122135',
          'cal-bg-emphasis': '#16293f',
          'cal-bg-subtle': '#16293f',
          'cal-bg-muted': '#0f1c2e',
          'cal-bg-inverted': '#eaf0f8',

          'cal-border': '#23384f',
          'cal-border-emphasis': '#3a5471',
          'cal-border-subtle': '#23384f',
          'cal-border-muted': '#1b2c40',

          'cal-border-booker': 'transparent',
          'cal-border-booker-width': '0px',

          radius: '10px',
        },
        light: {
          'cal-brand': '#f5a623',
          'cal-brand-emphasis': '#e79a12',
          'cal-brand-text': '#101a2b',
          'cal-brand-subtle': '#ffd591',
          'cal-brand-accent': '#101a2b',

          'cal-text': '#0e1b2b',
          'cal-text-emphasis': '#0e1b2b',
          'cal-text-subtle': '#42586d',
          'cal-text-muted': '#576c80',
          'cal-text-inverted': '#ffffff',

          'cal-bg': '#ffffff',
          'cal-bg-emphasis': '#f6f9fa',
          'cal-bg-subtle': '#f6f9fa',
          'cal-bg-muted': '#eef2f4',
          'cal-bg-inverted': '#0e1b2b',

          'cal-border': '#d2dde5',
          'cal-border-emphasis': '#9fb4c5',
          'cal-border-subtle': '#d2dde5',
          'cal-border-muted': '#e6edf2',

          'cal-border-booker': 'transparent',
          'cal-border-booker-width': '0px',

          radius: '10px',
        },
      },
    });
  })();
</script>

<style>
  .contact-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  .contact-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .contact-copy h2 {
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.25rem);
    max-width: 18ch;
  }

  .contact-direct {
    display: grid;
    gap: 1.1rem;
    margin: 0.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line);
    width: 100%;
  }

  .contact-direct div {
    display: grid;
    gap: 0.15rem;
  }

  .contact-direct dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-dim);
    letter-spacing: 0.03em;
  }

  .contact-direct dd {
    margin: 0;
    font-size: 1rem;
  }

  .contact-direct a {
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .contact-direct a:hover {
    color: var(--accent);
  }

  .contact-fine {
    color: var(--ink-dim);
    font-size: 0.875rem;
    max-width: 38ch;
  }
</style>

<style is:global>
  /* Cal.com inline booking embed */
  .booking {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .booking-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 1rem 1.15rem;
    background: var(--panel-raised);
    border-bottom: 1px solid var(--line);
  }

  .booking-head strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .booking-head span {
    display: block;
    margin-top: 0.1rem;
    color: var(--ink-dim);
    font-size: 0.8125rem;
  }

  .booking-external {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }

  .booking-external svg {
    width: 0.7rem;
    height: 0.7rem;
  }

  .booking-external:hover {
    color: var(--accent);
  }

  .booking-embed {
    min-height: 30rem;
    background: var(--panel);
    color: var(--ink);
  }

  .booking-embed iframe {
    width: 100%;
    border: 0;
  }

  .booking-note {
    padding: 0.65rem 1.15rem 0.85rem;
    border-top: 1px solid var(--line);
    color: var(--ink-dim);
    font-size: 0.75rem;
  }

  .booking-note a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .booking-note a:hover {
    color: var(--accent);
  }
</style>
