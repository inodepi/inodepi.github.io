---
import { siteConfig } from '../data/projects';

const calUrl = siteConfig.calendarUrl;
const calLink = calUrl.replace(/^https?:\/\/(app\.)?cal\.com\//, '');
const eventTypeId = siteConfig.calendarEventTypeId;
const calTimeZone = siteConfig.calendarTimeZone;
---

<section class="section contact" id="contact">
  <div class="container contact-grid">
    <div class="contact-copy">
      <h2>Tell me what should stop being manual.</h2>
      <p class="section-lede">
        The fastest way to find out is a 15-minute discovery call. We map the process, count the
        hours it eats, and decide together whether automation is worth it. If it isn't, I will say
        so.
      </p>

      <dl class="contact-direct">
        <div>
          <dt>Discovery call</dt>
          <dd>
            <a href={calUrl} target="_blank" rel="noopener noreferrer">Book a 15-minute call</a>
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd>
        </div>
        <div>
          <dt>Response</dt>
          <dd>{siteConfig.responseTime}</dd>
        </div>
      </dl>

      <p class="contact-fine">
        No pitch deck. Bring the process that hurts and the tools it touches.
      </p>
    </div>

    <div
      class="booking"
      data-booking
      data-cal-link={calLink}
      data-cal-url={calUrl}
      data-event-type-id={eventTypeId}
      data-cal-timezone={calTimeZone}
    >
      <div class="booking-head">
        <div>
          <strong>15-minute discovery call</strong>
          <span>Times shown in your time zone</span>
        </div>
        <div class="booking-nav">
          <button type="button" data-cal-prev aria-label="Previous week">←</button>
          <span class="booking-range" data-cal-range>—</span>
          <button type="button" data-cal-next aria-label="Next week">→</button>
        </div>
      </div>

      <div class="booking-grid">
        <div class="booking-weekdays" aria-hidden="true">
          <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
        </div>
        <div class="booking-days" data-cal-grid role="group" aria-label="Pick a call date"></div>
      </div>

      <div class="booking-times" data-cal-times aria-live="polite">
        <p class="booking-empty">Loading availability…</p>
      </div>

      <div class="booking-done" data-cal-done hidden>
        <p class="booking-done-kicker">Booked</p>
        <strong>You're one step away from closing your loop.</strong>
        <p class="booking-done-body">
          Your 15-minute call is confirmed. The Zoom link and the passcode are in your
          confirmation email — check it, then close the loop.
        </p>
        <a
          class="booking-done-link"
          href={calUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Book another time
        </a>
      </div>

      <p class="booking-note">
        Pick a day to see open slots. Or <a href={calUrl} target="_blank" rel="noopener noreferrer">open the full calendar</a>.
      </p>

      <noscript>
        <p class="booking-note">
          <a href={calUrl} target="_blank" rel="noopener noreferrer">Open the booking calendar</a>
          to pick a time.
        </p>
      </noscript>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-booking]');
    if (!root) return;

    const grid = root.querySelector('[data-cal-grid]');
    const rangeEl = root.querySelector('[data-cal-range]');
    const timesEl = root.querySelector('[data-cal-times]');
    const prevBtn = root.querySelector('[data-cal-prev]');
    const nextBtn = root.querySelector('[data-cal-next]');
    const doneEl = root.querySelector('[data-cal-done]');
    const headNav = root.querySelector('.booking-nav');
    const calUrl = root.getAttribute('data-cal-url');
    const calLink = root.getAttribute('data-cal-link');
    const eventTypeId = root.getAttribute('data-event-type-id');
    const timeZone = root.getAttribute('data-cal-timezone') || 'UTC';
    const API = 'https://api.cal.com/v2/slots';

    if (!grid || !rangeEl || !timesEl || !prevBtn || !nextBtn || !calUrl || !eventTypeId) return;

    const dayFmt = new Intl.DateTimeFormat(undefined, {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
    });
    const rangeFmt = new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric' });
    const timeFmt = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
    const pad = (n) => String(n).padStart(2, '0');
    const iso = (d) => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());

    const tzDateFmt = new Intl.DateTimeFormat('en-CA', {
      timeZone: timeZone,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    });
    const eventTzDate = (d) => {
      const parts = tzDateFmt.formatToParts(d);
      const get = (type) => (parts.find((p) => p.type === type) || {}).value || '00';
      return get('year') + '-' + get('month') + '-' + get('day');
    };

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const weekStart = new Date(today);
    weekStart.setDate(today.getDate() - today.getDay());

    let pageStart = new Date(weekStart);
    let selected = null;
    let loading = false;
    let failed = false;

    /** Cache of local date key -> array of Date objects. */
    const slotsByDay = new Map();
    const fetchedWindows = new Set();

    const addDays = (d, n) => {
      const next = new Date(d);
      next.setDate(d.getDate() + n);
      return next;
    };

    const fetchWindow = async (start) => {
      const key = iso(start);
      if (fetchedWindows.has(key)) return;
      fetchedWindows.add(key);

      // Pad by a day so time zones never clip the visible range.
      const from = iso(addDays(start, -1));
      const to = iso(addDays(start, 15));

      const res = await fetch(
        API + '?eventTypeId=' + encodeURIComponent(eventTypeId) + '&start=' + from + '&end=' + to,
        { headers: { 'cal-api-version': '2024-09-04' } }
      );
      if (!res.ok) throw new Error('Slots request failed: ' + res.status);

      const json = await res.json();
      const data = json && json.data ? json.data : {};

      Object.keys(data).forEach((day) => {
        const list = data[day];
        if (!Array.isArray(list)) return;
        list.forEach((slot) => {
          const when = new Date(slot.start);
          if (Number.isNaN(when.getTime())) return;
          const localKey = iso(when);
          const bucket = slotsByDay.get(localKey);
          if (bucket) bucket.push(when);
          else slotsByDay.set(localKey, [when]);
        });
      });
    };

    const renderTimes = () => {
      timesEl.innerHTML = '';
      if (loading) {
        const p = document.createElement('p');
        p.className = 'booking-empty';
        p.textContent = 'Loading availability…';
        timesEl.append(p);
        return;
      }
      if (failed) {
        const p = document.createElement('p');
        p.className = 'booking-empty';
        p.innerHTML =
          'Live availability is unavailable right now. <a href="' +
          calUrl +
          '" target="_blank" rel="noopener noreferrer">Open the full calendar</a>.';
        timesEl.append(p);
        return;
      }
      if (!selected) {
        const p = document.createElement('p');
        p.className = 'booking-empty';
        p.textContent = 'No open days in this range. Try the next week.';
        timesEl.append(p);
        return;
      }

      const slots = slotsByDay.get(selected) || [];
      if (!slots.length) {
        const p = document.createElement('p');
        p.className = 'booking-empty';
        p.textContent = 'No open slots that day. Try another date.';
        timesEl.append(p);
        return;
      }

      const label = document.createElement('p');
      label.className = 'booking-times-label';
      label.textContent = dayFmt.format(new Date(selected + 'T00:00:00')) + ' · pick a time';
      timesEl.append(label);

      const list = document.createElement('div');
      list.className = 'booking-slots';
      slots
        .slice()
        .sort((a, b) => a - b)
        .forEach((slot) => {
          const date = eventTzDate(slot);
          const link = document.createElement('a');
          link.className = 'booking-slot';
          // Cal.com resolves the date in the event type's time zone.
          link.href = calUrl + '?date=' + date;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.textContent = timeFmt.format(slot);
          link.addEventListener('click', (event) => {
            // Book inside the Cal modal so we can react to a completed booking.
            event.preventDefault();
            openBooker(date);
          });
          list.append(link);
        });
      timesEl.append(list);
    };

    const render = () => {
      const start = new Date(pageStart);
      const end = addDays(start, 13);

      rangeEl.textContent = rangeFmt.format(start) + ' – ' + rangeFmt.format(end);
      prevBtn.disabled = start.getTime() <= weekStart.getTime();

      if (selected && !slotsByDay.has(selected)) selected = null;

      // Auto-select the first open day so the panel is never empty on load.
      if (!selected && !loading && !failed) {
        for (let i = 0; i < 14; i += 1) {
          const key = iso(addDays(start, i));
          if ((slotsByDay.get(key) || []).length > 0) {
            selected = key;
            break;
          }
        }
      }

      grid.innerHTML = '';

      for (let i = 0; i < 14; i += 1) {
        const date = addDays(start, i);
        const key = iso(date);
        const hasSlots = (slotsByDay.get(key) || []).length > 0;

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'booking-day';
        button.textContent = String(date.getDate());
        button.dataset.date = key;
        button.setAttribute('aria-label', dayFmt.format(date));

        if (date < today || (!hasSlots && !loading)) button.disabled = true;
        if (loading) button.classList.add('is-loading');
        if (date.getTime() === today.getTime()) button.classList.add('is-today');
        if (hasSlots) button.classList.add('has-slots');
        if (key === selected) button.classList.add('is-selected');

        button.addEventListener('click', () => {
          selected = key;
          render();
        });

        grid.append(button);
      }

      renderTimes();
    };

    const load = async () => {
      loading = true;
      failed = false;
      render();

      try {
        await fetchWindow(pageStart);
        await fetchWindow(addDays(pageStart, 7));
      } catch (error) {
        failed = true;
      } finally {
        loading = false;
        render();
      }
    };

    prevBtn.addEventListener('click', () => {
      if (pageStart.getTime() <= weekStart.getTime()) return;
      pageStart = addDays(pageStart, -7);
      selected = null;
      load();
    });

    nextBtn.addEventListener('click', () => {
      pageStart = addDays(pageStart, 7);
      selected = null;
      load();
    });

    /* Booking + confirmation state -------------------------------------- */

    const theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    let calReady = false;

    const showDone = () => {
      if (!doneEl) return;
      grid.parentElement.hidden = true;
      timesEl.hidden = true;
      if (headNav) headNav.hidden = true;
      doneEl.hidden = false;
      doneEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    const ensureCal = () => {
      if (calReady || window.Cal) {
        calReady = true;
        return;
      }
      (function (C, A, L) {
        const p = function (a, ar) {
          a.q.push(ar);
        };
        const d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            const cal = C.Cal;
            const ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement('script')).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === 'string') {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ['initNamespace', namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');

      Cal('init', { origin: 'https://app.cal.com' });
      Cal('ui', { theme: theme, hideEventTypeDetails: false });
      Cal('on', { action: 'bookingSuccessfulV2', callback: () => showDone() });
      calReady = true;
    };

    const openBooker = (date) => {
      try {
        ensureCal();
        Cal('modal', {
          calLink: calLink + (date ? '?date=' + date : ''),
          config: { layout: 'month_view', theme: theme },
        });
      } catch (error) {
        window.open(calUrl + (date ? '?date=' + date : ''), '_blank', 'noopener');
      }
    };

    // Warm the embed only when the visitor shows intent.
    root.addEventListener('pointerenter', ensureCal, { once: true });

    // Coming back from a booking (e.g. a Cal.com success redirect).
    if (new URLSearchParams(window.location.search).get('booked') === '1') {
      showDone();
      const url = new URL(window.location.href);
      url.searchParams.delete('booked');
      window.history.replaceState({}, '', url.pathname + url.search + url.hash);
    }

    load();
  })();
</script>

<style>
  .contact-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  .contact-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .contact-copy h2 {
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.25rem);
    max-width: 18ch;
  }

  .contact-direct {
    display: grid;
    gap: 1.1rem;
    margin: 0.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line);
    width: 100%;
  }

  .contact-direct div {
    display: grid;
    gap: 0.15rem;
  }

  .contact-direct dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-dim);
    letter-spacing: 0.03em;
  }

  .contact-direct dd {
    margin: 0;
    font-size: 1rem;
  }

  .contact-direct a {
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .contact-direct a:hover {
    color: var(--accent);
  }

  .contact-fine {
    color: var(--ink-dim);
    font-size: 0.875rem;
    max-width: 38ch;
  }
</style>

<style is:global>
  /* Two-week availability calendar, two rows of seven days. */
  .booking {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .booking-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 0.9rem 1.15rem;
    background: var(--panel-raised);
    border-bottom: 1px solid var(--line);
  }

  .booking-head strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .booking-head span {
    display: block;
    margin-top: 0.1rem;
    color: var(--ink-dim);
    font-size: 0.75rem;
  }

  .booking-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .booking-nav button {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel);
    color: var(--ink-soft);
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 140ms ease,
      color 140ms ease;
  }

  .booking-nav button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .booking-nav button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .booking-range {
    min-width: 8rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .booking-grid {
    padding: 0.9rem 1.15rem 0.6rem;
  }

  .booking-weekdays,
  .booking-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.3rem;
  }

  .booking-weekdays {
    margin-bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-dim);
    text-align: center;
  }

  .booking-day {
    display: grid;
    place-items: center;
    height: 2.55rem;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
    transition:
      background-color 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
  }

  .booking-day:hover:not(:disabled) {
    border-color: var(--line-strong);
    background: var(--panel-raised);
  }

  .booking-day:disabled {
    color: var(--line-strong);
    cursor: default;
  }

  .booking-day.has-slots {
    border-color: var(--line);
    background: var(--panel-raised);
  }

  .booking-day.is-loading {
    opacity: 0.45;
  }

  .booking-day.is-today {
    border-color: rgba(245, 166, 35, 0.45);
    color: var(--accent);
  }

  .booking-day.is-selected {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }

  .booking-times {
    border-top: 1px solid var(--line);
    padding: 0.75rem 1.15rem 0.85rem;
  }

  /* Elements toggled by the booking flow must beat their own display rules. */
  .booking-done[hidden],
  .booking-nav[hidden],
  .booking-times[hidden],
  .booking-grid[hidden] {
    display: none !important;
  }

  .booking-done {
    display: grid;
    gap: 0.55rem;
    justify-items: start;
    padding: 1.35rem 1.15rem 1.5rem;
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, var(--glow-amber), transparent 75%);
  }

  .booking-done-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .booking-done strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 26ch;
  }

  .booking-done-body {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
    max-width: 44ch;
  }

  .booking-done-link {
    margin-top: 0.25rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel-raised);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      color 140ms ease;
  }

  .booking-done-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .booking-empty {
    margin: 0;
    color: var(--ink-dim);
    font-size: 0.8125rem;
  }

  .booking-empty a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .booking-times-label {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .booking-slots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    max-height: 7.5rem;
    overflow-y: auto;
  }

  .booking-slot {
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--panel-raised);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background-color 140ms ease;
  }

  .booking-slot:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .booking-note {
    padding: 0.55rem 1.15rem 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--ink-dim);
    font-size: 0.75rem;
  }

  .booking-note a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .booking-note a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .booking-weekdays,
    .booking-days {
      gap: 0.25rem;
    }

    .booking-day {
      height: 2.35rem;
      font-size: 0.75rem;
    }

    .booking-range {
      min-width: 7rem;
      font-size: 0.5625rem;
    }
  }
</style>
