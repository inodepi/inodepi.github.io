---
import ProjectShell from '../components/ProjectShell.astro';
import { siteConfig } from '../data/projects';

const nodes = [
  { x: 16, y: 30, w: 190, h: 72, label: 'Dormant leads', sub: 'CRM + context', hue: '#ff7f9f' },
  { x: 240, y: 30, w: 190, h: 72, label: 'n8n workflow', sub: 'revive + route', hue: '#f5a623' },
  { x: 464, y: 30, w: 160, h: 72, label: 'LLM check-in', sub: 'Gemini drafts', hue: '#9d8cff' },
  { x: 240, y: 190, w: 190, h: 72, label: 'Gmail drafts', sub: 'human presses send', hue: '#46cfc0' },
];

const links = [
  'M206 66 C 222 66, 224 66, 240 66',
  'M430 66 C 448 66, 448 66, 464 66',
  'M336 102 C 336 148, 336 156, 336 190',
];

const ports = [
  [206, 66], [240, 66], [430, 66], [464, 66], [336, 102], [336, 190],
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: 'Dead Lead Retrieval',
    description:
      'AI-powered, human-in-the-loop automation that resurrects dormant leads: LLM-written check-in emails filed as Gmail drafts, tracked in the CRM.',
    url: 'https://inodepi.github.io/dead-lead-retrieval/',
    author: { '@type': 'Person', name: 'Christian John', url: 'https://inodepi.github.io/' },
    keywords: 'n8n, Gemini, CRM, Gmail, lead reactivation',
    isPartOf: { '@type': 'WebSite', name: 'inodepi', url: 'https://inodepi.github.io/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://inodepi.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'Dead Lead Retrieval', item: 'https://inodepi.github.io/dead-lead-retrieval/' },
    ],
  },
];

const useCases = [
  { title: 'Dormant CRM', body: 'Reopen old leads with a specific note that references the original conversation, not a blast.' },
  { title: 'Quote follow-up', body: 'Follow up on estimates that never got a yes or a no, before they go cold.' },
  { title: 'Event and webinar lists', body: 'Turn a tired attendee list into real conversations with a human approving every send.' },
  { title: 'Trial expiry', body: 'Check in before a trial quietly lapses, with the original context already in the draft.' },
];

const loop = [
  'Pull the dormant leads and their original context.',
  'An LLM drafts a short, specific check-in — never a generic blast.',
  'The email is filed as a Gmail draft for review.',
  'A booking link is added so a reply turns into a call.',
  'The CRM tracks each lead through the review lifecycle.',
];

const guardrails = [
  'AI drafts, a human approves — nothing sends itself.',
  'Anti-hallucination rules: the only link in any email is mine.',
  'Original context is passed to the model so the note is relevant.',
  'Every action is visible in the CRM, not buried in a mailbox.',
];
---

<ProjectShell
  title="Dead Lead Retrieval — inodepi"
  description="AI-powered, human-in-the-loop automation that resurrects dormant leads: LLM-written check-in emails filed as Gmail drafts, tracked in the CRM."
  kicker="n8n automation"
  name="Dead Lead Retrieval"
  tagline="Dormant leads rarely die because someone said no. They die because nobody followed up."
  badges={['Human-in-the-loop', 'Gmail drafts', 'Released']}
  canvasName="lead-revival.workflow"
  canvasTag="n8n"
  canvasNote="CRM in, drafts out. A human presses send."
  stack={['n8n', 'Gemini', 'CRM', 'Gmail']}
  links={[
    { label: 'Repository', href: 'https://github.com/inodepi/dead-lead-retrieval', external: true },
  ]}
  category="Automations · sales ops"
  ctaTitle="Wake the leads you already paid for."
  ctaBody="Drafts, context and follow-ups — with a human approving every send."
  jsonLd={jsonLd}
>
  <section class="proj-section" slot="visual">
    <svg viewBox="0 0 640 290" role="img" aria-label="Workflow: dormant leads and their context feed an n8n workflow, an LLM drafts a check-in, and the email waits as a Gmail draft.">
      <g class="links">
        {links.map((d) => <path d={d} />)}
      </g>
      <g class="ports">
        {ports.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.1" />)}
      </g>
      <g class="pulses">
        <circle class="pulse" r="3">
          <animateMotion path="M206 66 C 222 66, 224 66, 240 66" dur="3.4s" begin="-0.8s" repeatCount="indefinite" />
        </circle>
        <circle class="pulse" r="3">
          <animateMotion path="M336 102 C 336 148, 336 156, 336 190" dur="3.4s" begin="-1.8s" repeatCount="indefinite" />
        </circle>
      </g>
      <g class="nodes">
        {nodes.map((node) => (
          <g class:list={[node.label.startsWith('n8n') && 'is-core']}>
            <rect class="node" x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
            <rect x={node.x + 10} y={node.y + 14} width="4" height={node.h - 28} rx="2" fill={node.hue} />
            <text class="node-label" x={node.x + 24} y={node.y + 30}>{node.label}</text>
            <text class="node-sub" x={node.x + 24} y={node.y + 48}>{node.sub}</text>
          </g>
        ))}
      </g>
    </svg>
  </section>

  <section class="proj-section">
    <h2>Overview</h2>
    <figure class="proj-video">
      <video
        controls
        preload="metadata"
        playsinline
        poster="/videos/dead-lead-retrieval.jpg"
        width="1920"
        height="1080"
      >
        <source src="/videos/dead-lead-retrieval.mp4" type="video/mp4" />
        Your browser cannot play this film.
        <a href="/videos/dead-lead-retrieval.mp4">Download it</a>.
      </video>
      <figcaption>Narrated build overview · 1:27</figcaption>
    </figure>
  </section>

  <section class="proj-section">
    <h2>Use cases</h2>
    <div class="proj-cases">
      {useCases.map((useCase) => (
        <article class="proj-case">
          <h3>{useCase.title}</h3>
          <p>{useCase.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="proj-section">
    <h2>The loop</h2>
    <ul class="proj-list">
      {loop.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="proj-section">
    <h2>Guardrails</h2>
    <ul class="proj-list">
      {guardrails.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="proj-section">
    <h2>Stack notes</h2>
    <p>
      Built on n8n with Gemini for drafting. If your stack requires something else, the same
      architecture can be delivered on another automation platform.
    </p>
  </section>
</ProjectShell>

<style>
  .links path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .ports circle {
    fill: var(--panel);
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .pulse {
    fill: var(--accent);
    filter: drop-shadow(0 0 4px rgba(245, 166, 35, 0.8));
  }

  .nodes .is-core .node {
    stroke: rgba(245, 166, 35, 0.55);
  }

  .node {
    fill: var(--panel-raised);
    stroke: var(--line-strong);
    stroke-width: 1.1;
  }

  .node-label {
    fill: var(--ink);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
  }

  .node-sub {
    fill: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 9.5px;
  }

  .proj-video {
    margin: 1.25rem 0 0;
  }

  .proj-video video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #000;
  }

  .proj-video figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    color: var(--ink-dim);
  }

  .proj-cases {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .proj-cases {
      grid-template-columns: 1fr 1fr;
    }
  }

  .proj-case {
    padding: 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .proj-case h3 {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .proj-case p {
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .proj-list {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .proj-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .proj-list li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulses {
      display: none;
    }
  }
</style>
