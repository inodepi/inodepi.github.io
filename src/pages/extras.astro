---
import Base from '../layouts/Base.astro';
import AgentSkills from '../components/AgentSkills.astro';
import SideProjects from '../components/SideProjects.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Extras — inodepi',
  url: 'https://inodepi.github.io/extras/',
};
---

<Base
  title="Extras — inodepi"
  description="Agent skills and side projects by inodepi: packaged playbooks for Claude Code, Cursor and Codex, plus tools and experiments."
  jsonLd={jsonLd}
>
  <section class="section extras-head">
    <div class="container extras-intro">
      <p class="extras-kicker">Extras</p>
      <h1>More of me.</h1>
      <p class="section-lede">
        Packaged agent skills you can drop into Claude Code, Cursor or Codex, plus side projects
        built out of curiosity. Different problems, same habit of wiring systems together.
      </p>
    </div>
  </section>

  <AgentSkills />
  <SideProjects />
  <Contact />
  <Footer slot="footer" />
</Base>

<style>
  .extras-head {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
    border-top: 0;
  }

  .extras-intro {
    display: grid;
    gap: 1.1rem;
    max-width: 46rem;
  }

  .extras-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 0.32rem 0.7rem 0.32rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink-soft);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .extras-kicker::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .extras-intro h1 {
    font-size: clamp(2.25rem, 1.4rem + 3vw, 3.75rem);
  }
</style>
