---
import ProjectShell from '../components/ProjectShell.astro';
import VideoBeats from '../components/VideoBeats.astro';
import AutomationBreakdown from '../components/AutomationBreakdown.astro';

const nodes = [
  { x: 16, y: 20, w: 180, h: 70, label: 'CSV drop', sub: 'Drive · lead_csv', hue: '#46cfc0', core: true },
  { x: 230, y: 20, w: 190, h: 70, label: 'Jina scrape', sub: '2,500 chars · 3.5s', hue: '#9d8cff' },
  { x: 444, y: 20, w: 180, h: 70, label: 'AI enrich', sub: 'fit + first line', hue: '#f5a623' },
  { x: 444, y: 150, w: 180, h: 70, label: 'LEADS sheet', sub: 'send window · UTC', hue: '#46cfc0' },
  { x: 230, y: 150, w: 190, h: 70, label: 'Gmail send', sub: '15/day cap', hue: '#f5a623' },
  { x: 16, y: 150, w: 180, h: 70, label: 'Reply + follow-up', sub: '3 steps · +3 biz days', hue: '#ff7f9f' },
  { x: 230, y: 256, w: 190, h: 64, label: 'Discord logs', sub: 'uploads · sends · replies', hue: '#ff7f9f' },
];

const links = [
  'M196 55 C 214 55, 214 55, 230 55',
  'M420 55 C 432 55, 432 55, 444 55',
  'M534 90 C 534 112, 534 128, 534 150',
  'M444 185 C 436 185, 428 185, 420 185',
  'M230 185 C 222 185, 204 185, 196 185',
];

const errorLink = 'M325 220 C 325 238, 325 238, 325 256';

const ports = [
  [196, 55], [230, 55], [420, 55], [444, 55],
  [534, 90], [534, 150],
  [444, 185], [420, 185], [230, 185], [196, 185],
  [325, 220], [325, 256],
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: 'AI Lead Enrichment',
    description:
      'An n8n pipeline that researches each lead from its own website, then sends at most 15 cold emails a day at 09:30 in the prospect\'s timezone, with three same-thread follow-ups that stop on reply.',
    url: 'https://inodepi.github.io/lead-enrichment/',
    author: { '@type': 'Person', name: 'Christian John', url: 'https://inodepi.github.io/' },
    keywords:
      'n8n, cold email, lead enrichment, Google Sheets, Jina, OpenAI, Gmail, deliverability, follow-up automation',
    isPartOf: { '@type': 'WebSite', name: 'inodepi', url: 'https://inodepi.github.io/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://inodepi.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'AI Lead Enrichment', item: 'https://inodepi.github.io/lead-enrichment/' },
    ],
  },
];

const guardrails = [
  'Every send is researched first: the site is scraped and the model writes from that context, not a template.',
  '15 sends a day, shared across the initial and follow-up workflows, counted in UTC, at 09:30 in the prospect\u2019s own timezone; follow-ups ride the same thread three business days later.',
  'A reply marks the row Replied and stops the sequence; a bounce does the same. Changing the row\u2019s status manually skips it.',
  'Running in production on my own outreach — same 15/day cap, same reply-stopping, same thread.',
  'Model-agnostic: any OpenAI-compatible endpoint, so the model swaps without touching the workflow.',
];
---

<ProjectShell
  title="AI Lead Enrichment — inodepi"
  description="An n8n pipeline that researches each lead from its own website, then sends at most 15 cold emails a day at 09:30 in the prospect's timezone, with three same-thread follow-ups that stop on reply."
  kicker="n8n automation"
  name="AI Lead Enrichment"
  tagline="Research before you send. 15 a day. A reply ends it."
  badges={['Research-first', '15/day cap', 'Reply-aware']}
  canvasName="cold-outreach.workflow"
  canvasTag="n8n"
  canvasNote="CSV in. Researched sends out. A reply ends the sequence."
  stack={['n8n', 'Google Sheets', 'Jina AI', 'OpenAI-compatible LLM', 'Gmail', 'Discord']}
  links={[
    { label: 'Next build: Dead Lead Retrieval', href: '/dead-lead-retrieval/' },
  ]}
  category="Automations · sales ops"
  ctaTitle="Know why they'd buy before you email."
  ctaBody="Bring a list. I'll show you the research, the send window and the follow-ups before a single email leaves."
  jsonLd={jsonLd}
>
  <section class="proj-section" slot="visual">
    <svg viewBox="0 0 640 330" role="img" aria-label="Workflow: a CSV dropped in Google Drive is deduped and scraped with Jina, enriched by an AI model, and written to the LEADS sheet with a UTC send window; a capped Gmail sender then sends the email, watches replies and runs three same-thread follow-ups, with every step logged to Discord.">
      <g class="links">
        {links.map((d) => <path d={d} />)}
        <path class="errors" d={errorLink} />
      </g>
      <g class="ports">
        {ports.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.1" />)}
      </g>
      <g class="pulses">
        <circle class="pulse" r="3">
          <animateMotion path="M534 90 C 534 112, 534 128, 534 150" dur="3.4s" begin="-0.8s" repeatCount="indefinite" />
        </circle>
        <circle class="pulse" r="3">
          <animateMotion path="M444 185 C 436 185, 428 185, 420 185" dur="3.4s" begin="-1.8s" repeatCount="indefinite" />
        </circle>
        <circle class="pulse pulse--error" r="3">
          <animateMotion path={errorLink} dur="4.6s" begin="-2.4s" repeatCount="indefinite" />
        </circle>
      </g>
      <g class="nodes">
        {nodes.map((node) => (
          <g class:list={[node.core && 'is-core']}>
            <rect class="node" x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
            <rect x={node.x + 10} y={node.y + 14} width="4" height={node.h - 28} rx="2" fill={node.hue} />
            <text class="node-label" x={node.x + 24} y={node.y + 30}>{node.label}</text>
            <text class="node-sub" x={node.x + 24} y={node.y + 48}>{node.sub}</text>
          </g>
        ))}
      </g>
    </svg>
  </section>

  <section class="proj-section">
    <h2>Overview</h2>
    <VideoBeats
      src="/videos/cold-outreach.mp4"
      poster="/videos/cold-outreach.jpg"
      captions="/videos/cold-outreach.vtt"
      caption="Build overview · 0:30 · captions available"
      beats={[
        { time: '0:00', seek: 0, title: 'The blind blast', body: 'No research, no window, no follow-up.' },
        { time: '0:10', seek: 10, title: 'Research, then schedule', body: 'Scraped, enriched, queued for 09:30 local.' },
        { time: '0:22', seek: 22, title: 'Send and follow up', body: '15 a day. Three follow-ups. A reply ends it.' },
      ]}
    />
  </section>

  <section class="proj-section">
    <AutomationBreakdown
      problem="Cold lists get blasted in one sitting: no research, no send window, no follow-up. The replies that do arrive are the wrong ones, and the sending domain pays for it."
      cost={[
        { label: '200 sends a day from one inbox', value: '18% bounce' },
        { label: 'One follow-up, if anyone remembers', value: '1 touch' },
        { label: 'Manual research per lead', value: '10 min' },
      ]}
      fix="Three n8n workflows enrich each lead from its own website, send inside a 15-a-day cap at 09:30 local time, and follow up three times in the same thread until someone replies."
      fixPoints={[
        'W1 watches a Drive folder, dedupes the CSV, scrapes each site with Jina and writes the enriched row to the LEADS sheet.',
        'W2 sends at most 15 researched emails a day inside the prospect\u2019s 09:30 window, then checks for bounces and schedules the next touch.',
        'W3 watches replies, sends three follow-ups three business days apart, marks the row Replied the moment someone answers, and Completed after the third follow-up.',
      ]}
      costFootnote="My own outreach — estimated math, not a client result."
      savedTitle="Built-in Limits"
      statsFootnote="Configured in the live build — not a client case study."
      stats={[
        { value: '15/day', label: 'Outbound cap', note: 'Shared across initial sends and follow-ups.' },
        { value: '3', label: 'Follow-ups per lead', note: 'Same thread, +3 business days, reply-aware.' },
        { value: '$0', label: 'Per-seat enrichment tools', note: 'Your own n8n, Sheets and Gmail accounts.' },
      ]}
    />
  </section>

  <section class="proj-section">
    <h2>Guardrails</h2>
    <ul class="proj-list">
      {guardrails.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="proj-section">
    <h2>Stack notes</h2>
    <p>
      Built on n8n with Google Sheets as the queue, Jina for site context and any OpenAI-compatible
      model for the copy. Gmail sends and watches replies; Discord reports each stage. Swap the
      model or the mailbox without changing the architecture.
    </p>
  </section>
</ProjectShell>

<style>
  .links path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .links .errors {
    stroke-dasharray: 5 4;
    stroke: var(--ink-dim);
  }

  .ports circle {
    fill: var(--panel);
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .pulse {
    fill: var(--accent);
    filter: drop-shadow(0 0 4px rgba(245, 166, 35, 0.8));
  }

  .pulse--error {
    fill: var(--node-rose);
    filter: drop-shadow(0 0 4px rgba(255, 127, 159, 0.7));
  }

  .nodes .is-core .node {
    stroke: rgba(245, 166, 35, 0.55);
  }

  .node {
    fill: var(--panel-raised);
    stroke: var(--line-strong);
    stroke-width: 1.1;
  }

  .node-label {
    fill: var(--ink);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
  }

  .node-sub {
    fill: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 9.5px;
  }

  .proj-list {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .proj-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .proj-list li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulses {
      display: none;
    }
  }
</style>
