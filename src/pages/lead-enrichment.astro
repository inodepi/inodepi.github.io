---
import ProjectShell from '../components/ProjectShell.astro';

const nodes = [
  { x: 16, y: 20, w: 180, h: 70, label: 'Schedule poll', sub: 'every 15 minutes', hue: '#46cfc0', core: true },
  { x: 230, y: 20, w: 190, h: 70, label: 'Get leads', sub: 'Notion · not enriched', hue: '#46cfc0' },
  { x: 444, y: 20, w: 180, h: 70, label: 'AI enrich', sub: 'Gemini research + audit', hue: '#9d8cff' },
  { x: 444, y: 150, w: 180, h: 70, label: 'Normalize', sub: 'score 1–10 + draft', hue: '#ff7f9f' },
  { x: 230, y: 150, w: 190, h: 70, label: 'Notion write-back', sub: 'AI fields · Enriched', hue: '#46cfc0' },
  { x: 16, y: 150, w: 180, h: 70, label: 'Gmail draft', sub: 'never auto-sent', hue: '#f5a623' },
  { x: 230, y: 256, w: 190, h: 64, label: 'Error alerts', sub: 'row + failure detail', hue: '#ff7f9f' },
];

const links = [
  'M196 55 C 214 55, 214 55, 230 55',
  'M420 55 C 432 55, 432 55, 444 55',
  'M534 90 C 534 112, 534 128, 534 150',
  'M444 185 C 436 185, 428 185, 420 185',
  'M230 185 C 222 185, 204 185, 196 185',
];

const errorLink = 'M325 220 C 325 238, 325 238, 325 256';

const ports = [
  [196, 55], [230, 55], [420, 55], [444, 55],
  [534, 90], [534, 150],
  [444, 185], [420, 185], [230, 185], [196, 185],
  [325, 220], [325, 256],
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: 'AI Lead Enrichment',
    description:
      'An n8n and Gemini pipeline that researches each new lead, flags likely website issues, scores fit 1–10 and files a personalised outreach email as a Gmail draft for human review.',
    url: 'https://inodepi.github.io/lead-enrichment/',
    author: { '@type': 'Person', name: 'Christian John', url: 'https://inodepi.github.io/' },
    keywords: 'n8n, Gemini, Notion, Gmail, lead enrichment, lead scoring',
    isPartOf: { '@type': 'WebSite', name: 'inodepi', url: 'https://inodepi.github.io/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://inodepi.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'AI Lead Enrichment', item: 'https://inodepi.github.io/lead-enrichment/' },
    ],
  },
];

const useCases = [
  { title: 'Site audit lists', body: 'A scraped list of local businesses gets the audit you would normally do by hand, one row at a time.' },
  { title: 'Agency prospecting', body: 'Find the businesses whose site is actively costing them leads, before you spend a call finding out.' },
  { title: 'Inbound without a brief', body: 'Every form fill arrives with the research, the fit score and a draft that references something specific.' },
  { title: 'Partner and vendor research', body: 'Score fit against your own criteria instead of a generic industry guess.' },
];

const flow = [
  'A schedule trigger polls Notion every 15 minutes for rows in Site Audit Leads that are not yet enriched.',
  'Each row is fetched with its business name, website and contact details — only unenriched rows leave the query.',
  'A Gemini AI agent researches the business from the details on the row: offer, positioning, likely conversion leaks, the gap your service fills. Inferences are labelled as inferences.',
  'A Code node normalizes the model output into a 1–10 fit score, a research summary and a draft that cites the audit.',
  'AI Research, AI Score and Outreach Draft are written back to the same Notion row, which is marked Enriched so it can never be processed twice.',
  'A personalized outreach email is filed as a Gmail draft. A human reads it and presses send.',
  'A failed run triggers the shared error alert workflow, so failures surface instead of disappearing in the execution list.',
];

const guardrails = [
  'AI researches and drafts, a human presses send — nothing sends itself.',
  'The Enriched status is the once-only guard: no cursors, no dedupe tables, no duplicate drafts.',
  'The fit score is computed in code from the agent output, not invented in the email.',
  'Leads without a website still get researched; the draft leans on the row details instead of site specifics.',
  'Every write goes back to the row that started it, so Notion stays the source of truth.',
];
---

<ProjectShell
  title="AI Lead Enrichment — inodepi"
  description="An n8n and Gemini pipeline that researches each new lead, flags likely website issues, scores fit 1–10 and files a personalised outreach email as a Gmail draft for human review."
  kicker="n8n automation"
  name="AI Lead Enrichment"
  tagline="Cold lists get called without knowing why they would buy. This build does the research first."
  badges={['Human-in-the-loop', 'Scores 1–10', 'Gmail drafts']}
  canvasName="lead-enrichment.workflow"
  canvasTag="n8n"
  canvasNote="Notion in. Research, score and a draft out. Nothing sends itself."
  stack={['n8n', 'Notion', 'Gemini', 'Gmail']}
  links={[
    { label: 'Next build: Dead Lead Retrieval', href: '/dead-lead-retrieval/' },
  ]}
  category="Automations · sales ops"
  ctaTitle="Know why they'd buy before you call."
  ctaBody="Bring a cold list. I'll show you how the research, the score and the first draft arrive before anyone dials."
  jsonLd={jsonLd}
>
  <section class="proj-section" slot="visual">
    <svg viewBox="0 0 640 330" role="img" aria-label="Workflow: a schedule trigger polls Notion for unenriched leads, a Gemini agent researches each business, the score and draft are normalized and written back to the row, a Gmail draft is filed, and failures route to alerts.">
      <g class="links">
        {links.map((d) => <path d={d} />)}
        <path class="errors" d={errorLink} />
      </g>
      <g class="ports">
        {ports.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.1" />)}
      </g>
      <g class="pulses">
        <circle class="pulse" r="3">
          <animateMotion path="M534 90 C 534 112, 534 128, 534 150" dur="3.4s" begin="-0.8s" repeatCount="indefinite" />
        </circle>
        <circle class="pulse" r="3">
          <animateMotion path="M444 185 C 436 185, 428 185, 420 185" dur="3.4s" begin="-1.8s" repeatCount="indefinite" />
        </circle>
        <circle class="pulse pulse--error" r="3">
          <animateMotion path={errorLink} dur="4.6s" begin="-2.4s" repeatCount="indefinite" />
        </circle>
      </g>
      <g class="nodes">
        {nodes.map((node) => (
          <g class:list={[node.core && 'is-core']}>
            <rect class="node" x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
            <rect x={node.x + 10} y={node.y + 14} width="4" height={node.h - 28} rx="2" fill={node.hue} />
            <text class="node-label" x={node.x + 24} y={node.y + 30}>{node.label}</text>
            <text class="node-sub" x={node.x + 24} y={node.y + 48}>{node.sub}</text>
          </g>
        ))}
      </g>
    </svg>
  </section>

  <section class="proj-section">
    <h2>Overview</h2>
    <p>
      A cold list gets called without knowing why anyone on it would buy. This build reads a Notion
      Site Audit Leads database for every row that is not yet enriched, then sends each business
      through a Gemini agent that researches the company and calls out likely website issues.
    </p>
    <p>
      The agent returns a research summary, a 1–10 fit score and a personalized outreach draft. All
      three are written back to the Notion row, the row is marked Enriched, and the email waits as a
      Gmail draft — a human presses send.
    </p>
  </section>

  <section class="proj-section">
    <h2>Use cases</h2>
    <div class="proj-cases">
      {useCases.map((useCase) => (
        <article class="proj-case">
          <h3>{useCase.title}</h3>
          <p>{useCase.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="proj-section">
    <h2>The flow</h2>
    <ul class="proj-list">
      {flow.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="proj-section">
    <h2>Guardrails</h2>
    <ul class="proj-list">
      {guardrails.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="proj-section">
    <h2>Stack notes</h2>
    <p>
      Built on n8n with Notion as the queue and Gemini doing the research. If your stack requires
      something else, the same architecture can be delivered on another automation platform.
    </p>
  </section>
</ProjectShell>

<style>
  .links path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .links .errors {
    stroke-dasharray: 5 4;
    stroke: var(--ink-dim);
  }

  .ports circle {
    fill: var(--panel);
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .pulse {
    fill: var(--accent);
    filter: drop-shadow(0 0 4px rgba(245, 166, 35, 0.8));
  }

  .pulse--error {
    fill: var(--node-rose);
    filter: drop-shadow(0 0 4px rgba(255, 127, 159, 0.7));
  }

  .nodes .is-core .node {
    stroke: rgba(245, 166, 35, 0.55);
  }

  .node {
    fill: var(--panel-raised);
    stroke: var(--line-strong);
    stroke-width: 1.1;
  }

  .node-label {
    fill: var(--ink);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
  }

  .node-sub {
    fill: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 9.5px;
  }

  .proj-cases {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .proj-cases {
      grid-template-columns: 1fr 1fr;
    }
  }

  .proj-case {
    padding: 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .proj-case h3 {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .proj-case p {
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .proj-list {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .proj-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .proj-list li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulses {
      display: none;
    }
  }
</style>
