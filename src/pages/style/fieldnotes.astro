---
import '@fontsource-variable/literata';
import '@fontsource-variable/nunito-sans';
import '../../styles/reset.css';
import { siteConfig, featuredAutomationRepos, featuredSideProjects } from '../../data/projects';
import { capabilities, processSteps } from '../../data/content';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const flow = [
  { number: '01', title: 'Intake', body: 'Form, email, or webhook.' },
  { number: '02', title: 'Qualify', body: 'Rules and AI score the lead.' },
  { number: '03', title: 'Act', body: 'Reply drafted, CRM updated.' },
  { number: '04', title: 'Hand off', body: 'Owner notified in Slack.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>inodepi — style preview: Field Notes</title>
    <meta name="description" content="Style preview for inodepi: a calm, human-first automation portfolio." />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="robots" content="noindex" />
  </head>
  <body class="fn-body">
    <header class="fn-header">
      <div class="fn-container fn-header-inner">
        <a class="fn-brand" href={`${base}`}>inodepi</a>
        <nav class="fn-nav" aria-label="Primary">
          <a href="#capabilities">Practice</a>
          <a href="#work">Work</a>
          <a href="#process">Process</a>
          <a href="#contact">Contact</a>
        </nav>
        <a class="fn-cta" href="#contact">Book an audit</a>
      </div>
    </header>

    <main>
      <section class="fn-hero">
        <div class="fn-container">
          <div class="fn-hero-copy">
            <span class="fn-rule" aria-hidden="true"></span>
            <h1>Automation that leaves you with less to hold in your head.</h1>
            <p class="fn-lede">
              I build n8n systems that quietly carry work between your tools, so your team can
              think about the work instead of the handoffs.
            </p>
            <div class="fn-actions">
              <a class="fn-btn" href="#contact">Book a systems audit</a>
              <a class="fn-textlink" href="#process">See how it's built</a>
            </div>
          </div>

          <ol class="fn-flow" aria-label="Sample workflow: lead intake through handoff">
            {flow.map((step) => (
              <li>
                <span class="fn-flow-number">{step.number}</span>
                <h2>{step.title}</h2>
                <p>{step.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="fn-section" id="capabilities">
        <div class="fn-container">
          <div class="fn-head">
            <div>
              <h2>Where the systems help</h2>
              <p class="fn-lede-sm">
                Engagements are scoped by system, not by task. Every build starts with the place
                work gets stuck.
              </p>
            </div>
            <aside class="fn-note">Six areas, usually combined.</aside>          </div>

          <ul class="fn-caps">
            {capabilities.map((cap) => (
              <li>
                <h3>{cap.title}</h3>
                <p>{cap.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="fn-section" id="work">
        <div class="fn-container">
          <div class="fn-head">
            <div>
              <h2>Selected automation work</h2>
              <p class="fn-lede-sm">
                A sample of systems built end to end. Each entry links to its repository.
              </p>
            </div>
            <aside class="fn-note">A few systems, not a full archive.</aside>
          </div>

          <ol class="fn-builds">
            {featuredAutomationRepos.map((repo) => (
              <li>
                <h3>{repo.title}</h3>
                <p class="fn-problem">{repo.problem}</p>
                <p class="fn-summary">{repo.summary}</p>
                <p class="fn-meta">
                  <span>{repo.stack.join(', ')}</span>
                  <a href={repo.repoUrl}>View repository</a>
                </p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="fn-section" id="side-projects">
        <div class="fn-container">
          <div class="fn-head">
            <div>
              <h2>Smaller experiments</h2>
              <p class="fn-lede-sm">Tools and side projects outside client work.</p>
            </div>
            <aside class="fn-note">Tools, experiments, and small utilities.</aside>
          </div>

          <ul class="fn-side">
            {featuredSideProjects.map((project) => (
              <li>
                <div>
                  <h3>{project.title}</h3>
                  <p>{project.summary}</p>
                </div>
                <div class="fn-side-meta">
                  <span>{project.stack.join(', ')}</span>
                  <a href={project.repoUrl}>Open project</a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="fn-section fn-section--tint" id="process">
        <div class="fn-container">
          <div class="fn-head">
            <div>
              <h2>A quiet, three-step engagement</h2>
              <p class="fn-lede-sm">Each step ends with something you can read, review, or run.</p>
            </div>
            <aside class="fn-note">No discovery theatre.</aside>
          </div>

          <ol class="fn-steps">
            {processSteps.map((step) => (
              <li>
                <span class="fn-step-number">{step.number}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))}
          </ol>

          <p class="fn-process-note">
            Scope and price are agreed before the build starts. If the audit shows automation is
            not worth it, I will say so.
          </p>
        </div>
      </section>

      <section class="fn-section" id="contact">
        <div class="fn-container">
          <div class="fn-head">
            <div>
              <h2>Tell me about the work that keeps slipping.</h2>
              <p class="fn-lede-sm">
                Describe the process and the tools involved. I will reply with an honest read on
                whether an n8n system can carry it.
              </p>
            </div>
            <aside class="fn-note">{siteConfig.responseTime}.</aside>
          </div>

          <div class="fn-contact">
            <form class="fn-form" action={siteConfig.formAction} method="post">
              <div class="fn-field-row">
                <label class="fn-field">
                  <span>Name</span>
                  <input type="text" name="name" autocomplete="name" required placeholder="Your name" />
                </label>
                <label class="fn-field">
                  <span>Email</span>
                  <input type="email" name="email" autocomplete="email" required placeholder="you@company.com" />
                </label>
              </div>

              <label class="fn-field">
                <span>Company (optional)</span>
                <input type="text" name="company" autocomplete="organization" placeholder="Company or team" />
              </label>

              <label class="fn-field">
                <span>What are you trying to automate?</span>
                <textarea name="automation" rows="4" required placeholder="The process, the tools it touches, and what breaks today."></textarea>
              </label>

              <button class="fn-btn" type="submit">Send inquiry</button>
              <p class="fn-fine">Your details are used only to reply to this inquiry.</p>
            </form>

            <dl class="fn-direct">
              <div>
                <dt>Email</dt>
                <dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd>
              </div>
              <div>
                <dt>Intro call</dt>
                <dd><a href={siteConfig.calendarUrl}>Book a 20-minute call</a></dd>
              </div>
              <div>
                <dt>Elsewhere</dt>
                <dd><a href={siteConfig.githubUrl}>GitHub</a> · <a href={siteConfig.linkedinUrl}>LinkedIn</a></dd>
              </div>
            </dl>
          </div>
        </div>
      </section>
    </main>

    <footer class="fn-footer">
      <div class="fn-container">
        <div class="fn-footer-top">
          <div>
            <a class="fn-brand fn-brand--light" href={`${base}`}>inodepi</a>
            <p>n8n automation architect</p>
          </div>
          <nav aria-label="Footer">
            <a href="#work">Work</a>
            <a href="#process">Process</a>
            <a href="#contact">Contact</a>
            <a href={siteConfig.githubUrl}>GitHub</a>
            <a href={`${base}style/`}>All styles</a>
          </nav>
        </div>
        <p class="fn-footer-base">© {year} inodepi · independent automation practice</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .fn-body {
    background: #edefea;
    color: #1f2a24;
    font-family: 'Nunito Sans Variable', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.65;
  }

  .fn-body h1,
  .fn-body h2,
  .fn-body h3 {
    font-family: 'Literata Variable', Georgia, serif;
    font-weight: 550;
    letter-spacing: -0.015em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .fn-body p {
    text-wrap: pretty;
  }

  .fn-body ::selection {
    background: #1f2a24;
    color: #f2f3ed;
  }

  .fn-container {
    width: min(1000px, 100% - 2.5rem);
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .fn-container {
      width: min(1000px, 100% - 5rem);
    }
  }

  /* Header */
  .fn-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(237, 239, 234, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #cdd4cb;
  }

  .fn-header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.5rem;
  }

  .fn-brand {
    font-family: 'Literata Variable', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .fn-nav {
    display: none;
    gap: 1.6rem;
    margin-left: auto;
    font-size: 0.9375rem;
    color: #4c5a51;
  }

  .fn-nav a {
    text-decoration: none;
  }

  .fn-nav a:hover {
    color: #1f2a24;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .fn-cta {
    margin-left: auto;
    padding: 0.5rem 1rem;
    border: 1px solid #1f2a24;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 650;
    text-decoration: none;
  }

  .fn-cta:hover {
    background: #1f2a24;
    color: #f2f3ed;
  }

  @media (min-width: 820px) {
    .fn-nav {
      display: flex;
    }

    .fn-cta {
      margin-left: 0;
    }
  }

  /* Hero */
  .fn-hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .fn-hero-copy {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
    display: grid;
    justify-items: center;
  }

  .fn-rule {
    width: 3rem;
    height: 2px;
    background: #8a5e14;
    margin-bottom: 1.5rem;
  }

  .fn-hero h1 {
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.1rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    max-width: 19ch;
  }

  .fn-lede {
    max-width: 48ch;
    margin-top: 1.25rem;
    color: #4c5a51;
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .fn-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.9rem 1.5rem;
    margin-top: 1.9rem;
  }

  .fn-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.7rem 1.4rem;
    border: 1px solid #1f2a24;
    border-radius: 999px;
    background: #1f2a24;
    color: #f2f3ed !important;
    font-family: 'Nunito Sans Variable', system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .fn-btn:hover {
    background: #33463a;
    border-color: #33463a;
  }

  .fn-textlink {
    font-size: 0.9375rem;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: #a9b4aa;
  }

  .fn-textlink:hover {
    color: #8a5e14;
  }

  /* Workflow flow */
  .fn-flow {
    display: grid;
    gap: 1rem;
    max-width: 60rem;
    margin: clamp(2.5rem, 5vw, 3.75rem) auto 0;
  }

  @media (min-width: 760px) {
    .fn-flow {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
    }
  }

  .fn-flow li {
    position: relative;
    padding: 1.1rem 1rem 1.15rem;
    background: #f8f9f5;
    border: 1px solid #cdd4cb;
    border-radius: 12px;
    box-shadow: 0 8px 20px -18px rgba(31, 42, 36, 0.5);
  }

  @media (min-width: 760px) {
    .fn-flow li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 1.55rem;
      right: -0.8rem;
      width: 0.8rem;
      border-top: 1px dashed #b48a3c;
    }
  }

  .fn-flow-number {
    font-family: 'Literata Variable', Georgia, serif;
    font-size: 0.75rem;
    color: #8a5e14;
  }

  .fn-flow h2 {
    margin-top: 0.35rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .fn-flow p {
    margin-top: 0.25rem;
    color: #4c5a51;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  /* Sections */
  .fn-section {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    border-top: 1px solid #cdd4cb;
  }

  .fn-section--tint {
    background: #e5e9e1;
  }

  .fn-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1000px) {
    .fn-head {
      grid-template-columns: minmax(0, 1fr) 13rem;
      gap: 3rem;
      align-items: start;
    }
  }

  .fn-head h2 {
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.7rem);
  }

  .fn-lede-sm {
    margin-top: 0.75rem;
    max-width: 46ch;
    color: #4c5a51;
    font-size: 1rem;
  }

  .fn-note {
    color: #6a776d;
    font-family: 'Literata Variable', Georgia, serif;
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.5;
    padding-left: 0.9rem;
    border-left: 2px solid #b48a3c;
  }

  /* Capabilities */
  .fn-caps {
    display: grid;
    gap: 1.75rem 3rem;
  }

  @media (min-width: 720px) {
    .fn-caps {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fn-caps li {
    padding-left: 1.15rem;
    border-left: 1px solid #c3ccc2;
  }

  .fn-caps h3 {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .fn-caps p {
    margin-top: 0.3rem;
    color: #4c5a51;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Builds */
  .fn-builds {
    display: grid;
    gap: 1.25rem;
  }

  .fn-builds li {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: #f8f9f5;
    border: 1px solid #cdd4cb;
    border-radius: 14px;
  }

  .fn-builds h3 {
    font-size: 1.35rem;
    font-weight: 600;
  }

  .fn-problem {
    margin-top: 0.4rem;
    padding-left: 0.75rem;
    border-left: 2px solid #b48a3c;
    color: #38463d;
    font-family: 'Literata Variable', Georgia, serif;
    font-style: italic;
    font-size: 0.9688rem;
    line-height: 1.5;
  }

  .fn-summary {
    margin-top: 0.65rem;
    max-width: 68ch;
    color: #4c5a51;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .fn-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.25rem;
    margin-top: 0.9rem;
    font-size: 0.8125rem;
    color: #6a776d;
  }

  .fn-meta a {
    color: #8a5e14;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Side projects */
  .fn-side li {
    display: grid;
    gap: 0.5rem;
    padding: 1.1rem 0;
    border-top: 1px solid #cdd4cb;
  }

  .fn-side li:last-child {
    border-bottom: 1px solid #cdd4cb;
  }

  @media (min-width: 760px) {
    .fn-side li {
      grid-template-columns: minmax(0, 1fr) 12rem;
      gap: 2rem;
      align-items: baseline;
    }
  }

  .fn-side h3 {
    font-size: 1.2rem;
    font-weight: 600;
  }

  .fn-side p {
    margin-top: 0.25rem;
    max-width: 60ch;
    color: #4c5a51;
    font-size: 0.9375rem;
  }

  .fn-side-meta {
    display: grid;
    gap: 0.25rem;
    font-size: 0.8125rem;
    color: #6a776d;
  }

  .fn-side-meta a {
    color: #8a5e14;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Process */
  .fn-steps {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .fn-steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .fn-steps li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .fn-step-number {
    font-family: 'Literata Variable', Georgia, serif;
    font-size: 2.25rem;
    line-height: 1;
    color: #8a5e14;
  }

  .fn-steps h3 {
    font-size: 1.3rem;
    font-weight: 600;
  }

  .fn-steps p {
    margin-top: 0.35rem;
    color: #4c5a51;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .fn-process-note {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #c3ccc2;
    max-width: 54ch;
    color: #5a685e;
    font-size: 0.875rem;
  }

  /* Contact */
  .fn-contact {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .fn-contact {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: 3.5rem;
      align-items: start;
    }
  }

  .fn-form {
    display: grid;
    gap: 1.2rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: #f8f9f5;
    border: 1px solid #cdd4cb;
    border-radius: 16px;
  }

  .fn-field-row {
    display: grid;
    gap: 1.2rem;
  }

  @media (min-width: 560px) {
    .fn-field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .fn-field {
    display: grid;
    gap: 0.3rem;
  }

  .fn-field > span {
    font-size: 0.8125rem;
    font-weight: 650;
    color: #38463d;
  }

  .fn-form input,
  .fn-form textarea {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid #c3ccc2;
    border-radius: 8px;
    background: #ffffff;
    color: #1f2a24;
    font-size: 0.9688rem;
  }

  .fn-form input::placeholder,
  .fn-form textarea::placeholder {
    color: #8c988f;
  }

  .fn-form input:focus-visible,
  .fn-form textarea:focus-visible {
    outline: 2px solid #b48a3c;
    outline-offset: 1px;
    border-color: transparent;
  }

  .fn-form textarea {
    resize: vertical;
    min-height: 6rem;
  }

  .fn-form .fn-btn {
    justify-self: start;
    min-width: 10rem;
    margin-top: 0.25rem;
  }

  .fn-fine {
    color: #6a776d;
    font-size: 0.8125rem;
  }

  .fn-direct {
    display: grid;
    gap: 1rem;
    padding-top: 0.25rem;
  }

  .fn-direct > div {
    display: grid;
    gap: 0.1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid #cdd4cb;
  }

  .fn-direct dt {
    font-family: 'Literata Variable', Georgia, serif;
    font-size: 0.8125rem;
    color: #6a776d;
  }

  .fn-direct dd {
    font-size: 0.9375rem;
  }

  .fn-direct a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Footer */
  .fn-footer {
    padding: 3rem 0 2rem;
    background: #1f2a24;
    color: #e6e9e2;
  }

  .fn-footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .fn-brand--light {
    color: #f2f3ed;
    font-size: 1.5rem;
  }

  .fn-footer-top p {
    margin-top: 0.25rem;
    color: #a9b4aa;
    font-size: 0.875rem;
  }

  .fn-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.9375rem;
    color: #cdd4cb;
  }

  .fn-footer nav a {
    text-decoration: none;
  }

  .fn-footer nav a:hover {
    color: #f2f3ed;
  }

  .fn-footer-base {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #3a4a3f;
    color: #93a198;
    font-size: 0.8125rem;
  }
</style>
