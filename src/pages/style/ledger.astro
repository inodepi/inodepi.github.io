---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/public-sans';
import '../../styles/reset.css';
import { siteConfig, featuredAutomationRepos, featuredSideProjects } from '../../data/projects';
import { capabilities, processSteps } from '../../data/content';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const flow = [
  { number: '01', stage: 'Trigger', body: 'A new lead arrives by form, email, or webhook.' },
  { number: '02', stage: 'Validate', body: 'Required fields are checked and the record is deduped against the CRM.' },
  { number: '03', stage: 'Decide', body: 'An AI agent scores fit, extracts context, and drafts the first reply.' },
  { number: '04', stage: 'Record', body: 'The lead is written to the CRM with its full history attached.' },
  { number: '05', stage: 'Notify', body: 'The account owner gets a Slack message with a short summary.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>inodepi — style preview: Operations Ledger</title>
    <meta name="description" content="Style preview for inodepi: an editorial, print-inspired automation portfolio." />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="robots" content="noindex" />
  </head>
  <body class="lg-body">
    <header class="lg-header">
      <div class="lg-container lg-header-inner">
        <a class="lg-brand" href={`${base}`}>inodepi</a>
        <nav class="lg-nav" aria-label="Primary">
          <a href="#capabilities">Practice</a>
          <a href="#work">Work</a>
          <a href="#process">Process</a>
          <a href="#contact">Contact</a>
        </nav>
        <a class="lg-header-cta" href="#contact">Request an audit</a>
      </div>
    </header>

    <main>
      <section class="lg-hero">
        <div class="lg-container">
          <p class="lg-dateline">Independent automation practice · n8n architecture</p>

          <div class="lg-hero-grid">
            <div>
              <h1>The work between your tools is still done by people.</h1>
              <p class="lg-lede">
                I design n8n systems that move work across your stack — intake, enrichment, AI
                decisions, CRM writes — so nobody has to relay data by hand.
              </p>
              <div class="lg-actions">
                <a class="lg-btn" href="#contact">Request a systems audit</a>
                <a class="lg-textlink" href="#work">Read selected work</a>
              </div>
            </div>

            <aside class="lg-dispatch" aria-label="Practice summary">
              <p class="lg-dispatch-head">The short version</p>
              <dl>
                <div>
                  <dt>Practice</dt>
                  <dd>n8n automation architecture</dd>
                </div>
                <div>
                  <dt>Engagements</dt>
                  <dd>Audits, builds, handover</dd>
                </div>
                <div>
                  <dt>Availability</dt>
                  <dd>Taking on new work</dd>
                </div>
                <div>
                  <dt>Response</dt>
                  <dd>{siteConfig.responseTime}</dd>
                </div>
              </dl>
            </aside>
          </div>
        </div>
      </section>

      <section class="lg-band" aria-labelledby="lg-reference-title">
        <div class="lg-container">
          <div class="lg-band-head">
            <h2 id="lg-reference-title">Reference system: lead intake and qualification</h2>
            <p>A representative graph, not a client diagram.</p>
          </div>

          <ol class="lg-flow">
            {flow.map((row) => (
              <li>
                <span class="lg-flow-number">{row.number}</span>
                <span class="lg-flow-stage">{row.stage}</span>
                <span class="lg-flow-body">{row.body}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="lg-section" id="capabilities">
        <div class="lg-container">
          <div class="lg-section-head">
            <h2>What the practice builds</h2>
            <p>
              Engagements are scoped by system, not by task. Most builds combine several of these.
            </p>
          </div>

          <ul class="lg-caps">
            {capabilities.map((cap) => (
              <li class="lg-cap">
                <h3>{cap.title}</h3>
                <p>{cap.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="lg-section" id="work">
        <div class="lg-container">
          <div class="lg-section-head">
            <h2>Selected automation work</h2>
            <p>
              A sample of systems built end to end: triggers, sub-workflows, integrations,
              validation, and failure paths. Each entry links to its repository.
            </p>
          </div>

          <ol class="lg-list">
            {featuredAutomationRepos.map((repo, index) => (
              <li class="lg-entry">
                <span class="lg-entry-index">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{repo.title}</h3>
                  <p class="lg-entry-problem">{repo.problem}</p>
                  <p class="lg-entry-summary">{repo.summary}</p>
                  <p class="lg-entry-meta">
                    <span>{repo.stack.join(' · ')}</span>
                    <a href={repo.repoUrl}>View repository</a>
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="lg-section" id="side-projects">
        <div class="lg-container">
          <div class="lg-section-head">
            <h2>Other things built</h2>
            <p>Tools and experiments outside client work. Same habit, different problems.</p>
          </div>

          <ul class="lg-side">
            {featuredSideProjects.map((project) => (
              <li>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <p class="lg-side-stack">{project.stack.join(', ')}</p>
                <a href={project.repoUrl}>View project</a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="lg-night" id="process">
        <div class="lg-container">
          <div class="lg-night-head">
            <h2>How an engagement runs</h2>
            <p>Three steps, each ending in something you can read, review, or run.</p>
          </div>

          <ol class="lg-steps">
            {processSteps.map((step) => (
              <li>
                <span class="lg-step-number">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))}
          </ol>

          <p class="lg-night-note">
            Scope and price are agreed before the build starts. If the audit shows automation is
            not worth it, I will say so.
          </p>
        </div>
      </section>

      <section class="lg-section" id="contact">
        <div class="lg-container lg-contact">
          <div>
            <h2>Start with the process that hurts.</h2>
            <p class="lg-contact-lede">
              Describe the work, the tools involved, and where the handoffs break. I will reply
              with an honest read on whether an n8n system can carry it.
            </p>

            <dl class="lg-direct">
              <div>
                <dt>Email</dt>
                <dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd>
              </div>
              <div>
                <dt>Intro call</dt>
                <dd><a href={siteConfig.calendarUrl}>Book a 20-minute call</a></dd>
              </div>
              <div>
                <dt>Elsewhere</dt>
                <dd><a href={siteConfig.githubUrl}>GitHub</a> · <a href={siteConfig.linkedinUrl}>LinkedIn</a></dd>
              </div>
            </dl>
          </div>

          <form class="lg-form" action={siteConfig.formAction} method="post">
            <div class="lg-field-row">
              <label class="lg-field">
                <span>Name</span>
                <input type="text" name="name" autocomplete="name" required placeholder="Your name" />
              </label>
              <label class="lg-field">
                <span>Email</span>
                <input type="email" name="email" autocomplete="email" required placeholder="you@company.com" />
              </label>
            </div>

            <label class="lg-field">
              <span>Company <em>optional</em></span>
              <input type="text" name="company" autocomplete="organization" placeholder="Company or team" />
            </label>

            <label class="lg-field">
              <span>What are you trying to automate?</span>
              <textarea name="automation" rows="4" required placeholder="The process, the tools it touches, and what breaks today."></textarea>
            </label>

            <button class="lg-btn" type="submit">Send inquiry</button>
            <p class="lg-fine">Your details are used only to reply to this inquiry.</p>
          </form>
        </div>
      </section>
    </main>

    <footer class="lg-footer">
      <div class="lg-container">
        <div class="lg-footer-top">
          <a class="lg-brand" href={`${base}`}>inodepi</a>
          <nav aria-label="Footer">
            <a href="#work">Work</a>
            <a href="#process">Process</a>
            <a href="#contact">Contact</a>
            <a href={siteConfig.githubUrl}>GitHub</a>
            <a href={`${base}style/`}>All styles</a>
          </nav>
        </div>
        <p class="lg-footer-base">© {year} inodepi · independent automation practice</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .lg-body {
    background: #faf7f0;
    color: #1a1712;
    font-family: 'Public Sans Variable', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.65;
  }

  .lg-body h1,
  .lg-body h2,
  .lg-body h3,
  .lg-body h4 {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .lg-body p {
    text-wrap: pretty;
  }

  .lg-body ::selection {
    background: #7a2e2a;
    color: #faf7f0;
  }

  .lg-container {
    width: min(1120px, 100% - 2.5rem);
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .lg-container {
      width: min(1120px, 100% - 5rem);
    }
  }

  /* Header */
  .lg-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(250, 247, 240, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #ddd3c0;
  }

  .lg-header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.5rem;
  }

  .lg-brand {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .lg-nav {
    display: none;
    gap: 1.75rem;
    margin-left: auto;
    font-size: 0.9375rem;
  }

  .lg-nav a {
    text-decoration: none;
    color: #4a4338;
  }

  .lg-nav a:hover {
    color: #7a2e2a;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .lg-header-cta {
    margin-left: auto;
    font-size: 0.875rem;
    font-weight: 600;
    color: #7a2e2a;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 820px) {
    .lg-nav {
      display: flex;
    }

    .lg-header-cta {
      margin-left: 0;
    }
  }

  /* Hero */
  .lg-hero {
    padding: clamp(2.75rem, 6vw, 4.5rem) 0 clamp(2.5rem, 5vw, 4rem);
  }

  .lg-dateline {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #ddd3c0;
    color: #6b6355;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
  }

  .lg-hero-grid {
    display: grid;
    gap: 2.75rem;
    padding-top: clamp(2rem, 4vw, 3rem);
    align-items: end;
  }

  @media (min-width: 960px) {
    .lg-hero-grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.75fr);
      gap: 4rem;
    }
  }

  .lg-hero h1 {
    font-size: clamp(2.6rem, 1.5rem + 4.2vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 17ch;
  }

  .lg-lede {
    max-width: 46ch;
    margin-top: 1.5rem;
    color: #4a4338;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .lg-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  .lg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.7rem 1.4rem;
    border: 1px solid #7a2e2a;
    border-radius: 2px;
    background: #7a2e2a;
    color: #faf7f0 !important;
    font-family: 'Public Sans Variable', system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .lg-btn:hover {
    background: #632421;
  }

  .lg-textlink {
    color: #1a1712;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .lg-textlink:hover {
    color: #7a2e2a;
  }

  /* Dispatch panel */
  .lg-dispatch {
    border: 1px solid #ddd3c0;
    background: #fdfaf3;
  }

  .lg-dispatch-head {
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid #ddd3c0;
    font-family: 'Fraunces Variable', Georgia, serif;
    font-style: italic;
    font-size: 1.0625rem;
  }

  .lg-dispatch dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid #eee6d6;
  }

  .lg-dispatch dl > div:first-child {
    border-top: 0;
  }

  .lg-dispatch dt {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-style: italic;
    font-size: 0.875rem;
    color: #6b6355;
  }

  .lg-dispatch dd {
    font-size: 0.875rem;
    text-align: right;
  }

  /* Reference band */
  .lg-band {
    padding: 2.75rem 0 2.5rem;
    background: #f2ecdd;
    border-block: 1px solid #ddd3c0;
  }

  .lg-band-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .lg-band-head h2 {
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.75rem);
    font-style: italic;
    font-weight: 550;
  }

  .lg-band-head p {
    color: #6b6355;
    font-size: 0.8125rem;
  }

  .lg-flow {
    margin-top: 1.75rem;
  }

  .lg-flow li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 0.9rem 0;
    border-top: 1px dotted #c3b7a0;
    font-size: 0.9688rem;
  }

  .lg-flow li:last-child {
    border-bottom: 1px dotted #c3b7a0;
  }

  .lg-flow-number {
    grid-row: span 2;
    font-family: 'Fraunces Variable', Georgia, serif;
    color: #7a2e2a;
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .lg-flow-stage {
    font-weight: 650;
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
  }

  .lg-flow-body {
    color: #554d40;
  }

  @media (min-width: 760px) {
    .lg-flow li {
      grid-template-columns: 2.5rem 9.5rem minmax(0, 1fr);
      align-items: baseline;
    }

    .lg-flow-number {
      grid-row: auto;
    }

    .lg-flow-body {
      font-size: 0.9375rem;
    }
  }

  /* Sections */
  .lg-section {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    border-top: 1px solid #ddd3c0;
  }

  .lg-section-head {
    max-width: 44rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .lg-section-head h2,
  .lg-contact h2 {
    font-size: clamp(1.9rem, 1.25rem + 2.1vw, 2.9rem);
  }

  .lg-section-head p {
    margin-top: 0.85rem;
    max-width: 56ch;
    color: #6b6355;
  }

  /* Capabilities */
  .lg-caps {
    display: grid;
    gap: 1.75rem 2.5rem;
  }

  @media (min-width: 640px) {
    .lg-caps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 960px) {
    .lg-caps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .lg-cap {
    padding-top: 1.1rem;
    border-top: 1px solid #ddd3c0;
  }

  .lg-cap h3 {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .lg-cap p {
    margin-top: 0.5rem;
    color: #6b6355;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Featured work */
  .lg-list {
    border-top: 1px solid #ddd3c0;
  }

  .lg-entry {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    padding: 2.25rem 0;
    border-bottom: 1px solid #ddd3c0;
  }

  @media (min-width: 700px) {
    .lg-entry {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: 1rem 2rem;
      padding: 2.75rem 0;
    }
  }

  .lg-entry-index {
    font-family: 'Fraunces Variable', Georgia, serif;
    color: #7a2e2a;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  @media (min-width: 700px) {
    .lg-entry-index {
      font-size: 2.25rem;
    }
  }

  .lg-entry h3 {
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  }

  .lg-entry-problem {
    margin-top: 0.5rem;
    font-family: 'Fraunces Variable', Georgia, serif;
    font-style: italic;
    font-size: 1.0625rem;
    color: #4a4338;
  }

  .lg-entry-summary {
    margin-top: 0.65rem;
    max-width: 64ch;
    color: #6b6355;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .lg-entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
    color: #6b6355;
    font-size: 0.8125rem;
  }

  .lg-entry-meta a {
    color: #7a2e2a;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Side projects */
  .lg-side {
    display: grid;
    gap: 0;
  }

  @media (min-width: 760px) {
    .lg-side {
      grid-template-columns: 1fr 1fr;
      column-gap: 3.5rem;
    }
  }

  .lg-side li {
    padding: 1.4rem 0;
    border-top: 1px solid #ddd3c0;
  }

  .lg-side h3 {
    font-size: 1.3rem;
    font-weight: 600;
  }

  .lg-side p {
    margin-top: 0.35rem;
    color: #6b6355;
    font-size: 0.9375rem;
    max-width: 52ch;
  }

  .lg-side a {
    display: inline-block;
    margin-top: 0.5rem;
    color: #7a2e2a;
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lg-side-stack {
    margin-top: 0.4rem;
    color: #8a8172;
    font-size: 0.75rem;
  }

  /* Dark process band */
  .lg-night {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    background: #1a1712;
    color: #f2ecdd;
  }

  .lg-night-head {
    max-width: 42rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .lg-night-head h2 {
    font-size: clamp(1.9rem, 1.25rem + 2.1vw, 2.9rem);
    color: #f7f1e3;
  }

  .lg-night-head p {
    margin-top: 0.85rem;
    color: #bdb2a1;
    max-width: 50ch;
  }

  .lg-steps {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .lg-steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .lg-steps li {
    padding-top: 1.5rem;
    border-top: 1px solid #4a4033;
  }

  .lg-step-number {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: 3rem;
    line-height: 1;
    color: #e0a58e;
  }

  .lg-steps h3 {
    margin-top: 0.85rem;
    font-size: 1.5rem;
    color: #f7f1e3;
  }

  .lg-steps p {
    margin-top: 0.6rem;
    color: #bdb2a1;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .lg-night-note {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #4a4033;
    max-width: 60ch;
    color: #a99e8d;
    font-family: 'Fraunces Variable', Georgia, serif;
    font-style: italic;
    font-size: 0.9375rem;
  }

  /* Contact */
  .lg-contact {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .lg-contact {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 5rem;
      align-items: start;
    }
  }

  .lg-contact-lede {
    margin-top: 1rem;
    max-width: 42ch;
    color: #6b6355;
  }

  .lg-direct {
    margin-top: 2rem;
    border-top: 1px solid #ddd3c0;
  }

  .lg-direct > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid #ddd3c0;
  }

  .lg-direct dt {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-style: italic;
    color: #6b6355;
    font-size: 0.9375rem;
  }

  .lg-direct dd {
    font-size: 0.9375rem;
  }

  .lg-direct a {
    text-decoration: underline;
    text-underline-offset: 3px;
