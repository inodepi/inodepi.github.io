---
import '@fontsource-variable/manrope';
import '@fontsource/caveat/400.css';
import '@fontsource/caveat/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../../styles/reset.css';
import '../../styles/interactions.css';
import { siteConfig, featuredAutomationRepos, featuredSideProjects } from '../../data/projects';
import { capabilities, processSteps } from '../../data/content';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const icons = {
  systems:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="2.2"/><circle cx="19" cy="12" r="2.2"/><circle cx="5" cy="18" r="2.2"/><path d="M7.2 6h4.3a3 3 0 0 1 3 3v.2M7.2 18h4.3a3 3 0 0 0 3-3v-.2"/><path d="M14.5 12h2.3"/></svg>',
  integrations:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7V3.5M15 7V3.5"/><rect x="6" y="7" width="12" height="6.5" rx="2"/><path d="M12 13.5V17a4 4 0 0 0 4 4h1"/></svg>',
  ai: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 3.5l1.7 4.9 4.9 1.7-4.9 1.7L11 16.7 9.3 11.8 4.4 10.1l4.9-1.7L11 3.5Z"/><path d="M18.3 15.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2Z"/></svg>',
  data: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5.8" rx="7" ry="2.8"/><path d="M5 5.8v6c0 1.6 3.1 2.9 7 2.9s7-1.3 7-2.9v-6"/><path d="M5 11.8v6c0 1.6 3.1 2.9 7 2.9s7-1.3 7-2.9v-6"/></svg>',
  crm: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3.8 19.5a5.4 5.4 0 0 1 10.4 0"/><path d="M16.5 8H21M18.6 5.9 20.7 8l-2.1 2.1"/></svg>',
  reliability:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 2.8v5.4c0 4.4-3 7.4-7 8.8-4-1.4-7-4.4-7-8.8V5.8L12 3Z"/><path d="M9 11.8l2 2 4-4"/></svg>',
  bolt: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2.5 5 13.5h5.5L11 21.5l8-11h-5.5L13 2.5Z"/></svg>',
  funnel:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16l-6.2 7.2V20l-3.6-2v-5.8L4 5Z"/></svg>',
  chat: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.7 7.1L4 20.5l1.4-5.2A8 8 0 1 1 21 12Z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/></svg>',
  play: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5-11-6.5Z"/></svg>',
  search:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>',
  layout:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="8.5" y="13.5" width="7" height="7" rx="1.5"/><path d="M7 10.5v3h10v-3"/></svg>',
  deploy:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15.5c4-2 6-5.5 6-9.5-4 0-7.5 2-9.5 6"/><path d="M8.5 12 6 9.5 3.5 10l2 3.5"/><path d="M12 15.5 14.5 18l-.5 2.5L10.5 18"/><circle cx="14" cy="10" r="1.4"/></svg>',
};

const capMeta = [
  { category: 'systems', hue: '#b45309', tag: 'Orchestration', icon: icons.systems },
  { category: 'integrations', hue: '#2563eb', tag: 'Integration', icon: icons.integrations },
  { category: 'ai', hue: '#7c3aed', tag: 'AI step', icon: icons.ai },
  { category: 'data', hue: '#0f766e', tag: 'Data', icon: icons.data },
  { category: 'integrations', hue: '#d23a60', tag: 'CRM', icon: icons.crm },
  { category: 'systems', hue: '#475569', tag: 'Reliability', icon: icons.reliability },
];

const filters = [
  ['all', 'All nodes'],
  ['systems', 'Systems'],
  ['integrations', 'Integrations'],
  ['ai', 'AI'],
  ['data', 'Data'],
];

const heroNodes = [
  { id: 'webhook', label: 'Webhook', sub: 'Receive lead', icon: icons.bolt, hue: '#d97706', left: 3.75, top: 7.14 },
  { id: 'filter', label: 'Filter', sub: 'Valid + scored', icon: icons.funnel, hue: '#0f766e', left: 64.06, top: 7.14 },
  { id: 'agent', label: 'AI Agent', sub: 'Classify + draft', icon: icons.ai, hue: '#7c3aed', left: 35.16, top: 40.48, wide: true },
  { id: 'crm', label: 'HTTP Request', sub: 'Write to CRM', icon: icons.data, hue: '#2563eb', left: 3.75, top: 71.43 },
  { id: 'slack', label: 'Slack', sub: 'Notify team', icon: icons.chat, hue: '#16a34a', left: 64.06, top: 71.43 },
];

const links = [
  'M214 64 C 270 64, 340 64, 410 64',
  'M119 98 C 119 134, 220 150, 300 170',
  'M505 98 C 505 134, 405 150, 350 170',
  'M285 248 C 285 272, 180 280, 119 300',
  'M365 248 C 365 272, 445 280, 505 300',
];

const ports = [
  [214, 64, 410, 64],
  [119, 98, 300, 170],
  [505, 98, 350, 170],
  [285, 248, 119, 300],
  [365, 248, 505, 300],
];

const stepIcons = [icons.search, icons.layout, icons.deploy];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>inodepi — style preview: Node Canvas</title>
    <meta name="description" content="An n8n-editor-style portfolio for inodepi: canvas, nodes, parameters, executions." />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="robots" content="noindex" />
  </head>
  <body class="nv-body">
    <header class="nv-appbar">
      <div class="nv-container nv-appbar-inner">
        <a class="nv-brand" href={`${base}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="18" r="3"></circle><path d="M8.5 8.5 15.5 15.5"></path></svg>
          inodepi
        </a>
        <span class="nv-divider" aria-hidden="true"></span>
        <p class="nv-crumbs"><span>Workflows</span><span aria-hidden="true">/</span><strong>client-intake</strong></p>

        <nav class="nv-nav" aria-label="Primary">
          <a href="#capabilities">Nodes</a>
          <a href="#work">Templates</a>
          <a href="#process">Process</a>
          <a href="#contact">Contact</a>
        </nav>

        <div class="nv-appbar-actions">
          <span class="nv-saved"><i aria-hidden="true"></i>Saved</span>
          <a class="nv-ghost" href={`${base}style/`}>All styles</a>
          <button class="nv-execute" type="button" data-canvas-run>
            <span set:html={icons.play} aria-hidden="true"></span>
            Execute workflow
          </button>
        </div>
      </div>
    </header>

    <main>
      <section class="nv-hero">
        <div class="nv-container nv-hero-grid">
          <div class="nv-copy">
            <p class="nv-kicker"><span class="nv-dot" aria-hidden="true"></span>n8n automation architect</p>
            <h1>Automation you can see, edit, and trust.</h1>
            <p class="nv-lede">
              I build multi-workflow systems in n8n — triggers, filters, AI steps, CRM writes, and
              the error paths between them — then hand over a canvas you can actually read.
            </p>
            <div class="nv-actions">
              <a class="nv-btn nv-btn--primary" href="#contact">
                <span set:html={icons.play} aria-hidden="true"></span>
                Book a systems audit
              </a>
              <a class="nv-btn nv-btn--ghost" href="#work">Browse templates</a>
            </div>
            <ul class="nv-proof" aria-label="Stack">
              <li>n8n</li>
              <li>APIs</li>
              <li>AI steps</li>
              <li>CRM</li>
              <li>Webhooks</li>
            </ul>

            <ul class="nv-handover">
              <li>Canvas and documentation at handover</li>
              <li>You keep every credential and account</li>
              <li>Monitoring and retries included</li>
            </ul>
          </div>

          <div class="nv-editor" data-node-canvas>
            <div class="nv-editor-bar">
              <span class="nv-workflow-name">lead-intake.workflow</span>
              <span class="nv-active"><i aria-hidden="true"></i>Active</span>
              <span class="nv-exec-status" data-exec-status>Idle</span>
              <button class="nv-run" type="button" data-canvas-run>
                <span set:html={icons.play} aria-hidden="true"></span>
                Test
              </button>
            </div>

            <p class="nv-pan-hint">Drag the canvas sideways to explore →</p>
            <div class="nv-canvas-scroll">
              <div class="nv-canvas">
                <svg class="nv-links" viewBox="0 0 640 420" preserveAspectRatio="none" aria-hidden="true">
                  {links.map((d) => <path class="nv-link" d={d} />)}
                  {ports.map(([x1, y1, x2, y2]) => (
                    <>
                      <circle class="nv-port" cx={x1} cy={y1} r="3.2" />
                      <circle class="nv-port" cx={x2} cy={y2} r="3.2" />
                    </>
                  ))}
                </svg>

                {heroNodes.map((node) => (
                  <button
                    class:list={['nv-node', node.wide && 'nv-node--wide']}
                    type="button"
                    data-node={node.id}
                    data-hue={node.hue}
                    style={`left:${node.left}%;top:${node.top}%;--hue:${node.hue}`}
                    aria-pressed={node.id === 'agent' ? 'true' : 'false'}
                  >
                    <span class="nv-node-icon" set:html={node.icon} aria-hidden="true"></span>
                    <span class="nv-node-text">
                      <strong>{node.label}</strong>
                      <em>{node.sub}</em>
                    </span>
                    <span class="nv-node-check" aria-hidden="true">✓</span>
                  </button>
                ))}

                <p class="nv-sticky" aria-hidden="true">
                  goal: no manual handoffs
                  <span>runs while you sleep</span>
                </p>

                <div class="nv-zoom" aria-hidden="true">
                  <span>−</span><span>100%</span><span>+</span>
                </div>

                <div class="nv-minimap" aria-hidden="true">
                  <i style="left:6%;top:10%;width:26%;height:14%"></i>
                  <i style="left:66%;top:10%;width:26%;height:14%"></i>
                  <i style="left:36%;top:44%;width:28%;height:16%"></i>
                  <i style="left:6%;top:76%;width:26%;height:14%"></i>
                  <i style="left:66%;top:76%;width:26%;height:14%"></i>
                  <b></b>
                </div>
              </div>
            </div>

            <div class="nv-detail">
              <div class="nv-detail-head">
                <span class="nv-detail-icon" data-detail-icon style="--hue:#7c3aed" set:html={icons.ai}></span>
                <div>
                  <strong data-detail-name>AI Agent</strong>
                  <span data-detail-type>AI</span>
                </div>
                <span class="nv-detail-label">Node settings</span>
              </div>

              <div class="nv-tabs" role="tablist" aria-label="Node settings">
                <button type="button" role="tab" data-node-tab="params" aria-selected="true" class="is-active">Parameters</button>
                <button type="button" role="tab" data-node-tab="settings" aria-selected="false" tabindex="-1">Settings</button>
                <button type="button" role="tab" data-node-tab="output" aria-selected="false" tabindex="-1">Output</button>
              </div>

              <div class="nv-detail-body" data-detail-body role="tabpanel">
                <dl class="nv-params">
                  <div><dt>Model</dt><dd>GPT-class model</dd></div>
                  <div><dt>Prompt</dt><dd>Score fit and draft a reply</dd></div>
                  <div><dt>Output</dt><dd>Structured JSON</dd></div>
                  <div><dt>Tools</dt><dd>CRM lookup</dd></div>
                </dl>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="nv-section" id="capabilities">
        <div class="nv-container">
          <div class="nv-head">
            <div>
              <p class="nv-eyebrow">Node library</p>
              <h2>Every step in the chain.</h2>
            </div>
            <p class="nv-head-note">Filter by the kind of node your process needs.</p>
          </div>

          <div class="nv-filters" role="group" aria-label="Filter capabilities">
            {filters.map(([value, label]) => (
              <button
                type="button"
                class:list={['nv-filter', value === 'all' && 'is-active']}
                data-node-filter={value}
                aria-pressed={value === 'all' ? 'true' : 'false'}
              >
                {label}
              </button>
            ))}
          </div>

          <ul class="nv-caps">
            {capabilities.map((cap, index) => {
              const meta = capMeta[index];
              return (
                <li class="nv-cap" data-category={meta.category}>
                  <div class="nv-cap-top">
                    <span class="nv-cap-icon" style={`--hue:${meta.hue}`} set:html={meta.icon} aria-hidden="true"></span>
                    <span class="nv-cap-tag">{meta.tag}</span>
                    <span class="nv-port nv-port--out" aria-hidden="true"></span>
                  </div>
                  <h3>{cap.title}</h3>
                  <p>{cap.body}</p>
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      <section class="nv-section nv-section--tint" id="work">
        <div class="nv-container">
          <div class="nv-head">
            <div>
              <p class="nv-eyebrow">Templates</p>
              <h2>Workflows you can open.</h2>
            </div>
            <p class="nv-head-note">Each template links to its repository. Swap the placeholders for real builds.</p>
          </div>

          <ul class="nv-templates">
            {featuredAutomationRepos.map((repo) => (
              <li class="nv-template">
                <div class="nv-template-top">
                  <span class="nv-template-label">Template / {repo.stack.length} nodes</span>
                  <span class="nv-template-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                </div>

                <div class="nv-mini-flow" aria-hidden="true">
                  <span class="nv-mini" style="--hue:#d97706" set:html={icons.bolt}></span>
                  <span class="nv-mini-line"></span>
                  <span class="nv-mini" style="--hue:#7c3aed" set:html={icons.ai}></span>
                  <span class="nv-mini-line"></span>
                  <span class="nv-mini" style="--hue:#16a34a" set:html={icons.chat}></span>
                </div>

                <h3>{repo.title}</h3>
                <p class="nv-template-problem">{repo.problem}</p>
                <p class="nv-template-summary">{repo.summary}</p>

                <ul class="nv-tags">
                  {repo.stack.map((tool) => <li>{tool}</li>)}
                </ul>

                <a class="nv-template-link" href={repo.repoUrl}>Open template <span aria-hidden="true">↗</span></a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="nv-section" id="side-projects">
        <div class="nv-container">
          <div class="nv-head">
            <div>
              <p class="nv-eyebrow">Community nodes</p>
              <h2>Side projects.</h2>
            </div>
            <p class="nv-head-note">Tools and experiments outside client work.</p>
          </div>

          <ul class="nv-community">
            {featuredSideProjects.map((project) => (
              <li>
                <span class="nv-community-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4" width="16" height="16" rx="4"></rect><path d="M8 12h8M12 8v8" stroke-linecap="round"></path></svg>
                </span>
                <div>
                  <h3>{project.title}</h3>
                  <p>{project.summary}</p>
                </div>
                <span class="nv-community-stack">{project.stack.join(' / ')}</span>
                <a href={project.repoUrl}>Open <span aria-hidden="true">↗</span></a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="nv-section nv-section--tint" id="process">
        <div class="nv-container">
          <div class="nv-head">
            <div>
              <p class="nv-eyebrow">Deployment workflow</p>
              <h2>Three nodes from audit to live.</h2>
            </div>
            <p class="nv-head-note">Each node ends with something you can review or run.</p>
          </div>

          <ol class="nv-steps">
            {processSteps.map((step, index) => (
              <li class="nv-step">
                <div class="nv-step-head">
                  <span class="nv-step-icon" style={`--hue:${['#b45309', '#2563eb', '#16a34a'][index]}`} set:html={stepIcons[index]} aria-hidden="true"></span>
                  <span class="nv-step-no">Node {step.number}</span>
                  <span class="nv-port nv-port--out" aria-hidden="true"></span>
                </div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                <span class="nv-step-out">Output: {['Scoped plan', 'Workflow graph', 'Live system'][index]}</span>
              </li>
            ))}
          </ol>

          <p class="nv-process-note">Scope and price are agreed before the build starts. If automation is not worth it, I will say so.</p>
        </div>
      </section>

      <section class="nv-section" id="contact">
        <div class="nv-container nv-contact">
          <div>
            <p class="nv-eyebrow">New workflow</p>
            <h2>Start with a trigger.</h2>
            <p class="nv-contact-lede">
              Describe the process, the tools involved, and where the handoffs break. I will reply
              with an honest read on whether an n8n system can carry it.
            </p>

            <ul class="nv-direct">
              <li>
                <span>Email</span>
                <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
              </li>
              <li>
                <span>Call</span>
                <a href={siteConfig.calendarUrl}>Book 20 minutes</a>
              </li>
              <li>
                <span>Response</span>
                <p>{siteConfig.responseTime}</p>
              </li>
            </ul>

            <p class="nv-note" aria-hidden="true">first step: a 20-minute audit</p>
          </div>

          <form class="nv-form" action={siteConfig.formAction} method="post" data-demo-form>
            <div class="nv-form-head">
              <span class="nv-form-icon" style="--hue:#d23a60" set:html={icons.bolt} aria-hidden="true"></span>
              <div>
                <strong>Inquiry</strong>
                <span>Webhook / intake</span>
              </div>
              <span class="nv-active"><i aria-hidden="true"></i>Listening</span>
            </div>

            <div class="nv-form-body">
              <div class="nv-field-row">
                <label class="nv-field">
                  <span>Name <em>string</em></span>
                  <input type="text" name="name" autocomplete="name" required placeholder="Your name" />
                </label>
                <label class="nv-field">
                  <span>Email <em>string</em></span>
                  <input type="email" name="email" autocomplete="email" required placeholder="you@company.com" />
                </label>
              </div>

              <label class="nv-field">
                <span>Company <em>string / optional</em></span>
                <input type="text" name="company" autocomplete="organization" placeholder="Company or team" />
              </label>

              <label class="nv-field">
                <span>What should stop being manual? <em>text</em></span>
                <textarea name="automation" rows="4" required placeholder="The process, the tools, and what breaks today."></textarea>
              </label>

              <button class="nv-btn nv-btn--primary nv-form-submit" type="submit">
                <span set:html={icons.play} aria-hidden="true"></span>
                Execute workflow
              </button>
              <p class="nv-form-note">Preview only — nothing is sent. Wire a form endpoint to receive inquiries.</p>
            </div>
          </form>
        </div>
      </section>
    </main>

    <footer class="nv-footer">
      <div class="nv-container nv-footer-inner">
        <a class="nv-brand nv-brand--footer" href={`${base}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6" r="3"></circle><circle cx="18" cy="18" r="3"></circle><path d="M8.5 8.5 15.5 15.5"></path></svg>
          inodepi
        </a>
        <span class="nv-footer-status"><i aria-hidden="true"></i>Available for new builds</span>
        <nav aria-label="Footer">
          <a href="#work">Templates</a>
          <a href="#process">Process</a>
          <a href="#contact">Contact</a>
          <a href={siteConfig.githubUrl}>GitHub</a>
          <a href={`${base}style/`}>All styles</a>
        </nav>
        <p>© {year} inodepi</p>
      </div>
    </footer>

    <script>
      import '../../scripts/interactions';
      import '../../scripts/nodes';
    </script>
  </body>
</html>

<style is:global>
  .nv-body {
    --ix-accent: #d23a60;
    --ix-error: #b3261e;
    --ix-success: #15803d;
    background: #f3f2ee;
    color: #1b1d20;
    font-family: 'Manrope Variable', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.6;
  }

  .nv-body h1,
  .nv-body h2,
  .nv-body h3 {
    font-family: 'Manrope Variable', system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .nv-body p {
    text-wrap: pretty;
  }

  .nv-body ::selection {
    background: #d23a60;
    color: #ffffff;
  }

  .nv-container {
    width: min(1240px, 100% - 2.5rem);
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .nv-container {
      width: min(1240px, 100% - 4rem);
    }
  }

  .nv-mono {
    font-family: 'IBM Plex Mono', monospace;
  }

  .nv-body :focus-visible {
    outline: 2px solid #d23a60;
    outline-offset: 2px;
  }

  /* App bar */
  .nv-appbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #ffffff;
    border-bottom: 1px solid #dcded9;
  }

  .nv-appbar-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
  }

  .nv-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 750;
    font-size: 1.15rem;
    letter-spacing: -0.035em;
    text-decoration: none;
    color: #1b1d20;
    white-space: nowrap;
  }

  .nv-brand svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: #d23a60;
    stroke-width: 1.8;
  }

  .nv-divider {
    width: 1px;
    height: 1.25rem;
    background: #dcded9;
    display: none;
  }

  .nv-crumbs {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    color: #7a828b;
  }

  .nv-crumbs strong {
    color: #1b1d20;
    font-weight: 500;
  }

  .nv-nav {
    display: none;
    gap: 1.35rem;
    margin-left: auto;
    font-size: 0.8125rem;
    color: #5d6670;
  }

  .nv-nav a {
    text-decoration: none;
  }

  .nv-nav a:hover {
    color: #1b1d20;
  }

  .nv-appbar-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .nv-saved {
    display: none;
    align-items: center;
    gap: 0.35rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    color: #7a828b;
  }

  .nv-saved i,
  .nv-active i,
  .nv-footer-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #16a34a;
  }

  .nv-ghost {
    display: none;
    padding: 0.45rem 0.75rem;
    border: 1px solid #dcded9;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    color: #1b1d20;
  }

  .nv-ghost:hover {
    border-color: #b9bec4;
  }

  .nv-execute,
  .nv-btn--primary,
  .nv-run {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid #d23a60;
    border-radius: 6px;
    background: #d23a60;
    color: #ffffff !important;
    font-family: 'Manrope Variable', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .nv-execute svg,
  .nv-btn--primary svg,
  .nv-run svg {
    width: 0.7rem;
    height: 0.7rem;
  }

  .nv-execute:hover,
  .nv-btn--primary:hover,
  .nv-run:hover {
    background: #b92f52;
    border-color: #b92f52;
  }

  .nv-execute:disabled,
  .nv-run:disabled {
    opacity: 0.55;
    cursor: wait;
  }

  @media (min-width: 640px) {
    .nv-divider,
    .nv-crumbs,
    .nv-saved {
      display: inline-flex;
    }
  }

  @media (min-width: 900px) {
    .nv-nav,
    .nv-ghost {
      display: flex;
    }
  }

  /* Hero */
  .nv-hero {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(2.5rem, 5vw, 4rem);
  }

  .nv-hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 1020px) {
    .nv-hero-grid {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
      gap: 3rem;
    }
  }

  .nv-copy {
    padding-top: 0.5rem;
    max-width: 30rem;
  }

  .nv-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid #dcded9;
    border-radius: 999px;
    background: #ffffff;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.5938rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #5d6670;
  }

  .nv-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #16a34a;
  }

  .nv-copy h1 {
    margin-top: 1rem;
    font-size: clamp(2.4rem, 1.5rem + 3.4vw, 3.9rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    max-width: 14ch;
  }

  .nv-lede {
    margin-top: 1.1rem;
    color: #5d6670;
    font-size: 1rem;
    line-height: 1.65;
    max-width: 42ch;
  }

  .nv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .nv-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.62rem 0.95rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
  }

  .nv-btn--primary svg {
    width: 0.7rem;
    height: 0.7rem;
  }

  .nv-btn--ghost {
    border: 1px solid #cfd3d8;
    background: #ffffff;
    color: #1b1d20;
  }

  .nv-btn--ghost:hover {
    border-color: #b9bec4;
    background: #fbfbf9;
  }

  .nv-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1.4rem;
  }

  .nv-proof li,
  .nv-tags li {
    padding: 0.12rem 0.45rem;
    border: 1px solid #dcded9;
    border-radius: 4px;
    background: #ffffff;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    color: #5d6670;
  }

  .nv-handover {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.6rem;
    padding-top: 1.15rem;
    border-top: 1px solid #dcded9;
    max-width: 26rem;
  }

  .nv-handover li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #5d6670;
  }

  .nv-handover li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: #16a34a;
    font-weight: 700;
  }

  /* Editor */
  .nv-editor {
    min-width: 0;
    background: #ffffff;
    border: 1px solid #d7d9d4;
    border-radius: 10px;
    box-shadow: 0 24px 60px -42px rgba(20, 24, 28, 0.45);
    overflow: hidden;
  }

  .nv-editor-bar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid #e4e5e0;
    background: #fbfbf8;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    color: #5d6670;
  }

  .nv-workflow-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nv-active {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid #d6e8d9;
    border-radius: 999px;
    background: #f2f9f3;
    color: #15803d;
    font-size: 0.5625rem;
  }

  .nv-exec-status {
    margin-left: auto;
    font-size: 0.5625rem;
    color: #8a9097;
    white-space: nowrap;
  }

  .nv-run {
    padding: 0.28rem 0.55rem;
    font-size: 0.625rem;
    border-radius: 5px;
  }

  .nv-canvas-scroll {
    overflow-x: auto;
    background: #fafbf9;
  }

  .nv-pan-hint {
    display: none;
    padding: 0.35rem 0.75rem;
    border-bottom: 1px solid #eceee9;
    background: #fbfbf8;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.5625rem;
    letter-spacing: 0.03em;
    color: #8a9097;
  }

  @media (max-width: 700px) {
    .nv-pan-hint {
      display: block;
    }
  }

  .nv-canvas {
    position: relative;
    min-width: 560px;
    aspect-ratio: 640 / 420;
    container-type: inline-size;
    background-color: #fafbf9;
    background-image: radial-gradient(#d3d9d4 1.1px, transparent 1.3px);
    background-size: 20px 20px;
  }

  .nv-links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .nv-link {
    fill: none;
    stroke: #b5bcc3;
    stroke-width: 1.6;
  }

  .nv-port {
    fill: #ffffff;
    stroke: #aab2ba;
    stroke-width: 1.3;
  }

  .nv-editor.is-running .nv-link {
    stroke: #d23a60;
    stroke-dasharray: 6 4;
    animation: nv-dash 700ms linear infinite;
  }

  .nv-editor.is-running .nv-port {
    stroke: #d23a60;
  }

  @keyframes nv-dash {
    to {
      stroke-dashoffset: -10;
    }
  }

  /* Nodes */
  .nv-node {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 2cqw;
    width: 29.7cqw;
    height: 10.6cqw;
    padding: 0 2cqw;
    border: 1px solid #d2d6db;
    border-radius: 1.4cqw;
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(20, 24, 28, 0.06);
    text-align: left;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .nv-node--wide {
    width: 31.25cqw;
    height: 12.2cqw;
  }

  .nv-node:hover {
    border-color: #aab2ba;
    box-shadow: 0 4px 12px -6px rgba(20, 24, 28, 0.25);
    transform: translateY(-1px);
  }

  .nv-node.is-selected {
    border-color: #d23a60;
    box-shadow: 0 0 0 3px rgba(210, 58, 96, 0.15);
  }

  .nv-node.is-active {
    border-color: #d23a60;
    box-shadow: 0 0 0 3px rgba(210, 58, 96, 0.2);
  }

  .nv-node-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.8cqw;
    height: 3.8cqw;
    border-radius: 1cqw;
    background: color-mix(in srgb, var(--hue) 13%, #ffffff);
    color: var(--hue);
  }

  .nv-node-icon svg {
    width: 2.1cqw;
    height: 2.1cqw;
  }

  .nv-node-text {
    display: grid;
    gap: 0.15cqw;
    min-width: 0;
  }

  .nv-node-text strong {
    font-size: 2.1cqw;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nv-node-text em {
    font-style: normal;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.45cqw;
    color: #7a828b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nv-node-check {
    position: absolute;
    top: -0.9cqw;
    right: -0.9cqw;
    display: grid;
    place-items: center;
    width: 2.6cqw;
    height: 2.6cqw;
    border-radius: 50%;
    background: #16a34a;
    color: #ffffff;
    font-size: 1.5cqw;
    line-height: 1;
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .nv-node.is-done .nv-node-check {
    opacity: 1;
    transform: scale(1);
  }

  /* Sticky note */
  .nv-sticky {
    position: absolute;
    left: 35.5%;
    top: 72.5%;
    width: 25cqw;
    padding: 1.5cqw;
    background: #fef3c7;
    border: 1px solid #f0d98c;
    box-shadow: 0 4px 8px -6px rgba(74, 59, 18, 0.4);
    transform: rotate(-2deg);
    font-family: 'Caveat', cursive;
    font-size: 2.5cqw;
    line-height: 1.15;
    color: #4a3b12;
    pointer-events: none;
    z-index: 0;
  }

  .nv-sticky span {
    display: block;
    margin-top: 0.4cqw;
    font-size: 1.7cqw;
    color: #7c6a3a;
  }

  /* Canvas chrome */
  .nv-zoom {
    position: absolute;
    left: 1.5%;
    bottom: 2%;
    display: inline-flex;
    align-items: center;
    gap: 0.4cqw;
    padding: 0.35cqw 0.7cqw;
    border: 1px solid #d7d9d4;
    border-radius: 0.8cqw;
    background: #ffffff;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.4cqw;
    color: #5d6670;
  }

  .nv-minimap {
    position: absolute;
    right: 1.5%;
    bottom: 2%;
    width: 13cqw;
    height: 8.5cqw;
    border: 1px solid #d7d9d4;
    border-radius: 0.6cqw;
    background: rgba(255, 255, 255, 0.92);
    overflow: hidden;
  }

  .nv-minimap i {
    position: absolute;
    border-radius: 1px;
    background: #c6ccd2;
  }

  .nv-minimap b {
    position: absolute;
    inset: 14% 12% 18% 10%;
    border: 1px solid #d23a60;
    border-radius: 2px;
  }

  /* Detail panel */
  .nv-detail {
    border-top: 1px solid #e4e5e0;
    background: #fbfbf8;
  }

  .nv-detail-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid #e4e5e0;
  }

  .nv-detail-icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--hue) 13%, #ffffff);
    color: var(--hue);
  }

  .nv-detail-icon svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .nv-detail-head div {
    display: grid;
    line-height: 1.25;
  }

  .nv-detail-head strong {
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .nv-detail-head div span {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.5625rem;
    color: #7a828b;
  }

  .nv-detail-label {
    margin-left: auto;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9aa0a6;
  }

  .nv-tabs {
    display: flex;
    gap: 0.25rem;
    padding: 0 0.6rem;
    border-bottom: 1px solid #e4e5e0;
  }

  .nv-tabs button {
    padding: 0.48rem 0.5rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #7a828b;
  }

  .nv-tabs button.is-active {
    color: #1b1d20;
    border-bottom-color: #d23a60;
  }

  .nv-detail-body {
    min-height: 8.6rem;
    padding: 0.7rem 0.85rem 0.85rem;
  }

  .nv-params {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 560px) {
    .nv-params {
      grid-template-columns: 1fr 1fr;
      column-gap: 1.75rem;
    }
  }

  .nv-params > div {
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr);
    gap: 0.6rem;
    padding: 0.42rem 0;
    border-bottom: 1px dotted #dfe1dc;
  }

  .nv-params dt {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.5938rem;
    color: #8a9097;
  }

  .nv-params dd {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .nv-json {
    margin: 0;
    padding: 0.6rem 0.7rem;
    border: 1px solid #e0e2dd;
    border-radius: 5px;
    background: #f3f4f1;
    overflow-x: auto;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    line-height: 1.6;
    color: #334155;
  }

  /* Sections */
  .nv-section {
    padding-block: clamp(3.25rem, 6vw, 4.75rem);
    border-top: 1px solid #dcded9;
  }

  .nv-section--tint {
    background: #eeede8;
  }

  .nv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-bottom: 1.5rem;
  }

  .nv-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #d23a60;
    margin-bottom: 0.5rem;
  }

  .nv-head h2 {
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.7rem);
    max-width: 22ch;
  }

  .nv-head-note {
    max-width: 30ch;
    color: #6b737c;
    font-size: 0.875rem;
  }

  /* Filters */
  .nv-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .nv-filter {
    padding: 0.35rem 0.7rem;
    border: 1px solid #d7d9d4;
    border-radius: 999px;
    background: #ffffff;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    color: #5d6670;
    transition:
      border-color 140ms ease,
      background-color 140ms ease,
      color 140ms ease;
  }

  .nv-filter:hover {
    border-color: #b9bec4;
  }

  .nv-filter.is-active {
    border-color: #d23a60;
    background: #d23a60;
    color: #ffffff;
  }

  /* Capabilities */
  .nv-caps {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .nv-caps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1020px) {
    .nv-caps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .nv-cap[hidden] {
    display: none;
  }

  .nv-cap {
    position: relative;
    padding: 1.1rem;
    background: #ffffff;
    border: 1px solid #dcded9;
    border-radius: 8px;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .nv-cap:hover {
    border-color: #b9bec4;
    box-shadow: 0 8px 20px -14px rgba(20, 24, 28, 0.3);
  }

  .nv-cap-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }

  .nv-cap-icon {
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--hue) 12%, #ffffff);
    color: var(--hue);
  }

  .nv-cap-icon svg {
    width: 1rem;
    height: 1rem;
  }

  .nv-cap-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #8a9097;
  }

  .nv-port--out {
    width: 7px;
    height: 7px;
    margin-left: auto;
    border: 1.5px solid #b5bcc3;
    border-radius: 50%;
    background: #fafbf9;
  }

  .nv-cap h3 {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .nv-cap p {
    margin-top: 0.4rem;
    color: #5d6670;
    font-size: 0.8438rem;
    line-height: 1.55;
  }

  /* Templates */
  .nv-templates {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 860px) {
    .nv-templates {
      grid-template-columns: 1fr 1fr;
    }
  }

  .nv-template {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    background: #ffffff;
    border: 1px solid #dcded9;
    border-radius: 8px;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .nv-template:hover {
    border-color: #b9bec4;
    transform: translateY(-2px);
  }

  .nv-template-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid #eceee9;
  }

  .nv-template-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #8a9097;
  }

  .nv-template-dots {
    display: inline-flex;
    gap: 3px;
  }

  .nv-template-dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #d7d9d4;
