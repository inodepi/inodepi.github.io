---
import ProjectShell from '../components/ProjectShell.astro';
import { siteConfig } from '../data/projects';

import { marked } from 'marked';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const parseChangelog = (file: string) => {
  const markdown = readFileSync(join(process.cwd(), 'src/data/changelogs', file), 'utf8');
  return markdown
    .split(/\n## (?=v\d)/)
    .slice(1)
    .map((block) => {
      const newline = block.indexOf('\n');
      const heading = block.slice(0, newline).trim();
      const body = block.slice(newline + 1).trim();
      const withTitle = heading.match(/^(v[\d.]+)\s*—\s*(.*?)\s*\((\d{4}-\d{2}-\d{2})\)\s*$/);
      if (withTitle) {
        return { version: withTitle[1], title: withTitle[2], date: withTitle[3], html: marked.parse(body) as string };
      }
      const dateOnly = heading.match(/^(v[\d.]+)\s*—\s*(\d{4}-\d{2}-\d{2})\s*$/);
      return {
        version: dateOnly?.[1] ?? heading,
        title: '',
        date: dateOnly?.[2] ?? '',
        html: marked.parse(body) as string,
      };
    });
};


const modes = [
  { name: 'Classic', sub: '10 rounds' },
  { name: 'Bet', sub: 'bet & find' },
  { name: 'Endless', sub: 'depth chase' },
  { name: 'Daily', sub: 'seeded' },
  { name: 'Blitz', sub: '6 rounds' },
  { name: 'Zen', sub: 'relaxed' },
];

const metrics = [
  { value: '6', label: 'modes' },
  { value: '16', label: 'rounds, classic' },
  { value: '15', label: 'medals' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Tippy Card Monte',
  description:
    'A pixel-art card monte in a single page: six modes including Bet, uncapped streak payouts, checkpoint perks, 15 medals and landscape fullscreen. No build, no backend.',
  url: 'https://inodepi.github.io/tippy-card-monte/',
  playMode: 'SinglePlayer',
  applicationCategory: 'Game',
  author: { '@type': 'Person', name: 'Christian John', url: 'https://inodepi.github.io/' },
  genre: ['Casual', 'Card game'],
  gamePlatform: 'Web browser',
};
const tippyNotes = parseChangelog('tippy.md');

---

<ProjectShell
  title="Tippy Card Monte — inodepi"
  description="A pixel-art card monte in a single page: six modes including Bet, uncapped streak payouts, checkpoint perks, 15 medals and landscape fullscreen. No build, no backend."
  kicker="side project · game"
  name="Tippy Card Monte"
  tagline="Follow the shuffle. Six modes. One very smug coin."
  badges={['Playable', 'Single file', '6 modes']}
  canvasName="tippy-card-monte"
  canvasTag="v1.3.6"
  canvasNote="Find the coin. Bank the coins."
  stack={['Canvas', 'Vanilla JS', 'Web Audio', 'localStorage']}
  links={[
    { label: 'Play the game', href: '/tippy-card-monte/game/' },
    { label: 'Full patch notes', href: 'https://github.com/inodepi/potaterrr.github.io/blob/main/data/tippy-changelog.md', external: true },
  ]}
  category="Games · browser"
  ctaTitle="Follow the shuffle."
  ctaBody="Find Tippy, bank the coins and chase depth — it runs in your browser."
  ctaLabel="Play Tippy"
  ctaHref="/tippy-card-monte/game/"
  primaryLabel="Play it"
  primaryHref="/tippy-card-monte/game/"
  sideCtaTitle="Playable in your browser"
  sideCtaBody="No install, no account — one file, any static host."
  sideCtaLabel="Play it"
  sideCtaHref="/tippy-card-monte/game/"
  jsonLd={jsonLd}
>
  <div class="crt-frame" slot="visual">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/videos/tippy-card-monte-loop-poster.jpg"
      src="/videos/tippy-card-monte-loop.mp4"
    ></video>
    <span class="crt-overlay" aria-hidden="true"></span>
  </div>

  <section class="proj-section">
    <h2>Overview</h2>
    <p>
      A pixel-art card monte in a single page: six modes including Bet, uncapped streak payouts,
      checkpoint perks, 15 medals and landscape fullscreen. No build, no backend.
    </p>
    <p>
      Tippy hides under one card. The cards shuffle. Keep your eyes on the coin, pick the right
      card and stay in the green — miss, and the pot remembers.
    </p>
  </section>

  <section class="proj-section">
    <h2>Six modes</h2>
    <div class="mode-grid">
      {modes.map((mode) => (
        <article class="mode-card">
          <h3>{mode.name}</h3>
          <p>{mode.sub}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="proj-section">
    <h2>The numbers</h2>
    <ul class="metric-row">
      {metrics.map((metric) => (
        <li><strong>{metric.value}</strong><span>{metric.label}</span></li>
      ))}
    </ul>
  </section>


  <section class="proj-section" id="patch-notes">
    <h2>Patch notes</h2>
    <p>Every release since the first build, newest first. Expand a version to read it.</p>

    <div class="patch-track">
      <h3 class="patch-track-title">All releases <span>{tippyNotes.length} releases</span></h3>
      <div class="patch-list">
        {tippyNotes.map((note, index) => (
          <details class="patch-entry" open={index === 0}>
            <summary>
              <span class="patch-summary">
                <span class="patch-version">{note.version}{note.title ? ` — ${note.title}` : ''}</span>
                <span class="patch-date">{note.date}</span>
              </span>
              <span class="patch-toggle" aria-hidden="true"></span>
            </summary>
            <div class="patch-body" set:html={note.html} />
          </details>
        ))}
      </div>
    </div>

    <p class="patch-note">
      The full text also lives in the
      <a href="https://github.com/inodepi/potaterrr.github.io/blob/main/data/tippy-changelog.md" target="_blank" rel="noopener noreferrer">repository</a>.
    </p>
  </section>

  <section class="proj-section">
    <h2>How it's built</h2>
    <p>
      Canvas, Vanilla JS, Web Audio and localStorage — one file, no build and no backend. Runs
      on any static host, scales to landscape fullscreen and respects reduced motion.
    </p>
  </section>
</ProjectShell>

<style>
  .crt-frame {
    position: relative;
  }

  .crt-frame video {
    display: block;
    width: 100%;
    height: auto;
    background: #000;
  }

  .crt-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.12) 0px,
        rgba(0, 0, 0, 0.12) 1px,
        transparent 1px,
        transparent 3px
      );
    mix-blend-mode: multiply;
  }

  .mode-grid {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .mode-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1000px) {
    .mode-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .mode-card {
    padding: 0.9rem 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .mode-card h3 {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .mode-card p {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-dim);
  }

  .metric-row {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .metric-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .metric-row li {
    padding: 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .metric-row strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 640;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .metric-row span {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .patch-track {
    margin-top: 1.4rem;
  }

  .patch-track-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .patch-track-title span {
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
    opacity: 0.8;
  }

  .patch-list {
    display: grid;
    gap: 0.55rem;
  }

  .patch-entry {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }

  .patch-entry[open] {
    border-color: rgba(245, 166, 35, 0.28);
  }

  .patch-entry summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    list-style: none;
  }

  .patch-entry summary::-webkit-details-marker {
    display: none;
  }

  .patch-summary {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }

  .patch-version {
    font-family: var(--font-mono);
    font-size: 0.78125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--accent);
    overflow-wrap: anywhere;
  }

  .patch-date {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }

  .patch-toggle {
    position: relative;
    flex: none;
    width: 1.2rem;
    height: 1.2rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
  }

  .patch-toggle::before,
  .patch-toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--ink-soft);
  }

  .patch-toggle::before {
    width: 0.6rem;
    height: 1.5px;
  }

  .patch-toggle::after {
    width: 1.5px;
    height: 0.6rem;
    transition: transform 150ms ease;
  }

  .patch-entry[open] .patch-toggle::after {
    transform: translate(-50%, -50%) scaleY(0);
  }

  .patch-body {
    padding: 0.2rem 1rem 0.95rem;
    border-top: 1px solid var(--line);
  }

  .patch-body h3 {
    margin: 0.8rem 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  .patch-body p {
    margin: 0.5rem 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .patch-body ul,
  .patch-body ol {
    display: grid;
    gap: 0.3rem;
    margin: 0.4rem 0;
    padding-left: 1.1rem;
  }

  .patch-body li {
    display: list-item;
    margin: 0.3rem 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .patch-body strong {
    color: var(--ink);
  }

  .patch-body code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    padding: 0.05rem 0.25rem;
    border-radius: 3px;
    background: var(--panel-raised);
  }

  .patch-body a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .patch-note {
    margin-top: 1.1rem;
    color: var(--ink-dim);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .patch-note a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

</style>

<style is:global>
  .patch-body h3 {
    margin: 0.9rem 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  .patch-body p {
    margin: 0.5rem 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .patch-body ul,
  .patch-body ol {
    display: block;
    margin: 0.5rem 0;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .patch-body ol {
    list-style: decimal;
  }

  .patch-body li {
    display: list-item;
    margin: 0.3rem 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .patch-body strong {
    color: var(--ink);
  }

  .patch-body code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    padding: 0.05rem 0.25rem;
    border-radius: 3px;
    background: var(--panel-raised);
  }

  .patch-body a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
