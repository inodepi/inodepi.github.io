---
import ProjectShell from '../components/ProjectShell.astro';
import VideoBeats from '../components/VideoBeats.astro';
import AutomationBreakdown from '../components/AutomationBreakdown.astro';
import { siteConfig } from '../data/projects';

const nodes = [
  { x: 16, y: 20, w: 180, h: 70, label: 'Invoice sheet', sub: 'client list · due dates', hue: '#46cfc0' },
  { x: 230, y: 20, w: 190, h: 70, label: 'n8n · daily run', sub: 'days late + tone', hue: '#f5a623' },
  { x: 452, y: 20, w: 172, h: 70, label: 'AI reminder', sub: 'tone-matched', hue: '#9d8cff' },
  { x: 452, y: 150, w: 172, h: 70, label: 'Gmail send', sub: 'signed · auto', hue: '#ff7f9f' },
  { x: 230, y: 150, w: 190, h: 70, label: 'Discord ping', sub: '#invoices', hue: '#5b9bff' },
];

const links = [
  'M196 55 C 214 55, 214 55, 230 55',
  'M420 55 C 436 55, 436 55, 452 55',
  'M538 90 C 538 118, 538 128, 538 150',
  'M452 185 C 436 185, 428 185, 420 185',
];

const ports = [
  [196, 55], [230, 55], [420, 55], [452, 55],
  [538, 90], [538, 150], [452, 185], [420, 185],
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: 'AR Invoice Reminder',
    description:
      'A daily n8n workflow that reads a client and invoice tracker, computes days past due, writes and sends a tone-matched payment reminder with OpenAI, logs the follow-up and pings Discord.',
    url: 'https://inodepi.github.io/ar-invoice-reminder/',
    author: { '@type': 'Person', name: 'Christian John', url: 'https://inodepi.github.io/' },
    keywords: 'n8n, OpenAI, Google Sheets, Gmail, Discord, accounts receivable',
    isPartOf: { '@type': 'WebSite', name: 'inodepi', url: 'https://inodepi.github.io/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://inodepi.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'AR Invoice Reminder', item: 'https://inodepi.github.io/ar-invoice-reminder/' },
    ],
  },
];

const guardrails = [
  'Tone is computed in code, not guessed: friendly under 14 days, firm to 30, solution-oriented after.',
  'A 7-day cooldown per invoice stops duplicate chasing.',
  'The signature and the automation line are added in code, so the model cannot rewrite them.',
  'Only Unpaid rows with an email, an amount and a due date are touched. Paid, Void and Cancelled are skipped.',
];
---

<ProjectShell
  title="AR Invoice Reminder — inodepi"
  description="A daily n8n workflow that reads a client and invoice tracker, computes days past due, writes and sends a tone-matched payment reminder, logs the follow-up and pings Discord."
  kicker="n8n automation"
  name="AR Invoice Reminder"
  tagline="A daily n8n run chases overdue invoices — signed, tracked, and pinged to Discord."
  badges={['Auto-send', 'OpenAI', 'Live']}
  canvasName="invoice-chaser.workflow"
  canvasTag="n8n"
  canvasNote="Sheets in, signed reminders out, #invoices ping."
  stack={['n8n', 'OpenAI', 'Google Sheets', 'Gmail', 'Discord']}
  links={[
    { label: 'Repository', href: 'https://github.com/inodepi/ar-invoice-reminder-agent', external: true },
    { label: 'Interactive demo', href: 'https://inodepi.github.io/ar-invoice-reminder-agent/', external: true },
  ]}
  category="Automations · finance ops"
  ctaTitle="Stop chasing invoices."
  ctaBody="Let the tracker, the reminders and the follow-ups run on a schedule — signed, logged and pinged to Discord."
  jsonLd={jsonLd}
>
  <section class="proj-section" slot="visual">
    <svg viewBox="0 0 640 290" role="img" aria-label="Workflow: the invoice sheet feeds a daily n8n run that writes a tone-matched reminder with AI, sends it by email, and pings Discord.">
      <g class="links">
        {links.map((d) => <path d={d} />)}
      </g>
      <g class="ports">
        {ports.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.1" />)}
      </g>
      <g class="pulses">
        <circle class="pulse" r="3">
          <animateMotion path="M196 55 C 214 55, 214 55, 230 55" dur="3.4s" begin="-0.8s" repeatCount="indefinite" />
        </circle>
        <circle class="pulse" r="3">
          <animateMotion path="M538 90 C 538 118, 538 128, 538 150" dur="3.4s" begin="-1.8s" repeatCount="indefinite" />
        </circle>
      </g>
      <g class="nodes">
        {nodes.map((node) => (
          <g class:list={[node.label.startsWith('n8n') && 'is-core']}>
            <rect class="node" x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
            <rect x={node.x + 10} y={node.y + 14} width="4" height={node.h - 28} rx="2" fill={node.hue} />
            <text class="node-label" x={node.x + 24} y={node.y + 30}>{node.label}</text>
            <text class="node-sub" x={node.x + 24} y={node.y + 48}>{node.sub}</text>
          </g>
        ))}
      </g>
    </svg>
  </section>

  <section class="proj-section">
    <h2>Overview</h2>
    <VideoBeats
      src="/videos/ar-invoice-reminder.mp4"
      poster="/videos/ar-invoice-reminder.jpg"
      captions="/videos/ar-invoice-reminder.vtt"
      caption="Build overview · 0:30 · captions available"
      beats={[
        { time: '0:00', seek: 0, title: 'Overdue queue', body: 'Three invoices, $16,450 outstanding.' },
        { time: '0:10', seek: 10, title: 'The daily run', body: 'Tone computed in code. It sends itself.' },
        { time: '0:22', seek: 22, title: 'The ping', body: 'Sent, logged, and posted to #invoices.' },
      ]}
    />
  </section>

  <section class="proj-section">
    <AutomationBreakdown
      problem="Overdue invoices sit in a spreadsheet until someone remembers to chase them. Small balances age into awkward calls and cash that should already be in the account."
      cost={[
        { label: '3 invoices slip past 14 days each month', value: '3 late invoices' },
        { label: '3 × $1,200 average invoice', value: '$3,600 tied up' },
        { label: '2 hrs/week checking dates and writing reminders', value: '~8 hrs/month' },
      ]}
      fix="A daily n8n run reads the client and invoice tracker, computes days past due, writes a tone-matched reminder, sends it signed and pings #invoices."
      fixPoints={[
        'Reads the Client List/Deliverables tab, calculates days overdue in code and skips anything inside the 7-day cooldown.',
        'OpenAI writes friendly, firm or solution-oriented copy; Gmail sends it with the standard inodepi signature.',
        'The follow-up date is written back to the row and Discord posts the client, invoice, amount and tone.',
      ]}
      stats={[
        { value: '2–4 hrs/wk', label: 'Admin hours saved', note: 'No manual date checks or reminder writing.' },
        { value: '$3K–$6K', label: 'Monthly cash collected sooner', note: '7–10 days faster on overdue invoices.' },
        { value: 'Auto', label: 'Follow-up logged', note: 'Date, timestamp and tone written back to the row.' },
      ]}
    />
  </section>

  <section class="proj-section">
    <h2>Guardrails</h2>
    <ul class="proj-list">
      {guardrails.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="proj-section">
    <h2>Stack notes</h2>
    <p>
      Built on n8n with OpenAI for the copy, Google Sheets for the tracker, Gmail for the send and a
      Discord webhook for the ping. Swap the model or the sheet and the rest of the workflow stays
      the same.
    </p>
  </section>
</ProjectShell>

<style>
  .links path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .links .writeback {
    stroke-dasharray: 5 4;
    stroke: var(--ink-dim);
  }

  .ports circle {
    fill: var(--panel);
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .pulse {
    fill: var(--accent);
    filter: drop-shadow(0 0 4px rgba(245, 166, 35, 0.8));
  }

  .nodes .is-core .node {
    stroke: rgba(245, 166, 35, 0.55);
  }

  .node {
    fill: var(--panel-raised);
    stroke: var(--line-strong);
    stroke-width: 1.1;
  }

  .node-label {
    fill: var(--ink);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
  }

  .node-sub {
    fill: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 9.5px;
  }

  .proj-list {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .proj-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .proj-list li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulses {
      display: none;
    }
  }
</style>
