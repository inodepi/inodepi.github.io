---
import ProjectShell from '../components/ProjectShell.astro';
import { siteConfig } from '../data/projects';

const nodes = [
  { x: 16, y: 30, w: 190, h: 72, label: 'Invoice sheet', sub: 'Google Sheets', hue: '#46cfc0' },
  { x: 240, y: 30, w: 190, h: 72, label: 'n8n · daily run', sub: 'read + parse', hue: '#f5a623' },
  { x: 464, y: 30, w: 160, h: 72, label: 'Gemini draft', sub: 'tone + amounts', hue: '#9d8cff' },
  { x: 240, y: 190, w: 190, h: 72, label: 'Gmail draft', sub: 'human presses send', hue: '#ff7f9f' },
];

const links = [
  'M206 66 C 222 66, 224 66, 240 66',
  'M430 66 C 448 66, 448 66, 464 66',
  'M336 102 C 336 148, 336 156, 336 190',
];

const ports = [
  [206, 66], [240, 66], [430, 66], [464, 66], [336, 102], [336, 190],
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: 'AR Invoice Reminder',
    description:
      'A daily n8n agent that reads an invoice tracker, computes days past due and files tone-matched reminder drafts in Gmail — a human presses send.',
    url: 'https://inodepi.github.io/ar-invoice-reminder/',
    author: { '@type': 'Person', name: 'Christian John', url: 'https://inodepi.github.io/' },
    keywords: 'n8n, Gemini, Google Sheets, Gmail, accounts receivable',
    isPartOf: { '@type': 'WebSite', name: 'inodepi', url: 'https://inodepi.github.io/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://inodepi.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'AR Invoice Reminder', item: 'https://inodepi.github.io/ar-invoice-reminder/' },
    ],
  },
];

const useCases = [
  { title: 'Net-30 and net-60 clients', body: 'Sweep the tracker daily and match the reminder tone to how late the invoice actually is.' },
  { title: 'Retainer and milestone billing', body: 'Chase the invoice without sounding like you are chasing the relationship.' },
  { title: 'Disputed invoices', body: 'Stop the sequence when a client replies with a question and escalate with the full context.' },
  { title: 'Owner approval', body: 'Every reminder waits as a Gmail draft; nobody sends a collections email by accident.' },
];

const how = [
  'Schedule trigger fires at 09:00 and reads the invoice sheet.',
  'A Code node drops paid and void rows, parses amounts and dates, computes days past due and picks a tone.',
  'Gemini drafts against a structured output parser.',
  'A second Code node enforces the signature and falls back to a template if the model returns nothing usable.',
  'The draft lands in Gmail — nobody sends an email automatically.',
  'The follow-up date is written back to the sheet.',
];

const guardrails = [
  'Tone is computed in code, not guessed: friendly under 14 days, firm to 30, solution-oriented after.',
  'The signature is rebuilt in code, so the model can’t rewrite it.',
  'A 7-day cooldown per invoice stops duplicate chasing.',
  'Strict JSON, no placeholders — and a human presses send.',
];
---

<ProjectShell
  title="AR Invoice Reminder — inodepi"
  description="A daily n8n agent that reads an invoice tracker, computes days past due and files tone-matched reminder drafts in Gmail — a human presses send."
  kicker="n8n automation"
  name="AR Invoice Reminder"
  tagline="A daily n8n agent that chases overdue invoices — and never sends anything itself."
  badges={['Human-in-the-loop', 'Never auto-sends', 'Live on a real tracker']}
  canvasName="invoice-chaser.workflow"
  canvasTag="n8n"
  canvasNote="Sheets in, Gmail drafts out. Nothing sends itself."
  stack={['n8n', 'Gemini', 'Google Sheets', 'Gmail']}
  links={[
    { label: 'Repository', href: 'https://github.com/inodepi/ar-invoice-reminder-agent', external: true },
    { label: 'Interactive demo', href: 'https://inodepi.github.io/ar-invoice-reminder-agent/', external: true },
  ]}
  category="Automations · finance ops"
  ctaTitle="Stop chasing invoices."
  ctaBody="Let the tracker, the drafts and the follow-ups run on a schedule — with you pressing the only send button."
  jsonLd={jsonLd}
>
  <section class="proj-section" slot="visual">
    <svg viewBox="0 0 640 290" role="img" aria-label="Workflow: the invoice sheet feeds a daily n8n run that drafts with Gemini and files a Gmail draft for human review.">
      <g class="links">
        {links.map((d) => <path d={d} />)}
      </g>
      <g class="ports">
        {ports.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.1" />)}
      </g>
      <g class="pulses">
        <circle class="pulse" r="3">
          <animateMotion path="M206 66 C 222 66, 224 66, 240 66" dur="3.4s" begin="-0.8s" repeatCount="indefinite" />
        </circle>
        <circle class="pulse" r="3">
          <animateMotion path="M336 102 C 336 148, 336 156, 336 190" dur="3.4s" begin="-1.8s" repeatCount="indefinite" />
        </circle>
      </g>
      <g class="nodes">
        {nodes.map((node) => (
          <g class:list={[node.label.startsWith('n8n') && 'is-core']}>
            <rect class="node" x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
            <rect x={node.x + 10} y={node.y + 14} width="4" height={node.h - 28} rx="2" fill={node.hue} />
            <text class="node-label" x={node.x + 24} y={node.y + 30}>{node.label}</text>
            <text class="node-sub" x={node.x + 24} y={node.y + 48}>{node.sub}</text>
          </g>
        ))}
      </g>
    </svg>
  </section>

  <section class="proj-section">
    <h2>Overview</h2>
    <figure class="proj-video">
      <video
        controls
        preload="metadata"
        playsinline
        poster="/videos/ar-invoice-reminder.jpg"
        width="1920"
        height="1080"
      >
        <source src="/videos/ar-invoice-reminder.mp4" type="video/mp4" />
        Your browser cannot play this film.
        <a href="/videos/ar-invoice-reminder.mp4">Download it</a>.
      </video>
      <figcaption>Narrated build overview · 2:03</figcaption>
    </figure>
  </section>

  <section class="proj-section">
    <h2>Use cases</h2>
    <div class="proj-cases">
      {useCases.map((useCase) => (
        <article class="proj-case">
          <h3>{useCase.title}</h3>
          <p>{useCase.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="proj-section">
    <h2>How it works</h2>
    <ul class="proj-list">
      {how.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="proj-section">
    <h2>Guardrails</h2>
    <ul class="proj-list">
      {guardrails.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="proj-section">
    <h2>Stack notes</h2>
    <p>
      Built on n8n with Gemini through a structured output parser. If your stack requires
      something else, the same architecture can be delivered on another automation platform.
    </p>
  </section>
</ProjectShell>

<style>
  .links path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .links .writeback {
    stroke-dasharray: 5 4;
    stroke: var(--ink-dim);
  }

  .ports circle {
    fill: var(--panel);
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .pulse {
    fill: var(--accent);
    filter: drop-shadow(0 0 4px rgba(245, 166, 35, 0.8));
  }

  .nodes .is-core .node {
    stroke: rgba(245, 166, 35, 0.55);
  }

  .node {
    fill: var(--panel-raised);
    stroke: var(--line-strong);
    stroke-width: 1.1;
  }

  .node-label {
    fill: var(--ink);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
  }

  .node-sub {
    fill: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 9.5px;
  }

  .proj-video {
    margin: 1.25rem 0 0;
  }

  .proj-video video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #000;
  }

  .proj-video figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    color: var(--ink-dim);
  }

  .proj-cases {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .proj-cases {
      grid-template-columns: 1fr 1fr;
    }
  }

  .proj-case {
    padding: 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .proj-case h3 {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .proj-case p {
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .proj-list {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .proj-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .proj-list li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulses {
      display: none;
    }
  }
</style>
