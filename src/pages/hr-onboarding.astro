---
import ProjectShell from '../components/ProjectShell.astro';

const nodes = [
  { x: 16, y: 30, w: 190, h: 72, label: 'New hire', sub: 'Notion tracker', hue: '#46cfc0' },
  { x: 240, y: 30, w: 190, h: 72, label: 'n8n workflow', sub: 'polls every minute', hue: '#f5a623' },
  { x: 464, y: 30, w: 160, h: 72, label: 'Market profile', sub: 'plan per market', hue: '#46cfc0' },
  { x: 60, y: 190, w: 190, h: 72, label: 'Welcome email', sub: 'hire + paperwork list', hue: '#46cfc0' },
  { x: 280, y: 190, w: 160, h: 72, label: 'Team brief', sub: 'compliance + tools', hue: '#9d8cff' },
  { x: 470, y: 190, w: 160, h: 72, label: 'Status update', sub: 'Paperwork Sent', hue: '#ff7f9f' },
];

const links = [
  'M206 66 C 222 66, 224 66, 240 66',
  'M430 66 C 448 66, 448 66, 464 66',
  'M300 102 C 300 140, 155 140, 155 190',
  'M336 102 C 336 140, 360 140, 360 190',
  'M372 102 C 410 140, 550 140, 550 190',
];

const ports = [
  [206, 66], [240, 66], [430, 66], [464, 66],
  [155, 190], [360, 190], [550, 190],
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: 'HR Onboarding Workflow',
    description:
      'An n8n and Notion onboarding workflow that welcomes each new hire with the right paperwork, briefs the team and advances the hire to Paperwork Sent — one config driven workflow for every market.',
    url: 'https://inodepi.github.io/hr-onboarding/',
    author: { '@type': 'Person', name: 'Christian John', url: 'https://inodepi.github.io/' },
    keywords: 'n8n, Notion, HR onboarding, Gmail, compliance, multi market',
    isPartOf: { '@type': 'WebSite', name: 'inodepi', url: 'https://inodepi.github.io/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://inodepi.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'HR Onboarding Workflow', item: 'https://inodepi.github.io/hr-onboarding/' },
    ],
  },
];

const useCases = [
  { title: 'Clinics', body: 'HIPAA training, W-4 and I-9, office NDA, practice management software, phone extension — one row in the market profile drives all of it.' },
  { title: 'Home services', body: 'Safety certifications, vehicle and equipment checks, dispatch tools and uniform requests go out with the welcome email instead of being chased.' },
  { title: 'Real estate', body: 'License verification, MLS access, brand kit and CRM seats are provisioned from the same tracker, with the broker copied on the brief.' },
  { title: 'Agencies', body: 'Tool stack setup, client account access and time tracking get assigned on day one — before the hire is sitting idle.' },
  { title: 'Gyms and wellness', body: 'Service training, class schedule, member system and facility access are listed for the hire and the front desk at the same moment.' },
  { title: 'Multi market teams', body: 'Every market keeps its own checklist. Adding a new business type means adding one profile row, never editing the workflow.' },
];

const guardrails = [
  'The status change is the once only guard: no cursors, no dedupe tables, no duplicate welcome emails.',
  'Adding a market is a new row in Market Profiles, not a workflow edit.',
  'Every document, module and tool comes from the plan, so nothing is hardcoded per business type.',
  'Missing email address? The hire stops at the poll instead of silently skipping the welcome.',
  'The tracker is data and the market profile is config, so both stay editable by the people who own them.',
  'Runs on your own Notion and Gmail accounts — you keep every record and every send.',
];
---

<ProjectShell
  title="HR Onboarding Workflow — inodepi"
  description="An n8n and Notion onboarding workflow that welcomes each new hire with the right paperwork, briefs the team and advances the hire to Paperwork Sent — one workflow for every market."
  kicker="n8n automation"
  name="HR Onboarding Workflow"
  tagline="Add a hire to Notion. Within a minute the right paperwork, brief and status move — for any market."
  badges={['Config driven per market', 'Once only guard', 'n8n', 'Notion + Gmail']}
  canvasName="hr-onboarding.workflow"
  canvasTag="n8n"
  canvasNote="Notion in. Welcome emails out. One workflow per market plan."
  stack={['n8n', 'Notion', 'Gmail', 'Market profiles']}
  links={[]}
  category="Automations · people ops"
  ctaTitle="Stop running onboarding from memory."
  ctaBody="Bring your hiring list and your markets. I'll show you how one workflow onboards all of them."
  jsonLd={jsonLd}
>
  <section class="proj-section" slot="visual">
    <svg viewBox="0 0 640 290" role="img" aria-label="Workflow: a new hire in Notion feeds an n8n workflow, which reads the market profile and sends a welcome email, a team brief and a status update.">
      <g class="links">
        {links.map((d) => <path d={d} />)}
      </g>
      <g class="ports">
        {ports.map(([cx, cy]) => <circle cx={cx} cy={cy} r="3.1" />)}
      </g>
      <g class="pulses">
        <circle class="pulse" r="3">
          <animateMotion path="M206 66 C 222 66, 224 66, 240 66" dur="3.4s" begin="-0.8s" repeatCount="indefinite" />
        </circle>
        <circle class="pulse" r="3">
          <animateMotion path="M336 102 C 336 140, 360 140, 360 190" dur="3.4s" begin="-1.8s" repeatCount="indefinite" />
        </circle>
      </g>
      <g class="nodes">
        {nodes.map((node) => (
          <g class:list={[node.label.startsWith('n8n') && 'is-core']}>
            <rect class="node" x={node.x} y={node.y} width={node.w} height={node.h} rx="6" />
            <rect x={node.x + 10} y={node.y + 14} width="4" height={node.h - 28} rx="2" fill={node.hue} />
            <text class="node-label" x={node.x + 24} y={node.y + 30}>{node.label}</text>
            <text class="node-sub" x={node.x + 24} y={node.y + 48}>{node.sub}</text>
          </g>
        ))}
      </g>
    </svg>
  </section>

  <section class="proj-section">
    <h2>Overview</h2>
    <figure class="proj-video">
      <video
        controls
        preload="metadata"
        playsinline
        poster="/videos/hr-onboarding.jpg"
        width="1920"
        height="1080"
      >
        <source src="/videos/hr-onboarding.mp4" type="video/mp4" />
          <track kind="captions" src="/videos/hr-onboarding.vtt" srclang="en" label="English" />
        Your browser cannot play this film. <a href="/videos/hr-onboarding.mp4">Download it</a>.
      </video>
      <figcaption>Narrated build overview · 1:54</figcaption>
    </figure>
  </section>

  <section class="proj-section">
    <h2>Use cases</h2>
    <div class="proj-cases">
      {useCases.map((useCase) => (
        <article class="proj-case">
          <h3>{useCase.title}</h3>
          <p>{useCase.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="proj-section">
    <h2>Guardrails</h2>
    <ul class="proj-list">
      {guardrails.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="proj-section">
    <h2>Stack notes</h2>
    <p>
      Built on n8n with Notion as both the tracker and the config layer, and Gmail for the hire and
      team messages. The workflow is market agnostic: a new business type is a profile row, not a
      new build. If your stack requires something else, the same architecture can be delivered on
      another automation platform.
    </p>
  </section>
</ProjectShell>

<style>
  .links path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .ports circle {
    fill: var(--panel);
    stroke: var(--line-strong);
    stroke-width: 1.2;
  }

  .pulse {
    fill: var(--accent);
    filter: drop-shadow(0 0 4px rgba(245, 166, 35, 0.8));
  }

  .nodes .is-core .node {
    stroke: rgba(245, 166, 35, 0.55);
  }

  .node {
    fill: var(--panel-raised);
    stroke: var(--line-strong);
    stroke-width: 1.1;
  }

  .node-label {
    fill: var(--ink);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
  }

  .node-sub {
    fill: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 9.5px;
  }

  .proj-video {
    margin: 1.25rem 0 0;
  }

  .proj-video video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #000;
  }

  .proj-video figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    color: var(--ink-dim);
  }

  .proj-cases {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 700px) {
    .proj-cases {
      grid-template-columns: 1fr 1fr;
    }
  }

  .proj-case {
    padding: 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .proj-case h3 {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .proj-case p {
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .proj-list {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .proj-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .proj-list li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
