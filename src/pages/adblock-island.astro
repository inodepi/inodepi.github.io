---
import ProjectShell from '../components/ProjectShell.astro';
import { siteConfig } from '../data/projects';

import { marked } from 'marked';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const parseChangelog = (file: string) => {
  const markdown = readFileSync(join(process.cwd(), 'src/data/changelogs', file), 'utf8');
  return markdown
    .split(/\n## (?=v\d)/)
    .slice(1)
    .map((block) => {
      const newline = block.indexOf('\n');
      const heading = block.slice(0, newline).trim();
      const body = block.slice(newline + 1).trim();
      const withTitle = heading.match(/^(v[\d.]+)\s*—\s*(.*?)\s*\((\d{4}-\d{2}-\d{2})\)\s*$/);
      if (withTitle) {
        return { version: withTitle[1], title: withTitle[2], date: withTitle[3], html: marked.parse(body) as string };
      }
      const dateOnly = heading.match(/^(v[\d.]+)\s*—\s*(\d{4}-\d{2}-\d{2})\s*$/);
      return {
        version: dateOnly?.[1] ?? heading,
        title: '',
        date: dateOnly?.[2] ?? '',
        html: marked.parse(body) as string,
      };
    });
};


const classes = [
  { name: 'AdBlocker', role: 'shield & slam' },
  { name: 'Fact-Checker', role: 'heal & mark' },
  { name: 'Reader-Mode', role: 'ranged beams' },
  { name: 'Engineer', role: 'turrets & overclock' },
  { name: 'Medic', role: 'heal & support' },
  { name: 'Hacker', role: 'debuff & exploit' },
  { name: 'Streamer', role: 'AoE hype' },
  { name: 'Archivist', role: 'support & mark' },
  { name: 'Moderator', role: 'crowd control' },
];

const inside = [
  'Nine classes with distinct kits — shields, beams, turrets and support.',
  'Room-code co-op with server-moderated chat and shared bench-wall notes.',
  'The kindness wall: pin notes for whoever washes ashore next.',
  'Waves, upgrades and The Algorithm holding the last beach.',
  'Mania mode, medals and confetti — it gets competitive.',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'AdBlock Island',
  description:
    'A wholesome micro-MMO in a single file: pick a class, sweep the static and survive the Algorithm. Room-code co-op, kindness wall and medals.',
  url: 'https://inodepi.github.io/adblock-island/',
  playMode: 'SinglePlayer',
  applicationCategory: 'Game',
  author: { '@type': 'Person', name: 'Christian John', url: 'https://inodepi.github.io/' },
  genre: ['Casual', 'Browser game'],
  gamePlatform: 'Web browser',
};
const onlineNotes = parseChangelog('adblock-online.md');
const offlineNotes = parseChangelog('adblock-offline.md');

---

<ProjectShell
  title="AdBlock Island — inodepi"
  description="A wholesome micro-MMO in a single file: pick a class, sweep the static and survive the Algorithm. Room-code co-op, kindness wall and medals."
  kicker="side project · game"
  name="AdBlock Island"
  tagline="A wholesome micro-MMO about cleansing an ad-infested island."
  badges={['Playable', 'Single file', 'Co-op']}
  canvasName="adblock-island"
  canvasTag="beta v0.9.8"
  canvasNote="Nine classes. One island. Zero ads."
  stack={['Vanilla JS', 'Canvas', 'localStorage']}
  links={[
    { label: 'Play online', href: 'https://adblock-island.vercel.app/', external: true },
    { label: 'Play offline beta', href: '/adblock-island/game/' },
    { label: 'Full history', href: 'https://github.com/inodepi/adblock-island/blob/main/CHANGELOG.md', external: true },
  ]}
  category="Games · browser"
  ctaTitle="Bonk your first ad."
  ctaBody="Play the online beta — it runs in your browser."
  ctaLabel="Play online"
  ctaHref="https://adblock-island.vercel.app/"
  primaryLabel="Play online"
  primaryHref="https://adblock-island.vercel.app/"
  sideCtaTitle="Playable in your browser"
  sideCtaBody="No install, no account — the island runs anywhere."
  sideCtaLabel="Play online"
  sideCtaHref="https://adblock-island.vercel.app/"
  jsonLd={jsonLd}
>
  <Fragment slot="actions">
    <a class="btn btn-secondary" href="/adblock-island/game/">Play offline</a>
    <a class="btn btn-secondary" href="#patch-notes">Patch notes</a>
  </Fragment>

  <div class="crt-frame" slot="visual">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/videos/adblock-island-loop-poster.jpg"
      src="/videos/adblock-island-loop.mp4"
    ></video>
    <span class="crt-overlay" aria-hidden="true"></span>
  </div>

  <section class="proj-section">
    <h2>Overview</h2>
    <p>
      The ads took the beach. Mania took the schedule. Grab a broom, bonk some sponsored
      content, and leave a kind note for whoever washes ashore next.
    </p>
    <p>
      Pick one of nine classes, sweep the static and survive the Algorithm — room-code co-op
      runs on a token-guarded room desk with server-moderated chat, shared bench-wall notes,
      spectators and host handover.
    </p>
  </section>

  <section class="proj-section">
    <h2>Pick a way to help</h2>
    <div class="class-grid">
      {classes.map((gameClass) => (
        <article class="class-card">
          <h3>{gameClass.name}</h3>
          <p>{gameClass.role}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="proj-section">
    <h2>What's inside</h2>
    <ul class="proj-list">
      {inside.map((item) => <li>{item}</li>)}
    </ul>
  </section>


  <section class="proj-section" id="patch-notes">
    <h2>Patch notes</h2>
    <p>
      Two builds, two histories — every release, newest first. Expand a version to read it.
    </p>

    <div class="patch-track">
      <h3 class="patch-track-title">Online beta · Vercel <span>{onlineNotes.length} releases</span></h3>
      <div class="patch-list">
        {onlineNotes.map((note, index) => (
          <details class="patch-entry" open={index === 0}>
            <summary>
              <span class="patch-summary">
                <span class="patch-version">{note.version}{note.title ? ` — ${note.title}` : ''}</span>
                <span class="patch-date">{note.date}</span>
              </span>
              <span class="patch-toggle" aria-hidden="true"></span>
            </summary>
            <div class="patch-body" set:html={note.html} />
          </details>
        ))}
      </div>
    </div>

    <div class="patch-track">
      <h3 class="patch-track-title">Offline beta · GitHub Pages <span>{offlineNotes.length} releases</span></h3>
      <div class="patch-list">
        {offlineNotes.map((note, index) => (
          <details class="patch-entry" open={index === 0}>
            <summary>
              <span class="patch-summary">
                <span class="patch-version">{note.version}{note.title ? ` — ${note.title}` : ''}</span>
                <span class="patch-date">{note.date}</span>
              </span>
              <span class="patch-toggle" aria-hidden="true"></span>
            </summary>
            <div class="patch-body" set:html={note.html} />
          </details>
        ))}
      </div>
    </div>

    <p class="patch-note">
      The full text of both histories also lives in the
      <a href="https://github.com/inodepi/adblock-island/blob/main/CHANGELOG.md" target="_blank" rel="noopener noreferrer">repository</a>.
    </p>
  </section>

  <section class="proj-section">
    <h2>How it's built</h2>
    <p>
      One self-contained HTML file — vanilla JavaScript on canvas, no build and no backend for
      solo play. Co-op rooms run on a token-guarded room desk, so the cozy parts stay cozy even
      when strangers show up.
    </p>
  </section>
</ProjectShell>

<style>
  .crt-frame {
    position: relative;
  }

  .crt-frame video {
    display: block;
    width: 100%;
    height: auto;
    background: #000;
  }

  .crt-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.12) 0px,
        rgba(0, 0, 0, 0.12) 1px,
        transparent 1px,
        transparent 3px
      );
    mix-blend-mode: multiply;
  }

  .class-grid {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .class-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1000px) {
    .class-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .class-card {
    padding: 0.9rem 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .class-card h3 {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .class-card p {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-dim);
  }

  .proj-list {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .proj-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .proj-list li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .patch-track {
    margin-top: 1.4rem;
  }

  .patch-track-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .patch-track-title span {
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
    opacity: 0.8;
  }

  .patch-list {
    display: grid;
    gap: 0.55rem;
  }

  .patch-entry {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }

  .patch-entry[open] {
    border-color: rgba(245, 166, 35, 0.28);
  }

  .patch-entry summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    list-style: none;
  }

  .patch-entry summary::-webkit-details-marker {
    display: none;
  }

  .patch-summary {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }

  .patch-version {
    font-family: var(--font-mono);
    font-size: 0.78125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--accent);
    overflow-wrap: anywhere;
  }

  .patch-date {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
  }

  .patch-toggle {
    position: relative;
    flex: none;
    width: 1.2rem;
    height: 1.2rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
  }

  .patch-toggle::before,
  .patch-toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--ink-soft);
  }

  .patch-toggle::before {
    width: 0.6rem;
    height: 1.5px;
  }

  .patch-toggle::after {
    width: 1.5px;
    height: 0.6rem;
    transition: transform 150ms ease;
  }

  .patch-entry[open] .patch-toggle::after {
    transform: translate(-50%, -50%) scaleY(0);
  }

  .patch-body {
    padding: 0.2rem 1rem 0.95rem;
    border-top: 1px solid var(--line);
  }

  .patch-body h3 {
    margin: 0.8rem 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  .patch-body p {
    margin: 0.5rem 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .patch-body ul,
  .patch-body ol {
    display: grid;
    gap: 0.3rem;
    margin: 0.4rem 0;
    padding-left: 1.1rem;
  }

  .patch-body li {
    display: list-item;
    margin: 0.3rem 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .patch-body strong {
    color: var(--ink);
  }

  .patch-body code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    padding: 0.05rem 0.25rem;
    border-radius: 3px;
    background: var(--panel-raised);
  }

  .patch-body a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .patch-note {
    margin-top: 1.1rem;
    color: var(--ink-dim);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .patch-note a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

</style>

<style is:global>
  .patch-body h3 {
    margin: 0.9rem 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  .patch-body p {
    margin: 0.5rem 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .patch-body ul,
  .patch-body ol {
    display: block;
    margin: 0.5rem 0;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .patch-body ol {
    list-style: decimal;
  }

  .patch-body li {
    display: list-item;
    margin: 0.3rem 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .patch-body strong {
    color: var(--ink);
  }

  .patch-body code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    padding: 0.05rem 0.25rem;
    border-radius: 3px;
    background: var(--panel-raised);
  }

  .patch-body a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
